                        <h4 class="fw-bold text-dark mb-0">@ViewBag.ActiveCustomers</h4>
                    </div>
                    <div class="stat-icon bg-info bg-opacity-10">
                        <i class="fas fa-user-check text-info"></i>
                    </div>
                </div>
            </div>
