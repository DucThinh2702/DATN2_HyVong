@using DATN1API.Models.ViewModels
@using Microsoft.AspNetCore.Identity
@using DATN1WEB.Models
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Lấy user hiện tại
    var currentUser = await UserManager.GetUserAsync(User);
    var isSuperAdmin = currentUser?.Email == "nguyenducthinhcn2005@gmail.com";
}
@model ProfileViewModel

<div class="content-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-user-circle me-3"></i>Hồ sơ cá nhân</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Admin")">Dashboard</a></li>
                    <li class="breadcrumb-item active">Hồ sơ cá nhân</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" onclick="toggleEditMode()">
                <i class="fas fa-edit me-2"></i>Chỉnh sửa
            </button>

            @if (isSuperAdmin)
            {
                <a asp-action="CreateAdmin" asp-controller="Admin" class="btn btn-success">
                    <i class="fas fa-user-shield me-2"></i>Tạo Admin
                </a>

                <a asp-action="ListAdmins" asp-controller="Admin" class="btn btn-warning">
                    <i class="fas fa-users me-2"></i>Danh sách Admin
                </a>
            }
        </div>

    </div>
</div>


<div class="row">
    <!-- Profile Card -->
    <div class="col-lg-4 col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="mb-4">
                    <img src="@(Model.AvatarUrl ?? "~/hinh/logo.jpg")"
                         alt="Avatar"
                         class="user-avatar rounded-circle border border-3 border-warning"
                         style="width:120px;height:120px;object-fit:cover;cursor:pointer;"
                         onclick="goToProfile()" />
                </div>
                <h4 class="card-title mb-1">@Model.FullName</h4>
                <p class="text-muted mb-3">@Model.Position</p>
            </div>
        </div>
    </div>

    <!-- Profile Information -->
    <div class="col-lg-8 col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header bg-transparent">
                <h5 class="card-title mb-0">
                    <i class="fas fa-info-circle me-2"></i>Thông tin cá nhân
                </h5>
            </div>
            <div class="card-body">
                <form id="profileForm" method="post" asp-action="Profile" asp-controller="Admin">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-user me-2 text-primary"></i>Họ và tên
                            </label>
                            <input asp-for="FullName" class="form-control" readonly disabled>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-envelope me-2 text-primary"></i>Email
                            </label>
                            <input asp-for="Email" class="form-control" readonly disabled data-lock="true">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-phone me-2 text-primary"></i>Số điện thoại
                            </label>
                            <input asp-for="Phone" class="form-control" readonly disabled>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-calendar me-2 text-primary"></i>Ngày sinh
                            </label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" readonly disabled>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-venus-mars me-2 text-primary"></i>Giới tính
                            </label>
                            <select asp-for="Gender" class="form-select" disabled>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-briefcase me-2 text-primary"></i>Chức vụ
                            </label>
                            <input asp-for="Position" class="form-control" readonly disabled data-lock="true" />
                            <input type="hidden" name="Position" value="@Model.Position" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-map-marker-alt me-2 text-primary"></i>Địa chỉ
                        </label>
                        <textarea asp-for="Address" class="form-control" rows="2" readonly disabled></textarea>
                    </div>

                    <div class="d-none" id="editButtons">
                        <button type="submit" class="btn btn-success me-2">
                            <i class="fas fa-save me-2"></i>Lưu thay đổi
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="cancelEdit()">
                            <i class="fas fa-times me-2"></i>Hủy
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .user-avatar {
        transition: transform .2s ease;
    }

        .user-avatar:hover {
            transform: scale(1.05);
        }
</style>

<script>
    let isEditMode = false;

    function toggleEditMode() {
        isEditMode = !isEditMode;

        const controls = document.querySelectorAll('#profileForm input, #profileForm textarea, #profileForm select');
        const editButtons = document.getElementById('editButtons');
        const toggleBtn = document.querySelector('button[onclick="toggleEditMode()"]');

        controls.forEach(el => {
            if (el.hasAttribute('data-lock')) return;

            if (isEditMode) {
                el.readOnly = false;
                el.disabled = false;
            } else {
                el.readOnly = true;
                el.disabled = true;
            }
        });

        if (isEditMode) {
            editButtons.classList.remove('d-none');
            toggleBtn.innerHTML = '<i class="fas fa-times me-2"></i>Hủy chỉnh sửa';
            toggleBtn.className = 'btn btn-outline-secondary';
        } else {
            editButtons.classList.add('d-none');
            toggleBtn.innerHTML = '<i class="fas fa-edit me-2"></i>Chỉnh sửa';
            toggleBtn.className = 'btn btn-outline-primary';
        }
    }

    function cancelEdit() {
        toggleEditMode();
    }

    function goToProfile() {
        console.log('Avatar clicked - navigating to profile');
    }
</script>
