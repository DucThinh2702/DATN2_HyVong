@model DATN1API.Models.Category
@{
    ViewData["Title"] = "Thêm danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-3">@ViewData["Title"]</h2>
<hr />

<form asp-action="Create" enctype="multipart/form-data" id="categoryCreateForm" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <!-- Tên danh mục -->
    <div class="mb-3">
        <label asp-for="CategoryName" class="form-label fw-bold">Tên danh mục <span class="text-danger">*</span></label>
        <input asp-for="CategoryName" class="form-control" placeholder="Nhập tên danh mục (≥ 3 ký tự)" />
        <span asp-validation-for="CategoryName" class="invalid-feedback d-block"></span>
    </div>

    <!-- Ảnh -->
    <div class="row g-3 align-items-start">
        <div class="col-md-6">
            <label for="ImageFile" class="form-label fw-bold">Ảnh (tuỳ chọn)</label>
            <input type="file" name="ImageFile" id="ImageFile" class="form-control" accept="image/*" />
            <div class="form-text">Hỗ trợ JPEG/PNG/WebP, tối đa 2MB.</div>
            <div class="invalid-feedback">Ảnh không hợp lệ hoặc quá 2MB.</div>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Xem trước ảnh</label>
            <div class="border rounded-3 p-2 d-flex justify-content-center align-items-center" style="width: 160px; height: 160px; background:#fafafa;" id="thumbPreview">
                <span class="text-muted">Chưa chọn ảnh</span>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Lưu
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Huỷ
        </a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/localization/messages_vi.min.js"></script>

    <script>
        $(function () {
            // ===== Custom rules (giống view trước) =====
            $.validator.addMethod('fileSize', function (v, el, bytes) {
                if (!el.files || !el.files.length) return true;
                return el.files[0].size <= bytes;
            }, 'Tệp quá lớn');

            $.validator.addMethod('imageType', function (v, el) {
                if (!el.files || !el.files.length) return true;
                return ['image/jpeg', 'image/png', 'image/webp'].includes(el.files[0].type);
            }, 'Định dạng ảnh không hợp lệ');

            const $form = $('#categoryCreateForm');

            // ===== Validate =====
            $form.validate({
                ignore: [],
                onkeyup: function (el) { $(el).valid(); },
                onfocusout: function (el) { $(el).valid(); },
                errorElement: 'div',
                errorClass: 'invalid-feedback',
                highlight: function (el) { $(el).addClass('is-invalid'); },
                unhighlight: function (el) { $(el).removeClass('is-invalid'); },
                errorPlacement: function (err, el) {
                    if ($(el).attr('type') === 'file') err.insertAfter($(el).closest('.form-control'));
                    else err.insertAfter($(el));
                },
                rules: {
                    CategoryName: { required: true, minlength: 3, maxlength: 100 },
                    ImageFile:    { imageType: true, fileSize: 2 * 1024 * 1024 } // 2MB
                },
                messages: {
                    CategoryName: {
                        required: 'Vui lòng nhập tên danh mục',
                        minlength: 'Ít nhất 3 ký tự',
                        maxlength: 'Tối đa 100 ký tự'
                    },
                    ImageFile: {
                        imageType: 'Chỉ JPEG/PNG/WebP',
                        fileSize: 'Tối đa 2MB'
                    }
                }
            });

            // ===== Preview ảnh =====
            const $file = $('#ImageFile');
            const $thumb = $('#thumbPreview');
            const originalThumbHtml = $thumb.html();

            $file.on('change', function () {
                const file = this.files && this.files[0];

                if (!file) { $thumb.html(originalThumbHtml); return; }

                const okType = ['image/jpeg', 'image/png', 'image/webp'].includes(file.type);
                const okSize = file.size <= 2 * 1024 * 1024;

                if (!okType || !okSize) {
                    this.value = '';
                    $thumb.html('<span class="text-danger small">Ảnh không hợp lệ hoặc quá 2MB.</span>');
                    if ($file.valid) $file.valid();
                    return;
                }

                const url = URL.createObjectURL(file);
                const $img = $('<img>', { src: url, alt: 'Xem trước ảnh' })
                    .css({ width: '100%', height: '100%', objectFit: 'cover', borderRadius: '0.5rem' });
                $thumb.empty().append($img);
                $img.on('load', function () { URL.revokeObjectURL(url); });
            });
        });
    </script>
}
