@model DATN1API.Models.Category
@{
    ViewData["Title"] = "Sửa danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var fileName = System.IO.Path.GetFileName((Model.CategoryImage ?? "").Replace("\\", "/"));
    var currentImgUrl = string.IsNullOrEmpty(fileName) ? null : Url.Content($"~/hinh/{fileName}");
}

<div class="content-header">
    <h1 class="mb-2">@ViewData["Title"]</h1>
    <p class="text-muted">Chỉnh sửa tên và ảnh đại diện danh mục.</p>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" enctype="multipart/form-data" id="categoryEditForm" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CategoryId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <!-- Hàng 1: Tên (8) | Ảnh hiện tại (4) -->
            <div class="row g-4 align-items-start">
                <div class="col-md-8">
                    <label asp-for="CategoryName" class="form-label fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
                    <input asp-for="CategoryName" class="form-control" placeholder="Nhập tên danh mục (≥ 3 ký tự)" />
                    <span asp-validation-for="CategoryName" class="invalid-feedback d-block"></span>
                </div>

                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header fw-semibold">Ảnh hiện tại</div>
                        <div class="card-body d-flex justify-content-center align-items-center">
                            @if (!string.IsNullOrEmpty(currentImgUrl))
                            {
                                <img src="@currentImgUrl" alt="Ảnh hiện tại"
                                     class="rounded-3 border"
                                     style="width:160px;height:160px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="text-muted">Chưa có ảnh</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hàng 2: Chọn ảnh (8) | Xem trước ảnh mới (4 - ẨN mặc định) -->
            <div class="row g-4 mt-1">
                <div class="col-md-8">
                    <label for="ImageFile" class="form-label fw-semibold">Ảnh mới (tuỳ chọn)</label>
                    <input type="file" name="ImageFile" id="ImageFile" class="form-control" accept="image/*" />
                    <div class="form-text">Hỗ trợ JPEG/PNG/WebP, tối đa 2MB.</div>
                    <div class="invalid-feedback">Ảnh không hợp lệ hoặc quá 2MB.</div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 d-none" id="previewCard">
                        <div class="card-header fw-semibold">Xem trước ảnh mới</div>
                        <div class="card-body d-flex justify-content-center align-items-center">
                            <div class="border rounded-3 d-flex align-items-center justify-content-center"
                                 style="width:160px;height:160px;background:#fafafa;" id="newPreviewBox">
                                <!-- Sẽ được thay bằng <img> khi người dùng chọn ảnh -->
                                <span class="text-muted">Chưa chọn ảnh</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nút -->
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Cập nhật
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/localization/messages_vi.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(function () {
            // ====== jQuery Validate ======
            $.validator.addMethod('fileSize', function (v, el, bytes) {
                if (!el.files || !el.files.length) return true;
                return el.files[0].size <= bytes;
            }, 'Tệp quá lớn');

            $.validator.addMethod('imageType', function (v, el) {
                if (!el.files || !el.files.length) return true;
                return ['image/jpeg', 'image/png', 'image/webp'].includes(el.files[0].type);
            }, 'Định dạng ảnh không hợp lệ');

            const $form = $('#categoryEditForm');
            $form.validate({
                ignore: [],
                onkeyup: function (el) { $(el).valid(); },
                onfocusout: function (el) { $(el).valid(); },
                errorElement: 'div',
                errorClass: 'invalid-feedback',
                highlight: function (el) { $(el).addClass('is-invalid'); },
                unhighlight: function (el) { $(el).removeClass('is-invalid'); },
                rules: {
                    CategoryName: { required: true, minlength: 3, maxlength: 100 },
                    ImageFile:    { imageType: true, fileSize: 2 * 1024 * 1024 }
                },
                messages: {
                    CategoryName: {
                        required: 'Vui lòng nhập tên danh mục',
                        minlength: 'Ít nhất 3 ký tự',
                        maxlength: 'Tối đa 100 ký tự'
                    },
                    ImageFile: {
                        imageType: 'Chỉ JPEG/PNG/WebP',
                        fileSize: 'Tối đa 2MB'
                    }
                }
            });

            // ====== Ẩn/hiện + preview ảnh mới ======
            const $file = $('#ImageFile');
            const $card = $('#previewCard');
            const $box  = $('#newPreviewBox');
            const original = $box.html();

            $file.on('change', function () {
                const file = this.files && this.files[0];

                if (!file) {
                    // không có file -> ẩn card
                    $box.html(original);
                    $card.addClass('d-none');
                    return;
                }

                const okType = ['image/jpeg', 'image/png', 'image/webp'].includes(file.type);
                const okSize = file.size <= 2 * 1024 * 1024;

                if (!okType || !okSize) {
                    this.value = '';
                    $box.html('<span class="text-danger small">Ảnh không hợp lệ hoặc quá 2MB.</span>');
                    $card.removeClass('d-none');
                    if ($file.valid) $file.valid();
                    return;
                }

                const url = URL.createObjectURL(file);
                const $img = $('<img>', { src: url, alt: 'Xem trước' })
                    .css({ width: '100%', height: '100%', objectFit: 'cover', borderRadius: '0.5rem' });

                $box.empty().append($img);
                $card.removeClass('d-none');

                $img.on('load', function () { URL.revokeObjectURL(url); });
            });

            // ====== (Tuỳ chọn) chặn submit nếu không thay đổi gì ======
            const snapshot = () => {
                const fn = ($file[0].files && $file[0].files[0]) ? $file[0].files[0].name : '';
                return $('#CategoryName').val() + '|file=' + fn;
            };
            let initSnap = snapshot();
            $form.on('submit', function (e) {
                if (!$form.valid()) return;
                const cur = snapshot();
                if (cur === initSnap) {
                    e.preventDefault();
                    Swal.fire({ icon: 'info', title: 'Bạn chưa thay đổi gì', confirmButtonText: 'OK' });
                }
            });
        });
    </script>
}
