@model List<DATN1API.Models.Category>
@using System.Linq
@{
    ViewData["Title"] = "Danh mục";

    string q = (ViewBag.Search as string) ?? (string)Context.Request.Query["search"];
    string hasImage = (ViewBag.HasImage as string) ?? (string)Context.Request.Query["hasImage"];

    int page         = ViewBag.Page         != null ? (int)ViewBag.Page         : 1;
    int totalPages   = ViewBag.TotalPages   != null ? (int)ViewBag.TotalPages   : 1;
    int pageSize     = ViewBag.PageSize     != null ? (int)ViewBag.PageSize     : 5;
    int totalRecords = ViewBag.TotalRecords != null ? (int)ViewBag.TotalRecords : 0;

    // cửa sổ tối đa 5 nút
    int window = 5;
    int start = Math.Max(1, page - window / 2);
    int end   = Math.Min(totalPages, start + window - 1);
    if (end - start + 1 < window) start = Math.Max(1, end - window + 1);
}

<div class="content-header">
    <div>
        <h1 class="mb-2"><i class="fas fa-folder-open me-3 text-success"></i>Danh mục</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index","Admin")">Dashboard</a></li>
                <li class="breadcrumb-item active">Quản lý danh mục</li>
            </ol>
        </nav>
    </div>

    <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
        <div class="input-group" style="width:300px;">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input name="search" value="@q" class="form-control" placeholder="Tìm theo tên..." />
        </div>

        <select name="hasImage" class="form-select" style="width:170px">
            <option value="">-- Tất cả ảnh --</option>
            <option value="yes" @@(hasImage?.Equals("yes", StringComparison.OrdinalIgnoreCase) == true ? "selected" : "")>Có ảnh</option>
            <option value="no"  @@(hasImage?.Equals("no",  StringComparison.OrdinalIgnoreCase) == true ? "selected" : "")>Không ảnh</option>
        </select>

        <button class="btn btn-outline-primary"><i class="fas fa-filter me-1"></i>Lọc</button>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Thêm danh mục</a>
    </form>
</div>

<div class="card mt-3">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="fas fa-list me-2 text-primary"></i>Danh sách danh mục</h5>
        <small class="text-muted">
            @if (totalRecords > 0)
            {
                var from = (page - 1) * pageSize + 1;
                var to   = Math.Min(page * pageSize, totalRecords);
                @($"{from:N0}–{to:N0} / {totalRecords:N0}")
            }
        </small>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th style="width:96px;">Ảnh</th>
                        <th>Tên danh mục</th>
                        <th class="text-center" style="width:160px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.CategoryImage))
                                {
                                    <div class="cat-thumb"><img src="@item.CategoryImage" alt="@item.CategoryName" /></div>
                                }
                                else
                                {
                                    <div class="cat-thumb placeholder d-flex align-items-center justify-content-center">
                                        <i class="fas fa-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td class="fw-semibold align-middle">@item.CategoryName</td>
                            <td class="text-center align-middle">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a asp-action="Edit"   asp-route-id="@item.CategoryId" class="btn btn-action btn-outline-warning" title="Sửa"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-action btn-outline-danger"  title="Xóa"><i class="fas fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">Không có danh mục nào</td></tr>
                }
                </tbody>
            </table>
        </div>

        @* Phân trang compact, căn giữa *@
        @if (totalPages > 1)
        {
            <nav aria-label="Category pagination" class="mt-3">
                <div class="d-flex justify-content-center">
                    <ul class="pagination pagination-sm pager-compact d-inline-flex mb-0">
                        <!-- Prev -->
                        <li class="page-item @(page == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(page - 1)"
                               asp-route-pageSize="@pageSize"
                               asp-route-search="@q"
                               asp-route-hasImage="@hasImage"
                               aria-label="Trang trước">&lsaquo;</a>
                        </li>

                        <!-- Numbers -->
                        @for (int i = start; i <= end; i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@pageSize"
                                   asp-route-search="@q"
                                   asp-route-hasImage="@hasImage">@i</a>
                            </li>
                        }

                        <!-- Next -->
                        <li class="page-item @(page == totalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(page + 1)"
                               asp-route-pageSize="@pageSize"
                               asp-route-search="@q"
                               asp-route-hasImage="@hasImage"
                               aria-label="Trang sau">&rsaquo;</a>
                        </li>
                    </ul>
                </div>
            </nav>
        }
    </div>
</div>

<style>
    .table-modern th { white-space: nowrap; }
    .btn-action { padding: .25rem .5rem; }

    .cat-thumb {
        width: 56px; height: 56px;
        border-radius: 8px; overflow: hidden;
        background: #f8f9fa;
    }
    .cat-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .cat-thumb.placeholder { background: #f1f3f5; }

    /* Pager compact + căn giữa */
    .pager-compact {
        background: #f1f3f5;
        border-radius: .6rem;
        padding: .25rem .35rem;
    }
    .pager-compact .page-link {
        border: 0;
        margin: 0 .125rem;
        border-radius: .4rem;
        padding: .35rem .6rem;
        color: #1a73e8;
    }
    .pager-compact .page-item.active .page-link { background:#1a73e8; color:#fff; }
    .pager-compact .page-item.disabled .page-link { color:#6c757d; background:transparent; }
</style>
