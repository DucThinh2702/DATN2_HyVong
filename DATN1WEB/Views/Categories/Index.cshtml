@model List<DATN1API.Models.Category>
@using System.Linq
@{
    ViewData["Title"] = "Danh mục";

    string q = Context.Request.Query["search"];
    string hasImage = Context.Request.Query["hasImage"];
}

<div class="content-header">
    <div>
        <h1 class="mb-2"><i class="fas fa-folder-open me-3 text-success"></i>Danh mục</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index","Admin")">Dashboard</a></li>
                <li class="breadcrumb-item active">Quản lý danh mục</li>
            </ol>
        </nav>
    </div>

    <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
        <div class="input-group" style="width: 300px;">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input name="search" value="@q" class="form-control" placeholder="Tìm theo tên..." />
        </div>

        <select name="hasImage" class="form-select" style="width:170px">
            <option value="">-- Tất cả ảnh --</option>
            @if (string.Equals(hasImage, "yes", StringComparison.OrdinalIgnoreCase))
            {
                <option value="yes" selected>Có ảnh</option>
            }
            else
            {
                <option value="yes">Có ảnh</option>
            }

            @if (string.Equals(hasImage, "no", StringComparison.OrdinalIgnoreCase))
            {
                <option value="no" selected>Không ảnh</option>
            }
            else
            {
                <option value="no">Không ảnh</option>
            }
        </select>

        <button class="btn btn-outline-primary"><i class="fas fa-filter me-1"></i>Lọc</button>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Thêm danh mục
        </a>
    </form>
</div>

<!-- Categories table -->
<div class="card mt-3">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="fas fa-list me-2 text-primary"></i>Danh sách danh mục</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Tên danh mục</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.CategoryImage))
                                    {
                                        <div class="cat-thumb">
                                            <img src="@item.CategoryImage" alt="@item.CategoryName" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="cat-thumb placeholder d-flex align-items-center justify-content-center">
                                            <i class="fas fa-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-semibold">@item.CategoryName</td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-action btn-outline-warning" title="Sửa"><i class="fas fa-edit"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-action btn-outline-danger" title="Xóa"><i class="fas fa-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">Không có danh mục nào</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table-modern th {
        white-space: nowrap;
    }

    .btn-action {
        padding: .25rem .5rem;
    }

    .cat-thumb {
        width: 56px;
        height: 56px;
        border-radius: 8px;
        overflow: hidden;
        background: #f8f9fa;
    }

        .cat-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }

        .cat-thumb.placeholder {
            background: #f1f3f5;
        }
</style>
