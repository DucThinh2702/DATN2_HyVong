@model DATN1API.Models.ViewModels.CustomerViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Chi tiết khách hàng";
}

<!-- Bạn có thể move style block này ra file CSS riêng nếu muốn tái sử dụng -->
<style>
    .customer-detail {
        background: white;
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        border: 1px solid rgba(0,0,0,0.05);
    }

        .customer-detail dl {
            margin-bottom: 2rem;
        }

        .customer-detail dt {
            font-weight: 600;
            color: var(--bg-dark);
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .customer-detail dd {
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
            color: #495057;
        }

            .customer-detail dd:last-child,
            .customer-detail dt:last-child {
                border-bottom: none;
            }

    .badge {
        font-size: 0.875rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 500;
    }

    .btn {
        padding: 0.75rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-warning {
        background: var(--primary-color);
        border-color: var(--primary-color);
        color: var(--bg-dark);
    }

    .btn-secondary {
        border: 2px solid #6c757d;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    }

    .btn-warning:hover {
        background: var(--primary-dark);
        border-color: var(--primary-dark);
    }

    .btn-secondary:hover {
        background: #6c757d;
        border-color: #6c757d;
    }
</style>

<!-- Header -->
<div class="content-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="mb-2">
                <i class="fas fa-user-circle me-3 text-info"></i>Chi tiết khách hàng
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("KhachHang", "Admin")">Khách hàng</a></li>
                    <li class="breadcrumb-item active">Chi tiết</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-warning" asp-action="SuaKhachHang" asp-route-id="@Model.Id">
                <i class="fas fa-edit me-2"></i>Chỉnh sửa
            </a>
            <a class="btn btn-secondary" asp-action="KhachHang" asp-controller="Admin">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>
</div>

<!-- Detail Card -->
<div class="customer-detail">
    <dl class="row">
        <dt class="col-sm-4">
            <i class="fas fa-id-card me-2 text-primary"></i>Họ tên:
        </dt>
        <dd class="col-sm-8">
            <strong>@Model.FullName</strong>
        </dd>

        <dt class="col-sm-4">
            <i class="fas fa-envelope me-2 text-info"></i>Email:
        </dt>
        <dd class="col-sm-8">
            <span>@Model.Email</span>
        </dd>

        <dt class="col-sm-4">
            <i class="fas fa-phone me-2 text-success"></i>Số điện thoại:
        </dt>
        <dd class="col-sm-8">
            <span>@Model.Phone</span>
        </dd>

        <dt class="col-sm-4">
            <i class="fas fa-map-marker-alt me-2 text-warning"></i>Địa chỉ:
        </dt>
        <dd class="col-sm-8">
            <span>@Model.Address</span>
        </dd>

        <dt class="col-sm-4">
            <i class="fas fa-venus-mars me-2 text-secondary"></i>Giới tính:
        </dt>
        <dd class="col-sm-8">
            <span>@Model.Gender</span>
        </dd>

        <dt class="col-sm-4">
            <i class="fas fa-birthday-cake me-2 text-danger"></i>Ngày sinh:
        </dt>
        <dd class="col-sm-8">
            <span>@Model.DateOfBirth</span>
        </dd>

        <dt class="col-sm-4">
            <i class="fas fa-check-circle me-2 text-success"></i>Trạng thái xác thực:
        </dt>
        <dd class="col-sm-8">
            <span class="badge @(Model.Status ? "bg-success" : "bg-secondary")">
                @(Model.Status ? "Đã xác thực" : "Chưa xác thực")
            </span>
        </dd>
    </dl>
</div>
