@model DATN1API.Models.News
@{
    ViewData["Title"] = "Chi tiết bài viết";
    string Img(string? p) => string.IsNullOrWhiteSpace(p) ? "" : (p!.StartsWith("~/") ? p : "~" + (p.StartsWith("/") ? p : "/" + p));
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<div class="card">
    <div class="card-body">
        <div class="d-flex gap-4">
            <div>
                @if (!string.IsNullOrEmpty(Model.ThumbnailImage))
                {
                    <img src="@Url.Content(Img(Model.ThumbnailImage))"
                         class="img-fluid rounded" style="max-width:220px;max-height:220px;object-fit:cover" />
                }
            </div>
            <div class="flex-grow-1">
                <h4 class="mb-1">@Model.Title</h4>
                <div class="text-muted mb-3">
                    Đăng lúc: @Model.PostedDate?.ToString("dd/MM/yyyy HH:mm") |
                    Tác giả (ID): @(Model.AuthorId?.ToString() ?? "-")
                </div>
                <article class="border-top pt-3">
                    @Html.Raw((Model.Content ?? string.Empty).Replace("\n", "<br/>"))
                </article>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.NewsId" class="btn btn-warning">Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>
