@model DATN1API.Models.Order
@using System.Globalization
@{
    ViewData["Title"] = $"Sửa đơn hàng #{Model.OrderId}";
    var vi = CultureInfo.GetCultureInfo("vi-VN");

    string VNPayment(string? s) => (s ?? "").Trim().ToLowerInvariant() switch
    {
        "paid" => "Đã thanh toán",
        "unpaid" => "Chưa thanh toán",
        "pending" or "chờ thanh toán" => "Chờ thanh toán",
        _ => "Không rõ"
    };

    string VNOrder(string? s) => (s ?? "").Trim().ToLowerInvariant() switch
    {
        "" => "Chờ xác nhận",
        "pending" or "chờ xác nhận" => "Chờ xác nhận",
        "processing" or "đang chuẩn bị" or "đang xử lý" or "chờ xử lý" => "Đang chuẩn bị",
        "shipping" or "đang giao" or "vận chuyển" => "Đang giao",
        "completed" or "delivered" or "hoàn tất" or "hoàn thành" => "Hoàn tất",
        "cancelled" or "canceled" or "đã huỷ" or "đã hủy" => "Đã hủy",
        _ => "Không rõ"
    };
}

<h1 class="mb-3"><i class="fas fa-edit me-2 text-primary"></i>Sửa đơn hàng #@Model.OrderId</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-2"></div>

    <input type="hidden" name="OrderId" value="@Model.OrderId" />

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-transparent fw-bold">
                    <i class="fas fa-user me-2 text-primary"></i>Thông tin người nhận
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Người nhận</label>
                        <input name="RecipientName" class="form-control" value="@Model.RecipientName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">SĐT</label>
                        <input name="RecipientPhone" class="form-control" value="@Model.RecipientPhone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ</label>
                        <textarea name="DeliveryAddress" class="form-control" rows="2">@Model.DeliveryAddress</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ghi chú</label>
                        <textarea name="Note" class="form-control" rows="2">@Model.Note</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mã khuyến mãi</label>
                        <input name="PromoCode" class="form-control" value="@Model.PromoCode" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-transparent fw-bold">
                    <i class="fas fa-cogs me-2 text-primary"></i>Trạng thái & phí
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Trạng thái thanh toán</label>
                        <!-- data-current để script biết payment hiện tại -->
                        <select name="PaymentStatus" class="form-select" data-current="@Model.PaymentStatus">
                            <option value="Paid" selected="@(string.Equals(Model.PaymentStatus,"Paid",StringComparison.OrdinalIgnoreCase))">Đã thanh toán</option>
                            <option value="Unpaid" selected="@(string.Equals(Model.PaymentStatus,"Unpaid",StringComparison.OrdinalIgnoreCase))">Chưa thanh toán</option>
                        </select>
                        <small class="text-muted">Hiện tại: @VNPayment(Model.PaymentStatus)</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Trạng thái đơn</label>
                        <select name="OrderStatus" class="form-select">
                            <option value="Pending"
                                    selected="@(string.IsNullOrWhiteSpace(Model.OrderStatus) || string.Equals(Model.OrderStatus,"Pending",StringComparison.OrdinalIgnoreCase))">
                                Chờ xác nhận
                            </option>
                            <option value="Processing"
                                    selected="@(string.Equals(Model.OrderStatus,"Processing",StringComparison.OrdinalIgnoreCase))">
                                Đang chuẩn bị
                            </option>
                            <option value="Shipping"
                                    selected="@(string.Equals(Model.OrderStatus,"Shipping",StringComparison.OrdinalIgnoreCase))">
                                Đang giao
                            </option>
                            <option value="Completed"
                                    selected="@(string.Equals(Model.OrderStatus,"Completed",StringComparison.OrdinalIgnoreCase))">
                                Hoàn tất
                            </option>
                            <option value="Cancelled"
                                    selected="@(string.Equals(Model.OrderStatus,"Cancelled",StringComparison.OrdinalIgnoreCase))">
                                Đã hủy
                            </option>
                        </select>
                        <small class="text-muted">Hiện tại: @VNOrder(Model.OrderStatus)</small>
                    </div>

                    <div class="mb-1">
                        <label class="form-label">Phí vận chuyển</label>
                        <input name="ShippingFee" type="number" step="0.01" class="form-control"
                               value="@((Model.ShippingFee ?? 0m).ToString(CultureInfo.InvariantCulture))" />
                        <div class="form-text">Nhập số thập phân bằng dấu chấm (ví dụ: 15000.50)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng chi tiết -->
    <div class="card mb-3">
        <div class="card-header bg-transparent fw-bold">
            <i class="fas fa-box-open me-2 text-primary"></i>Sản phẩm trong đơn
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-modern mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Sản phẩm</th>
                            <th>Thuộc tính</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderDetails?.Any() == true)
                        {
                            var idx = 0;
                            foreach (var d in Model.OrderDetails)
                            {
                                var pv = d.ProductVariant;
                                var name = pv?.Product?.ProductName ?? $"Variant #{pv?.VariantId}";
                                var color = pv?.Color?.ColorName;
                                var size = pv?.Size?.SizeName;

                                <tr>
                                    <input type="hidden" name="Lines[@idx].OrderDetailId" value="@d.OrderDetailId" />

                                    <td>@pv?.Sku</td>
                                    <td class="fw-semibold">@name</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(color))
                                        {
                                            <span class="me-2"><i class="fas fa-palette me-1"></i>@color</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(size))
                                        {
                                            <span><i class="fas fa-ruler-combined me-1"></i>@size</span>
                                        }
                                    </td>
                                    <td class="text-center" style="width:120px">
                                        <input name="Lines[@idx].Quantity" type="number" min="0" class="form-control text-center"
                                               value="@(d.Quantity ?? 0)" />
                                    </td>
                                    <td class="text-end" style="width:160px">
                                        <input name="Lines[@idx].UnitPrice" type="number" step="0.01" class="form-control text-end"
                                               value="@((d.UnitPrice ?? 0m).ToString(CultureInfo.InvariantCulture))" />
                                    </td>
                                    <td class="text-end fw-semibold">
                                        @(((d.TotalPrice ?? (d.UnitPrice ?? 0m) * (d.Quantity ?? 0)).ToString("N0", vi))) ₫
                                    </td>
                                </tr>

                                idx++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center text-muted">Không có sản phẩm nào</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Quay lại
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-1"></i>Lưu thay đổi
        </button>
    </div>
</form>

<style>
    .table-modern th {
        white-space: nowrap;
    }

    /* Làm mờ các option bị vô hiệu hoá */
    select.form-select option:disabled {
        color: #6c757d;
    }

    /* Khi mọi lựa chọn hợp lệ đều bị khoá, làm mờ cả select */
    .is-locked {
        opacity: .65;
        pointer-events: none;
    }
</style>

<script>
    (function () {
      const paySel  = document.querySelector('select[name="PaymentStatus"]');
      const statSel = document.querySelector('select[name="OrderStatus"]');

      // Bậc của trạng thái đơn để chặn hạ cấp
      const rank = { Pending: 0, Processing: 1, Shipping: 2, Completed: 3 };

      // Lấy trạng thái đơn hiện tại từ server (fallback 'Pending' nếu null/empty)
      const currentOrder = (('@Model.OrderStatus' || '').trim() || 'Pending');
      let currentOrderNorm = normalizeOrder(currentOrder);

      function normalizeOrder(s) {
        const x = (s || '').toLowerCase();
        if (!x || x === 'pending' || x === 'chờ xác nhận') return 'Pending';
        if (['processing','đang chuẩn bị','đang xử lý','chờ xử lý'].includes(x)) return 'Processing';
        if (['shipping','đang giao','vận chuyển'].includes(x)) return 'Shipping';
        if (['completed','delivered','hoàn tất','hoàn thành'].includes(x)) return 'Completed';
        if (['cancelled','canceled','đã huỷ','đã hủy'].includes(x)) return 'Cancelled';
        return 'Pending';
      }

      function normalizePay(s) {
        const x = (s || '').toLowerCase();
        if (x === 'paid' || x === 'đã thanh toán' || x === 'da thanh toan') return 'Paid';
        if (x === 'pending' || x === 'chờ thanh toán' || x === 'cho thanh toan') return 'Pending';
        return 'Unpaid';
      }

      // Nếu payment hiện tại là Paid, khoá các option khác (UI – server vẫn là chốt)
      const currentPay = normalizePay(paySel.dataset.current || paySel.value);
      if (currentPay === 'Paid') {
        [...paySel.options].forEach(opt => { if (opt.value !== 'Paid') opt.disabled = true; });
        paySel.value = 'Paid';
      }

      function enforce() {
        const pay = normalizePay(paySel.value);
        const isPaid = pay === 'Paid';

        // 1) Completed chỉ bật khi đã thanh toán
        [...statSel.options].forEach(opt => {
          if (opt.value === 'Completed') {
            opt.disabled = !isPaid;
          }
        });

        // 2) Không cho hạ cấp trạng thái đơn (disable option có bậc < hiện tại)
        const curRank = rank[currentOrderNorm] ?? 0;
        [...statSel.options].forEach(opt => {
          const val = opt.value;
          if (val in rank) {
            const r = rank[val];
            if (r < curRank) opt.disabled = true;
          }
        });

        // 3) Nếu đang chọn Completed nhưng payment không phải Paid, nảy về Shipping/Processing
        if (!isPaid && statSel.value === 'Completed') {
          const fallback = [...statSel.options].find(o => !o.disabled && (o.value === 'Shipping' || o.value === 'Processing'))?.value || 'Processing';
          statSel.value = fallback;
        }

        // 4) Nếu mọi option hợp lệ đều disabled, khoá cả select để thể hiện không còn tương tác
        const anyEnabled = [...statSel.options].some(o => !o.disabled);
        statSel.classList.toggle('is-locked', !anyEnabled);
      }

      // Khi người dùng cố chọn trạng thái thấp hơn hiện tại, tự động phục hồi về lựa chọn hợp lệ gần nhất
      statSel.addEventListener('change', () => {
        const val = statSel.value;
        if (val in rank && (rank[val] < (rank[currentOrderNorm] ?? 0))) {
          const fallback = [...statSel.options]
            .map(o => o.value)
            .filter(v => (v in rank) && rank[v] >= (rank[currentOrderNorm] ?? 0))
            .sort((a,b) => rank[a] - rank[b])[0] || currentOrderNorm;
          statSel.value = fallback;
        }
      });

      paySel.addEventListener('change', enforce);

      // Khởi tạo
      enforce();
    })();
</script>
