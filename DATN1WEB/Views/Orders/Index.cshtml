@model List<DATN1API.Models.Order>
@using System.Globalization
@using System.Linq
@{
    ViewData["Title"] = "Đơn hàng";
    string q = Context.Request.Query["search"];
    string orderStatus = Context.Request.Query["orderStatus"];
    string paymentStatus = Context.Request.Query["paymentStatus"];

    Func<object?, string> formatDate = d =>
    {
        if (d == null) return "";
        if (d is DateTime dt) return dt.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture);
        if (d is DateTimeOffset dto) return dto.LocalDateTime.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture);
        return d.ToString();
    };

    // ===== Badge cho OrderStatus (giữ logic cũ, nhận EN & VI)
    string OrderBadgeClass(string? s) => (s ?? "").Trim().ToLowerInvariant() switch
    {
        "pending" or "chờ xác nhận" => "badge bg-warning-subtle text-warning fw-semibold",
        "processing" or "đang chuẩn bị" or "đang xử lý" or "chờ xử lý" => "badge bg-primary-subtle text-primary fw-semibold",
        "shipping" or "đang giao" or "vận chuyển" => "badge bg-info-subtle text-info fw-semibold",
        "completed" or "delivered" or "hoàn tất" or "hoàn thành" => "badge bg-success-subtle text-success fw-semibold",
        "cancelled" or "canceled" or "đã huỷ" or "đã hủy" => "badge bg-danger-subtle text-danger fw-semibold",
        _ => "badge bg-light text-dark fw-semibold"
    };
    string VNOrder(string? s) => (s ?? "").Trim().ToLowerInvariant() switch
    {
        "pending" or "chờ xác nhận" => "Chờ xác nhận",
        "processing" or "đang chuẩn bị" or "đang xử lý" or "chờ xử lý" => "Đang chuẩn bị",
        "shipping" or "đang giao" or "vận chuyển" => "Đang giao",
        "completed" or "delivered" or "hoàn tất" or "hoàn thành" => "Hoàn tất",
        "cancelled" or "canceled" or "đã huỷ" or "đã hủy" => "Đã huỷ",
        _ => "Không rõ"
    };
}

@functions {
    // ===== CHUẨN HOÁ PAYMENT TỪ DB (EN/VN) =====
    private string NormalizePaymentView(string? s)
    {
        var x = (s ?? "").Trim().ToLowerInvariant();
        return x switch
        {
            "paid" or "đã thanh toán" or "da thanh toan" => "Paid",
            "unpaid" or "chưa thanh toán" or "chua thanh toan" => "Unpaid",
            "pending" or "chờ thanh toán" or "cho thanh toan" => "Pending",
            _ => "Unknown"
        };
    }
    private string PaymentLabel(string? s) => NormalizePaymentView(s) switch
    {
        "Paid" => "Đã thanh toán",
        "Unpaid" => "Chưa thanh toán",
        "Pending" => "Chờ thanh toán",
        _ => "Không rõ"
    };
    private string PaymentBadgeClass(string? s) => NormalizePaymentView(s) switch
    {
        "Paid" => "badge bg-success-subtle text-success fw-semibold",
        "Unpaid" => "badge bg-secondary-subtle text-secondary fw-semibold",
        "Pending" => "badge bg-warning-subtle text-warning fw-semibold",
        _ => "badge bg-light text-dark fw-semibold"
    };
}

<div class="content-header">
    <div>
        <h1 class="mb-2"><i class="fas fa-receipt me-3 text-success"></i>Đơn hàng</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index","Admin")">Dashboard</a></li>
                <li class="breadcrumb-item active">Quản lý đơn hàng</li>
            </ol>
        </nav>
    </div>

    <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
        <div class="input-group" style="width: 300px;">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input name="search" value="@q" class="form-control" placeholder="Mã đơn / tên / SĐT / địa chỉ..." />
        </div>

        <!-- OrderStatus -->
        <select name="orderStatus" class="form-select" style="width:200px">
            <option value="">-- Trạng thái đơn --</option>
            <option value="Pending" selected="@(string.Equals(orderStatus,"Pending",   StringComparison.OrdinalIgnoreCase))">Chờ xác nhận</option>
            <option value="Processing" selected="@(string.Equals(orderStatus,"Processing",StringComparison.OrdinalIgnoreCase))">Đang chuẩn bị</option>
            <option value="Shipping" selected="@(string.Equals(orderStatus,"Shipping",  StringComparison.OrdinalIgnoreCase))">Đang giao</option>
            <option value="Completed" selected="@(string.Equals(orderStatus,"Completed", StringComparison.OrdinalIgnoreCase))">Hoàn tất</option>
            <option value="Cancelled" selected="@(string.Equals(orderStatus,"Cancelled", StringComparison.OrdinalIgnoreCase))">Đã hủy</option>
        </select>

        <!-- PaymentStatus -->
        <select name="paymentStatus" class="form-select" style="width:170px">
            <option value="">-- TT Thanh toán --</option>
            <option value="Paid" selected="@(string.Equals(paymentStatus,"Paid",  StringComparison.OrdinalIgnoreCase))">Đã thanh toán</option>
            <option value="Unpaid" selected="@(string.Equals(paymentStatus,"Unpaid",StringComparison.OrdinalIgnoreCase))">Chưa thanh toán</option>
            <option value="Pending" selected="@(string.Equals(paymentStatus,"Pending",StringComparison.OrdinalIgnoreCase))">Chờ thanh toán</option>
        </select>

        <button class="btn btn-outline-primary"><i class="fas fa-filter me-1"></i>Lọc</button>
    </form>
</div>

<!-- Stats -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-muted small mb-1">Tổng đơn</h6>
                    <h4 class="fw-bold text-dark mb-0">@ViewBag.TotalOrders</h4>
                </div>
                <div class="stat-icon bg-primary bg-opacity-10"><i class="fas fa-receipt text-primary"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-muted small mb-1">Chờ xác nhận</h6>
                    <h4 class="fw-bold text-dark mb-0">@ViewBag.PendingCount</h4>
                </div>
                <div class="stat-icon bg-warning bg-opacity-10"><i class="fas fa-hourglass-half text-warning"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-muted small mb-1">Đã thanh toán</h6>
                    <h4 class="fw-bold text-dark mb-0">@ViewBag.PaidCount</h4>
                </div>
                <div class="stat-icon bg-success bg-opacity-10"><i class="fas fa-check-circle text-success"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-muted small mb-1">Chưa thanh toán</h6>
                    <h4 class="fw-bold text-dark mb-0">@ViewBag.UnpaidCount</h4>
                </div>
                <div class="stat-icon bg-secondary bg-opacity-10"><i class="fas fa-wallet text-secondary"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Orders table -->
<div class="card">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="fas fa-list me-2 text-primary"></i>Danh sách đơn hàng</h5>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Khách nhận</th>
                        <th>SĐT</th>
                        <th class="text-center">SL</th>
                        <th class="text-end">Thành tiền</th>
                        <th>TT thanh toán</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var o in Model)
                        {
                            var subTotal = o.TotalAmount ?? 0m;
                            var ship = o.ShippingFee ?? 0m;
                            var grand = subTotal + ship;

                            int qty = o.OrderDetails?.Any() == true
                            ? o.OrderDetails.Sum(d => d.Quantity ?? 0)
                            : (o.Quantity ?? 0);

                            <tr>
                                <td class="fw-semibold">#@o.OrderId</td>
                                <td>@formatDate(o.OrderDate)</td>
                                <td>@o.RecipientName</td>
                                <td>@o.RecipientPhone</td>
                                <td class="text-center">@qty</td>
                                <td class="text-end fw-semibold">@grand.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</td>

                                <!-- Payment status: dùng helper chuẩn hoá -->
                                <td>
                                    <span class="@PaymentBadgeClass(o.PaymentStatus)">
                                        @PaymentLabel(o.PaymentStatus)
                                    </span>
                                </td>

                                <!-- Order status -->
                                <td>
                                    <span class="@OrderBadgeClass(o.OrderStatus)">
                                        @VNOrder(o.OrderStatus)
                                    </span>
                                </td>

                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-action="Details" asp-route-id="@o.OrderId" class="btn btn-action btn-outline-info" title="Chi tiết"><i class="fas fa-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@o.OrderId" class="btn btn-action btn-outline-warning" title="Sửa"><i class="fas fa-edit"></i></a>
                                        
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted">Không có đơn hàng nào</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table-modern th {
        white-space: nowrap;
    }

    .badge {
        font-size: .75rem;
        padding: .5em .6em;
        border-radius: .5rem;
    }

    .stat-card .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: grid;
        place-items: center;
    }

    .btn-action {
        padding: .25rem .5rem;
    }
</style>

<!-- (tuỳ chọn) Heartbeat/SignalR của bạn có thể giữ nguyên như trước -->
