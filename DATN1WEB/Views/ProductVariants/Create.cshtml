@model DATN1API.Models.ProductVariant
@{
    ViewData["Title"] = "Thêm biến thể";
    var errorCount = ViewData.ModelState?.Values.SelectMany(v => v.Errors).Count() ?? 0;
}

<div class="container py-3">
    <div class="card shadow-sm rounded-3">
        <div class="card-header bg-white border-0">
            <h2 class="h4 mb-0"><i class="fas fa-sitemap me-2 text-primary"></i>@ViewData["Title"]</h2>
        </div>

        <div class="card-body">
            <div id="modelSummary" class="alert alert-danger @(errorCount > 0 ? "" : "d-none")" role="alert" asp-validation-summary="All"></div>

            <form id="variantForm" asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <!-- Hàng 1 -->
                    <div class="col-12 col-lg-6">
                        <label class="form-label">Sản phẩm <span class="text-danger">*</span></label>
                        <select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products">
                            <option value="">-- Chọn sản phẩm --</option>
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label class="form-label">Màu <span class="text-danger">*</span></label>
                        <select asp-for="ColorId" class="form-select" asp-items="ViewBag.Colors">
                            <option value="">-- Chọn màu --</option>
                        </select>
                        <span asp-validation-for="ColorId" class="text-danger small"></span>
                    </div>

                    <!-- Hàng 2 -->
                    <div class="col-12 col-lg-6">
                        <label class="form-label">Kích cỡ <span class="text-danger">*</span></label>
                        <select asp-for="SizeId" class="form-select" asp-items="ViewBag.Sizes">
                            <option value="">-- Chọn size --</option>
                        </select>
                        <span asp-validation-for="SizeId" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label class="form-label">SKU</label>
                        <input type="hidden" asp-for="Sku" />
                        <span id="SkuPreview" class="form-control bg-light"></span>
                    </div>

                    <!-- Hàng 3 -->
                    <div class="col-12 col-lg-6">
                        <label class="form-label">Tồn kho</label>
                        <input asp-for="Stock" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label class="form-label">Trạng thái</label>
                        <input type="hidden" asp-for="Status" value="Đang bán" />
                        <span class="form-control">Đang bán</span>
                    </div>

                    <!-- Hàng 4: GIÁ – tách input hiển thị & input thật -->
                    <div class="col-12 col-lg-6">
                        <label class="form-label">Giá gốc</label>
                        <div class="input-group">
                            <input id="OriginalPrice_view" class="form-control currency-view" type="text" data-type="currency" />
                            <span class="input-group-text">₫</span>
                        </div>
                        <!-- input thật gửi server -->
                        <input asp-for="OriginalPrice" type="hidden" />
                        <span class="text-danger small" id="OriginalPrice_view_error"></span>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label class="form-label">Giá bán</label>
                        <div class="input-group">
                            <input id="SalePrice_view" class="form-control currency-view" type="text" data-type="currency" />
                            <span class="input-group-text">₫</span>
                        </div>
                        <!-- input thật gửi server -->
                        <input asp-for="SalePrice" type="hidden" />
                        <span class="text-danger small" id="SalePrice_view_error"></span>
                    </div>

                    <!-- Hàng 5: 6 | 3 | 3 (ảnh) -->
                    <div class="col-12 col-lg-6">
                        <label class="form-label">Ảnh đại diện</label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                        <small class="text-muted d-block mt-2">Để trống nếu không thay ảnh.</small>
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-lg-3">
                        <label class="form-label d-block">Ảnh đại diện hiện tại</label>
                        <div class="ratio ratio-1x1 bg-light rounded border d-flex align-items-center justify-content-center" style="max-width:180px;">
                            <span class="text-muted small">Chưa có ảnh.</span>
                        </div>
                    </div>

                    <div class="col-12 col-lg-3">
                        <label class="form-label d-block">Xem trước ảnh đại diện mới</label>
                        <div id="thumbPreview" class="d-none">
                            <div class="ratio ratio-1x1 bg-light rounded border" style="max-width: 180px;">
                                <img id="thumbPreviewImg" class="w-100 h-100" style="object-fit: cover;" alt="Preview thumbnail">
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="fas fa-save me-1"></i> Lưu
                    </button>
                    <a asp-controller="SanPham" asp-action="Index" class="btn btn-secondary px-4">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/localization/messages_vi.min.js"></script>

    <script>
        // ---------- Helpers tiền tệ ----------
        function normalizeMoney(val) {
          if (val == null) return '';
          return String(val).replace(/[^\d.-]/g, ''); // "1,200,000" -> "1200000"
        }
        function formatCurrencyInput(el) {
          let v = el.value || '';
          if (!v) { el.value = ''; return; }
          v = v.replace(/[^\d.-]/g, '');
          const neg = v.startsWith('-');
          const parts = v.split('.');
          let intPart = parts[0].replace(/-/g, '');
          intPart = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
          el.value = (neg ? '-' : '') + intPart + (parts[1] ? '.' + parts[1] : '');
        }
        function syncPriceHidden() {
          // đồng bộ input thật từ 2 ô hiển thị
          $('[name="SalePrice"]').val( normalizeMoney($('#SalePrice_view').val()) );
          $('[name="OriginalPrice"]').val( normalizeMoney($('#OriginalPrice_view').val()) );
        }
        function validatePricesClient() {
          // validate đơn giản cho 2 ô hiển thị (show message dưới ô)
          const sale = parseFloat(normalizeMoney($('#SalePrice_view').val()));
          const orig = parseFloat(normalizeMoney($('#OriginalPrice_view').val()));
          let ok = true;

          $('#SalePrice_view_error').text('');
          $('#OriginalPrice_view_error').text('');

          if (isNaN(sale) || sale <= 0) {
            $('#SalePrice_view_error').text('Vui lòng nhập giá bán hợp lệ (> 0)');
            ok = false;
          }
          if (isNaN(orig) || orig <= 0) {
            $('#OriginalPrice_view_error').text('Vui lòng nhập giá gốc hợp lệ (> 0)');
            ok = false;
          }
          if (ok && orig < sale) {
            $('#OriginalPrice_view_error').text('Giá gốc phải ≥ Giá bán');
            ok = false;
          }
          return ok;
        }

        // ---------- jQuery Validate (các field khác) ----------
        $(function () {
          // Việt hoá mặc định số/required nếu còn data-val
          const viMap = {
            ProductId: 'Vui lòng chọn sản phẩm',
            ColorId: 'Vui lòng chọn màu',
            SizeId: 'Vui lòng chọn kích cỡ',
            Stock: 'Vui lòng nhập tồn kho'
          };
          Object.keys(viMap).forEach(n => {
            const $el = $('[name="'+n+'"]');
            if ($el.is('[data-val-required]')) $el.attr('data-val-required', viMap[n]);
            if ($el.is('[type="number"]')) $el.attr('data-val-number', 'Vui lòng nhập số hợp lệ');
          });
          if ($.validator && $.validator.unobtrusive) {
            $.validator.unobtrusive.parse('#variantForm');
          }

          // Validate cho form (trừ 2 giá – ta tự xử lý client)
          $('#variantForm').validate({
            ignore: [],
            errorElement:'div',
            errorClass:'invalid-feedback',
            highlight: el => $(el).addClass('is-invalid'),
            unhighlight: el => $(el).removeClass('is-invalid'),
            errorPlacement: (err, el) => {
              if ($(el).parent('.input-group').length) err.insertAfter($(el).parent());
              else err.insertAfter(el);
            },
            invalidHandler: () => $('#modelSummary').removeClass('d-none').text('Vui lòng kiểm tra các trường được đánh dấu.'),
            rules: {
              ProductId: {}, ColorId: {}, SizeId: {},
              Stock: { required: true, number: true, min: 0 },
              ImageFile: { extension: "jpg|jpeg|png|webp|gif" }
            }
          });

          // Format + sync khi gõ hai ô giá hiển thị
          $(document).on('keyup blur', '#SalePrice_view, #OriginalPrice_view', function(){
            formatCurrencyInput(this);
            syncPriceHidden();
            validatePricesClient();
          });

          // Preview ảnh
          $('[name="ImageFile"]').on('change', function(){
            const $wrap = $('#thumbPreview'), $img = $('#thumbPreviewImg');
            if (!this.files || !this.files.length || !this.files[0].type.startsWith('image/')){
              $img.attr('src',''); $wrap.addClass('d-none'); return;
            }
            const url = URL.createObjectURL(this.files[0]);
            $img.attr('src', url).one('load', () => URL.revokeObjectURL(url));
            $wrap.removeClass('d-none');
          });

          // SKU tự sinh
          function toAsciiKeepSpaces(s){ return (s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').replace(/\s+/g,' ').trim(); }
          function genSku(){
            const pid=$('#ProductId').val(), size=$('#SizeId option:selected').text().trim(), color=$('#ColorId option:selected').text().trim();
            if(pid && $('#SizeId').val() && $('#ColorId').val()){
              const sku=`BAG_${toAsciiKeepSpaces(size)}_${toAsciiKeepSpaces(color)}_${pid}`;
              $('[name="Sku"]').val(sku); $('#SkuPreview').text(sku);
            } else { $('[name="Sku"]').val(''); $('#SkuPreview').text('(Chưa đủ dữ liệu để sinh SKU)'); }
          }
          $('#ProductId,#SizeId,#ColorId').on('change',genSku); genSku();

          // Submit: đồng bộ lần cuối & chặn nếu 2 giá không hợp lệ
          $('#variantForm').on('submit', function(e){
            syncPriceHidden();
            if(!validatePricesClient()){
              e.preventDefault();
              $('#modelSummary').removeClass('d-none').text('Vui lòng kiểm tra giá bán / giá gốc.');
            }
          });
        });
    </script>
}
