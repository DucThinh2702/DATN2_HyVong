@model DATN1API.Models.ProductVariant
@{
    ViewData["Title"] = "Sửa biến thể";
    var currentImg = string.IsNullOrWhiteSpace(Model?.ThumbnailImage) ? null : Url.Content(Model.ThumbnailImage);
    var gallery = Model?.GalleryPaths ?? new List<string>();
}

<h2 class="mb-3">@ViewData["Title"]</h2>
<hr />

<form asp-action="Edit" method="post" enctype="multipart/form-data" id="variantEditForm" novalidate>
    @Html.AntiForgeryToken()
    <div id="modelSummary" class="alert alert-danger d-none" role="alert" asp-validation-summary="ModelOnly"></div>

    <input type="hidden" asp-for="VariantId" />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Sản phẩm <span class="text-danger">*</span></label>
            <select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products"></select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Màu <span class="text-danger">*</span></label>
            <select asp-for="ColorId" class="form-select" asp-items="ViewBag.Colors"></select>
        </div>

        <div class="col-md-6">
            <label class="form-label">Kích cỡ <span class="text-danger">*</span></label>
            <select asp-for="SizeId" class="form-select" asp-items="ViewBag.Sizes"></select>
        </div>
        <div class="col-md-6">
            <label class="form-label">SKU</label>
            <input asp-for="Sku" class="form-control" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Tồn kho <span class="text-danger">*</span></label>
            <input asp-for="Stock" class="form-control" type="number" min="0" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Giá gốc <span class="text-danger">*</span></label>
            <input asp-for="OriginalPrice" class="form-control" type="number" step="0.01" min="0" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Giá bán <span class="text-danger">*</span></label>
            <input asp-for="SalePrice" class="form-control" type="number" step="0.01" min="0" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Trạng thái <span class="text-danger">*</span></label>
            <select asp-for="Status" class="form-select">
                <option value="Active">Đang bán</option>
                <option value="Inactive">Ngừng bán</option>
            </select>
        </div>

        <!-- THUMBNAIL -->
        <div class="col-md-6">
            <label class="form-label d-block">Ảnh đại diện hiện tại</label>
            @if (currentImg != null)
            {
                <div class="ratio ratio-1x1 bg-light rounded border mb-2" style="max-width: 180px;">
                    <img src="@currentImg" class="w-100 h-100" style="object-fit: cover;" />
                </div>
                <small class="text-muted d-block mb-2">Để trống nếu không thay ảnh.</small>
            }
            else
            {
                <div class="text-muted mb-2">Chưa có ảnh.</div>
            }

            <label class="form-label">Ảnh đại diện mới (tùy chọn)</label>
            <input name="ImageFile" type="file" class="form-control" accept="image/*" />

            <!-- Preview ảnh đại diện mới -->
            <div id="thumbPreview" class="mt-2 d-none">
                <label class="form-label">Xem trước ảnh đại diện mới</label>
                <div class="ratio ratio-1x1 bg-light rounded border" style="max-width: 180px;">
                    <img id="thumbPreviewImg" class="w-100 h-100" style="object-fit: cover;" alt="Preview thumbnail">
                </div>
            </div>
        </div>

        <!-- GALLERY -->
        <div class="col-md-6">
            <label class="form-label">Ảnh phụ (gallery) hiện có</label>
            @if (gallery.Any())
            {
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var p in gallery)
                    {
                        var url = Url.Content(p);
                        var fileName = System.IO.Path.GetFileName(p);
                        <div class="text-center">
                            <div class="ratio ratio-1x1 rounded border mb-2" style="width:110px;">
                                <img src="@url" class="w-100 h-100" style="object-fit:cover;" />
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="RemoveGallery" value="@fileName" id="del-@fileName" />
                                <label class="form-check-label small text-danger" for="del-@fileName">Xoá ảnh</label>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted mb-2">Chưa có ảnh phụ.</div>
            }

            <div class="mt-3">
                <label class="form-label">Thêm ảnh phụ mới</label>
                <input type="file" name="GalleryFiles" class="form-control" accept="image/*" multiple />

                <!-- Preview ảnh phụ mới -->
                <div id="galleryPreview" class="mt-2 d-none">
                    <label class="form-label">Xem trước ảnh phụ mới</label>
                    <div id="galleryPreviewList" class="d-flex flex-wrap gap-2"></div>
                </div>

                <small class="text-muted">Có thể chọn nhiều ảnh một lúc.</small>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Cập nhật</button>
        <a asp-controller="SanPham" asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/localization/messages_vi.min.js"></script>

    <script>
        // ====== Validate (giống nãy giờ) ======
        $(function () {
          $.validator.addMethod('onlyNumber', v => v==='' || !isNaN(parseFloat((v+'').replace(',','.'))), 'Vui lòng nhập số');
          $.validator.addMethod('gt0', v => v==='' || parseFloat((v+'').replace(',','.')) > 0, 'Vui lòng nhập số > 0');
          $.validator.addMethod('geTo', (v,el,sel)=> {
            const other=parseFloat(($(sel).val()||'').replace(',','.'));
            const cur=parseFloat((v||'').replace(',','.'));
            if(isNaN(other)||isNaN(cur)) return true;
            return cur>=other;
          }, 'Phải ≥ trường tham chiếu');
          $.validator.addMethod('fileSize',(v,el,bytes)=>!el.files?.length||el.files[0].size<=bytes,'Tệp quá lớn');
          $.validator.addMethod('imageType',(v,el)=>!el.files?.length||['image/jpeg','image/png','image/webp','image/gif'].includes(el.files[0].type),'Định dạng ảnh không hợp lệ');
          $.validator.addMethod('fileSizeMulti',(v,el,bytes)=>{if(!el.files?.length)return true; for(let f of el.files){if(f.size>bytes)return false;} return true;},'Có tệp vượt quá dung lượng');
          $.validator.addMethod('imageTypeMulti',(v,el)=>{if(!el.files?.length)return true;const ok=['image/jpeg','image/png','image/webp','image/gif'];for(let f of el.files){if(!ok.includes(f.type))return false;}return true;},'Có tệp sai định dạng');
          $.validator.addMethod('fileCountMax',(v,el,cnt)=>!el.files||el.files.length<=cnt,'Vượt quá số lượng tệp');

          $('#variantEditForm').validate({
            ignore: [],
            errorElement:'div',
            errorClass:'invalid-feedback',
            highlight:el=>$(el).addClass('is-invalid'),
            unhighlight:el=>$(el).removeClass('is-invalid'),
            errorPlacement:(err,el)=>$(el).closest('.input-group').length ? err.insertAfter($(el).closest('.input-group')) : err.insertAfter(el),
            invalidHandler:()=>$('#modelSummary').removeClass('d-none').text('Vui lòng kiểm tra các trường được đánh dấu.'),
            rules:{
              ProductId:{required:true},
              ColorId:{required:true},
              SizeId:{required:true},
              Stock:{required:true,onlyNumber:true,min:0},
              SalePrice:{required:true,onlyNumber:true,gt0:true},
              OriginalPrice:{required:true,onlyNumber:true,geTo:'#SalePrice'},
              Status:{required:true},
              ImageFile:{imageType:true,fileSize:2*1024*1024},
              'GalleryFiles':{imageTypeMulti:true,fileSizeMulti:2*1024*1024,fileCountMax:10}
            },
            messages:{
              ProductId:{required:'Vui lòng chọn sản phẩm'},
              ColorId:{required:'Vui lòng chọn màu'},
              SizeId:{required:'Vui lòng chọn kích cỡ'},
              Stock:{required:'Vui lòng nhập tồn kho'},
              SalePrice:{required:'Vui lòng nhập giá bán'},
              OriginalPrice:{required:'Vui lòng nhập giá gốc',geTo:'Giá gốc phải ≥ Giá bán'},
              Status:{required:'Vui lòng chọn trạng thái'},
              ImageFile:{imageType:'Chỉ JPEG/PNG/WebP/GIF',fileSize:'Tối đa 2MB'},
              'GalleryFiles':{imageTypeMulti:'Chỉ JPEG/PNG/WebP/GIF',fileSizeMulti:'Mỗi ảnh ≤2MB',fileCountMax:'Tối đa 10 ảnh'}
            }
          });

          $('#variantEditForm').on('submit',()=>['SalePrice','OriginalPrice','Stock'].forEach(n=>{
            const $i=$('[name="'+n+'"]');$i.val(($i.val()+'').replace(',','.'));
          }));
        });

        // ====== Preview ảnh ngay khi chọn ======
        function previewThumb(input) {
          const $wrap = $('#thumbPreview');
          const $img  = $('#thumbPreviewImg');

          if (!input.files || !input.files.length) {
            $img.attr('src',''); $wrap.addClass('d-none'); return;
          }
          const f = input.files[0];
          if (!f.type.startsWith('image/')) { $img.attr('src',''); $wrap.addClass('d-none'); return; }

          const url = URL.createObjectURL(f);
          $img.attr('src', url).on('load', function(){ URL.revokeObjectURL(url); $(this).off('load'); });
          $wrap.removeClass('d-none');
        }

        let __galleryObjectUrls = [];
        function cleanupGalleryUrls(){ __galleryObjectUrls.forEach(u=>{ try{URL.revokeObjectURL(u);}catch{} }); __galleryObjectUrls=[]; }

        function previewGallery(input) {
          const $wrap = $('#galleryPreview');
          const $list = $('#galleryPreviewList');
          $list.empty();
          cleanupGalleryUrls();

          if (!input.files || !input.files.length) { $wrap.addClass('d-none'); return; }

          Array.from(input.files).forEach((f, i) => {
            if (!f.type.startsWith('image/')) return;
            const url = URL.createObjectURL(f); __galleryObjectUrls.push(url);
            const $item = $(
              '<div class="position-relative border rounded overflow-hidden" style="width:110px;height:110px;">' +
                '<img class="w-100 h-100" style="object-fit:cover;" alt="Preview '+(i+1)+'">' +
              '</div>'
            );
            $item.find('img').attr('src', url);
            $list.append($item);
          });

          $wrap.toggleClass('d-none', $list.children().length === 0);
        }

        $(function(){
          $('#variantEditForm input[name="ImageFile"]').on('change', function(){ previewThumb(this); });
          $('#variantEditForm input[name="GalleryFiles"]').on('change', function(){ previewGallery(this); });
        });
    </script>
}
