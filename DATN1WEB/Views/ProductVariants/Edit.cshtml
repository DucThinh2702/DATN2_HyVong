@model DATN1API.Models.ProductVariant
@{
    ViewData["Title"] = "Sửa biến thể";
}
<h2>@ViewData["Title"]</h2>
<hr />
<form asp-action="Edit" enctype="multipart/form-data">
    <input type="hidden" asp-for="VariantId" />
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Sản phẩm</label>
            <select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products"></select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Màu</label>
            <select asp-for="ColorId" class="form-select" asp-items="ViewBag.Colors"></select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Kích cỡ</label>
            <select asp-for="SizeId" class="form-select" asp-items="ViewBag.Sizes"></select>
        </div>
        <div class="col-md-4">
            <label class="form-label">SKU</label>
            <input asp-for="Sku" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Tồn kho</label>
            <input asp-for="Stock" class="form-control" type="number" min="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Giá gốc</label>
            <input asp-for="OriginalPrice" class="form-control" type="number" step="0.01" min="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Giá bán</label>
            <input asp-for="SalePrice" class="form-control" type="number" step="0.01" min="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Trạng thái</label>
            <input asp-for="Status" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Ảnh mới (tuỳ chọn)</label>
            <input name="ImageFile" type="file" class="form-control" />
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-secondary">Quay lại</a>
    </div>
</form>
