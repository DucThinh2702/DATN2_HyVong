@model DATN1API.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(160px,1fr));
        gap: .5rem .75rem;
        border: 1px solid #e9ecef;
        padding: .75rem;
        border-radius: .5rem;
        max-height: 260px;
        overflow: auto;
    }

    .table .form-control.is-invalid, .table .form-select.is-invalid {
        border-color: #dc3545 !important;
        box-shadow: none !important;
    }
</style>

<div class="content-header">
    <h1 class="mb-4">Thêm sản phẩm mới</h1>

    <form asp-action="Create" enctype="multipart/form-data" method="post" id="productForm" novalidate>
        <!-- Tên sản phẩm -->
        <div class="mb-3">
            <label for="ProductName" class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
            <input asp-for="ProductName" class="form-control" placeholder="Vui lòng nhập tên sản phẩm" />
        </div>

        <!-- Mô tả -->
        <div class="mb-3">
            <label for="Description" class="form-label fw-bold">Mô tả sản phẩm <span class="text-danger">*</span></label>
            <textarea asp-for="Description" class="form-control" id="Description"></textarea>
        </div>

        <!-- Danh mục & Trạng thái -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                @Html.DropDownListFor(model => model.CategoryId, (SelectList)ViewBag.Categories, "-- Chọn danh mục --", new { @class = "form-select", @id = "CategoryId" })
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Status" class="form-label fw-bold">
                    Trạng thái <span class="text-danger">*</span>
                </label>
                <input asp-for="Status" class="form-control" value="Đang bán" readonly />
            </div>
        </div>

        <!-- Chất liệu & Ảnh chính -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="Material" class="form-label fw-bold">Chất liệu <span class="text-danger">*</span></label>
                <input asp-for="Material" class="form-control" placeholder="Vui lòng nhập chất liệu sản phẩm" />
            </div>
            <div class="col-md-6 mb-3">
                <label for="ImageFile" class="form-label fw-bold">Ảnh sản phẩm <span class="text-danger">*</span></label>
                <input type="file" name="ImageFile" id="ImageFile" class="form-control" accept="image/*" />
            </div>
        </div>

        <!-- Màu sắc và kích cỡ -->
        <div class="row">
            <!-- Màu -->
            <div class="col-md-6 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-bold mb-0">Chọn màu: <span class="text-danger">*</span></label>
                    <a asp-controller="Colors" asp-action="Create"
                       asp-route-returnUrl="@Url.Action("Create","SanPham")"
                       class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle"></i> Thêm màu
                    </a>
                </div>
                <div class="checkbox-grid" id="colorsBox">
                    @foreach (DATN1WEB.Models.Color color in ViewBag.Colors)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input color-checkbox"
                                   value="@color.ColorId" id="color-@color.ColorId" />
                            <label class="form-check-label" for="color-@color.ColorId">@color.ColorName</label>
                        </div>
                    }
                </div>
            </div>

            <!-- Size -->
            <div class="col-md-6 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-bold mb-0">Chọn kích cỡ: <span class="text-danger">*</span></label>
                    <a asp-controller="Sizes" asp-action="Create"
                       asp-route-returnUrl="@Url.Action("Create","SanPham")"
                       class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle"></i> Thêm kích cỡ
                    </a>
                </div>
                <div class="checkbox-grid" id="sizesBox">
                    @foreach (DATN1WEB.Models.Size size in ViewBag.Sizes)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input size-checkbox"
                                   value="@size.SizeId" id="size-@size.SizeId" />
                            <label class="form-check-label" for="size-@size.SizeId">@size.SizeName</label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Bảng biến thể -->
        <div class="mt-4">
            <h4>Biến thể sản phẩm</h4>
            <div class="text-muted mb-2">Sẽ tự tạo sau khi chọn Màu & Kích cỡ.</div>
            <table class="table table-bordered" id="variantTable">
                <thead>
                    <tr>
                        <th>Kích cỡ</th>
                        <th>Màu</th>
                        <th>Số lượng <span class="text-danger">*</span></th>
                        <th>Giá bán <span class="text-danger">*</span></th>
                        <th>Giá gốc <span class="text-danger">*</span></th>
                        <th>Trạng thái</th>
                        <th>Ảnh đại diện</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-save2 me-2"></i>Lưu sản phẩm</button>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left-circle me-2"></i>Quay lại</a>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/localization/messages_vi.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>

    <script>
        $(function () {
          // ===== Summernote -> đồng bộ plain text để jQuery Validate đọc =====
          $('#Description').summernote({
            height: 200,
            callbacks: {
              onChange: function (contents) {
                $('#Description').val($('<div>').html(contents).text().trim()).trigger('keyup');
              }
            }
          });

          // ================== CUSTOM METHODS ==================
          $.validator.addMethod('onlyNumber', v => $.isNumeric(v) || v === '', 'Vui lòng nhập số');
          $.validator.addMethod('gt0', v => {
            const n = parseFloat(v);
            return v === '' || (!isNaN(n) && n > 0);
          }, 'Phải > 0');

          // Chấp nhận ảnh JPEG / PNG / WebP và giới hạn kích thước
          $.validator.addMethod('imageType', function (v, el) {
            if (!el.files || !el.files.length) return true;
            return ['image/jpeg', 'image/png', 'image/webp'].includes(el.files[0].type);
          }, 'Định dạng ảnh không hợp lệ');
          $.validator.addMethod('fileSize', function (v, el, bytes) {
            if (!el.files || !el.files.length) return true;
            return el.files[0].size <= bytes;
          }, 'Tệp quá lớn');

          // Phải chọn ít nhất 1 màu / 1 size
          $.validator.addMethod('requireColor', () => $('.color-checkbox:checked').length > 0, 'Vui lòng chọn ít nhất 1 màu');
          $.validator.addMethod('requireSize',  () => $('.size-checkbox:checked').length > 0, 'Vui lòng chọn ít nhất 1 kích cỡ');

          // ===== Tiền tệ: chuẩn hoá và validate =====
          function normalizeMoney(val) {
            if (val == null) return '';
            return String(val).replace(/[^\d.-]/g, '');
          }
          $.validator.addMethod('money', function (v) {
            const n = parseFloat(normalizeMoney(v));
            return !isNaN(n);
          }, 'Giá không hợp lệ');
          $.validator.addMethod('gtMoney0', function (v) {
            const n = parseFloat(normalizeMoney(v));
            return !isNaN(n) && n > 0;
          }, 'Phải > 0');
          $.validator.addMethod('origGeSaleInRow', function (v, el) {
            const $tr  = $(el).closest('tr');
            const sale = parseFloat(normalizeMoney($tr.find('.v-sale').val()));
            const orig = parseFloat(normalizeMoney(v));
            if (isNaN(sale) || isNaN(orig)) return true;
            return orig >= sale;
          }, 'Giá gốc phải ≥ Giá bán');

          // ================== HIDDEN INPUTS DÙNG CHO VALIDATE ==================
          if ($('input[name="colorGroup"]').length === 0) $('<input>', { type: 'hidden', name: 'colorGroup' }).appendTo('#productForm');
          if ($('input[name="sizeGroup"]').length === 0)  $('<input>', { type: 'hidden', name: 'sizeGroup'  }).appendTo('#productForm');

          // ================== FORM VALIDATE ==================
          const $form = $('#productForm');
          $form.validate({
            ignore: [],
            onkeyup:   el => $(el).valid(),
            onfocusout:el => $(el).valid(),
            errorElement: 'div',
            errorClass: 'invalid-feedback',
            highlight:   el => $(el).addClass('is-invalid'),
            unhighlight: el => $(el).removeClass('is-invalid'),
            errorPlacement: (err, el) => { el.closest('td').length ? err.appendTo(el.closest('td')) : err.insertAfter(el); },
            rules: {
              ProductName: { required: true, minlength: 10 },
              Description: { required: true, minlength: 10 },
              CategoryId:  { required: true },
              Status:      { required: true, minlength: 3 },
              Material:    { required: true, minlength: 3 },
              ImageFile:   { required: true, imageType: true, fileSize: 2 * 1024 * 1024 },
              colorGroup:  { requireColor: true },
              sizeGroup:   { requireSize: true }
            },
            messages: {
              ProductName: { required: 'Vui lòng nhập tên sản phẩm', minlength: 'Ít nhất 10 ký tự' },
              Description: { required: 'Vui lòng nhập mô tả', minlength: 'Ít nhất 10 ký tự' },
              CategoryId:  { required: 'Vui lòng chọn danh mục' },
              Status:      { required: 'Vui lòng nhập trạng thái' },
              Material:    { required: 'Vui lòng nhập chất liệu' },
              ImageFile:   { required: 'Vui lòng chọn ảnh (JPEG/PNG/WebP, ≤2MB)', imageType: 'Chỉ JPEG/PNG/WebP', fileSize: 'Tối đa 2MB' }
            }
          });

          // ================== TẠO BẢNG BIẾN THỂ (ẨN TRẠNG THÁI) ==================
          function generateVariants() {
            const $colors = $('.color-checkbox:checked');
            const $sizes  = $('.size-checkbox:checked');
            const $tb = $('#variantTable tbody');
            $tb.empty();

            // ép validate chọn màu/size
            $('input[name="colorGroup"]').valid();
            $('input[name="sizeGroup"]').valid();

            if ($colors.length === 0 || $sizes.length === 0) return;

            let idx = 0;
            $sizes.each(function () {
              const sizeId   = $(this).val();
              const sizeName = $(this).closest('.form-check').find('label').text().trim();
              $colors.each(function () {
                const colorId   = $(this).val();
                const colorName = $(this).closest('.form-check').find('label').text().trim();

                const tr = $(`
                  <tr>
                    <td>${sizeName}<input type="hidden" name="ProductVariants[${idx}].SizeId" value="${sizeId}" /></td>
                    <td>${colorName}<input type="hidden" name="ProductVariants[${idx}].ColorId" value="${colorId}" /></td>
                    <td><input type="number" name="ProductVariants[${idx}].Stock" class="form-control v-stock" min="0" /></td>
                    <td><input type="text"   name="ProductVariants[${idx}].SalePrice" class="form-control v-sale"  data-type="currency" /></td>
                    <td><input type="text"   name="ProductVariants[${idx}].OriginalPrice" class="form-control v-orig" data-type="currency" /></td>
                           <td>
          <!-- gửi giá trị thật lên server -->
          <input type="hidden" name="ProductVariants[${idx}].Status" value="Active" />
          <!-- hiển thị như input, không cho sửa -->
          <input type="text" class="form-control" value="Đang bán" readonly style="color:#212529;" />
        </td>

                    <td><input type="file" name="ProductVariants[${idx}].ImageFile" class="form-control v-img" accept="image/*" /></td>
                  </tr>`);

                $tb.append(tr);

                // ===== Rules cho từng input trong hàng =====
                tr.find('.v-stock').rules('add', { required: true, onlyNumber: true, min: 0, messages: { required: 'Nhập số lượng' } });
                tr.find('.v-sale').rules('add',  { required: true, money: true, gtMoney0: true, messages: { required: 'Nhập giá bán' } });
                tr.find('.v-orig').rules('add',  { required: true, money: true, gtMoney0: true, origGeSaleInRow: true, messages: { required: 'Nhập giá gốc' } });
                // KHÔNG thêm rule cho status vì đã cố định bằng hidden
                tr.find('.v-img').rules('add',   { imageType: true, fileSize: 2 * 1024 * 1024, messages: { imageType: 'JPEG/PNG/WebP', fileSize: '≤ 2MB' } });

                idx++;
              });
            });
          }
          $(document).on('change', '.color-checkbox, .size-checkbox', generateVariants);

          // ================== ĐỊNH DẠNG TIỀN ==================
          function formatCurrencyInput(el) {
            let val = el.value || '';
            if (!val) { el.value = ''; return; }
            // giữ số & dấu . -
            val = val.replace(/[^\d.-]/g, '');
            // tách phần thập phân nếu có
            const parts = val.split('.');
            let intPart = parts[0].replace(/-/g,'');
            const neg = val.startsWith('-');
            intPart = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            el.value = (neg ? '-' : '') + intPart + (parts.length > 1 ? '.' + parts[1] : '');
          }
          $(document).on('keyup blur', 'input[data-type="currency"]', function(){ formatCurrencyInput(this); });

          // Trước khi submit: gỡ dấu phẩy để server nhận số thuần
          function stripCurrencyBeforeSubmit() {
            $('input[data-type="currency"]').each(function () {
              this.value = normalizeMoney(this.value); // "1,200,000" -> "1200000"
            });
          }
          $form.on('submit', function () {
            stripCurrencyBeforeSubmit();
          });
        });
    </script>

}
