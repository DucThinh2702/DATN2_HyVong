@model DATN1API.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<div class="content-header">
    <h1 class="mb-4">Thêm sản phẩm mới</h1>

    <form asp-action="Create" enctype="multipart/form-data" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <!-- Tên sản phẩm -->
        <div class="mb-3">
            <label for="ProductName" class="form-label fw-bold">Tên sản phẩm</label>
            <input asp-for="ProductName" class="form-control" placeholder="Nhập tên sản phẩm" />
            <span asp-validation-for="ProductName" class="text-danger"></span>
        </div>

        <!-- Mô tả -->
        <div class="mb-3">
            <label for="Description" class="form-label fw-bold">Mô tả sản phẩm</label>
            <textarea asp-for="Description" class="form-control" id="Description"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <!-- Giá bán & Giá gốc -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="SalePrice" class="form-label fw-bold">Giá bán</label>
                <input asp-for="SalePrice" class="form-control" placeholder="Nhập giá bán" />
                <span asp-validation-for="SalePrice" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label for="OriginalPrice" class="form-label fw-bold">Giá gốc</label>
                <input asp-for="OriginalPrice" class="form-control" placeholder="Nhập giá gốc" />
                <span asp-validation-for="OriginalPrice" class="text-danger"></span>
            </div>
        </div>

        <!-- Danh mục & Trạng thái -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Danh mục</label>
                @Html.DropDownListFor(model => model.CategoryId,
                         (SelectList)ViewBag.Categories,
                         "-- Chọn danh mục --", new { @class = "form-select" })
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label for="Status" class="form-label fw-bold">Trạng thái</label>
                <input asp-for="Status" class="form-control" value="Đang bán" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>

        <!-- Chất liệu & Ảnh chính -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="Material" class="form-label fw-bold">Chất liệu</label>
                <input asp-for="Material" class="form-control" placeholder="Nhập chất liệu" />
                <span asp-validation-for="Material" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label for="ImageFile" class="form-label fw-bold">Ảnh sản phẩm</label>
                <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                <span class="text-danger" data-valmsg-for="ImageFile" data-valmsg-replace="true"></span>
            </div>
        </div>

        <!-- Màu sắc và kích cỡ -->
        <div class="row">
            <!-- Chọn màu -->
            <div class="col-md-6 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-bold mb-0">Chọn màu:</label>
                    <a asp-controller="Colors" asp-action="Create" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle"></i> Thêm màu
                    </a>
                </div>
                <div class="checkbox-grid">
                    @foreach (DATN1WEB.Models.Color color in ViewBag.Colors)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input color-checkbox" value="@color.ColorId" />
                            <label class="form-check-label">@color.ColorName</label>
                        </div>
                    }
                </div>
            </div>

            <!-- Chọn size -->
            <div class="col-md-6 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-bold mb-0">Chọn kích cỡ:</label>
                    <a asp-controller="Sizes" asp-action="Create" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle"></i> Thêm kích cỡ
                    </a>
                </div>
                <div class="checkbox-grid">
                    @foreach (DATN1WEB.Models.Size size in ViewBag.Sizes)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input size-checkbox" value="@size.SizeId" />
                            <label class="form-check-label">@size.SizeName</label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Bảng biến thể -->
        <div class="mt-4">
            <h4>Biến thể sản phẩm</h4>
            <table class="table table-bordered" id="variantTable">
                <thead>
                    <tr>
                        <th>Kích cỡ</th>
                        <th>Màu</th>
                        <th>Số lượng</th>
                        <th>Giá bán</th>
                        <th>Giá gốc</th>
                        <th>Trạng thái</th>
                        <th>Ảnh đại diện</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save2 me-2"></i> Lưu sản phẩm
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle me-2"></i> Quay lại
        </a>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(function () {
            $('#Description').summernote({ height: 200 });

            function generateVariants() {
                const selectedColors = $('.color-checkbox:checked');
                const selectedSizes = $('.size-checkbox:checked');
                const tbody = $('#variantTable tbody');
                tbody.empty();

                if (selectedColors.length === 0 || selectedSizes.length === 0) return;

                let index = 0;
                selectedSizes.each(function () {
                    const sizeId = parseInt($(this).val());
                    const sizeName = $(this).closest('.form-check').find('label').text().trim();

                    selectedColors.each(function () {
                        const colorId = parseInt($(this).val());
                        const colorName = $(this).closest('.form-check').find('label').text().trim();

                        if (!colorId || !sizeId) {
                            console.warn(`Bỏ qua biến thể: ColorId=${colorId}, SizeId=${sizeId}`);
                            return;
                        }

                        tbody.append(`
                            <tr>
                                <td>${sizeName}
                                    <input type="hidden" name="ProductVariants[${index}].SizeId" value="${sizeId}" />
                                </td>
                                <td>${colorName}
                                    <input type="hidden" name="ProductVariants[${index}].ColorId" value="${colorId}" />
                                </td>
                                <td><input type="number" name="ProductVariants[${index}].Stock" class="form-control" min="0" value="0" required /></td>
                                <td><input type="number" name="ProductVariants[${index}].SalePrice" class="form-control" min="0" value="0" required /></td>
                                <td><input type="number" name="ProductVariants[${index}].OriginalPrice" class="form-control" min="0" value="0" required /></td>
                                <td>
                                    <select name="ProductVariants[${index}].Status" class="form-select">
                                        <option value="Active" selected>Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                </td>
                                <td><input type="file" name="ProductVariants[${index}].ImageFile" class="form-control" accept="image/*" /></td>
                            </tr>`);
                        index++;
                    });
                });
            }

            $(document).on('change', '.color-checkbox, .size-checkbox', generateVariants);

            $('form').on('submit', function (e) {
                const rows = $('#variantTable tbody tr');
                if (rows.length === 0) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Chưa chọn biến thể',
                        text: 'Vui lòng chọn ít nhất một màu và một kích cỡ.',
                        confirmButtonText: 'OK'
                    });
                    return;
                }
            });
        });
    </script>
}
