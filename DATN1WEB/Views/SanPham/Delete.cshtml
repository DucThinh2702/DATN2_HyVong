@model DATN1API.Models.Product

@{
    ViewData["Title"] = "Xoá sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Map trạng thái sang tiếng Việt
    var statusRaw = (Model?.Status ?? "").Trim();
    string statusVi = string.IsNullOrWhiteSpace(statusRaw) ? "Không xác định" :
        statusRaw.ToLower() switch
        {
            "active" => "Đang bán",
            "inactive" => "Ngừng bán",
            "outofstock" => "Hết hàng",
            "comingsoon" => "Sắp bán",
            _ => statusRaw // giữ nguyên nếu là custom khác
        };
}

<div class="content-header">
    <h2 class="mb-4 text-danger">
        <i class="fas fa-trash-alt me-2"></i>Xác nhận xoá sản phẩm
    </h2>

    <div class="card border-danger mb-4">
        <div class="card-body">
            <h4 class="card-title text-dark">@Model?.ProductName</h4>
            <p class="text-muted">Bạn có chắc chắn muốn xoá sản phẩm này?</p>

            <dl class="row">
                <dt class="col-sm-3">Danh mục</dt>
                <dd class="col-sm-9">@Model?.Category?.CategoryName</dd>

                <!-- ĐÃ BỎ: Giá bán -->

                <dt class="col-sm-3">Chất liệu</dt>
                <dd class="col-sm-9">@Model?.Material</dd>

                <dt class="col-sm-3">Trạng thái</dt>
                <dd class="col-sm-9">@statusVi</dd>
            </dl>

            <div class="text-center mt-4 d-flex gap-2 justify-content-center">
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" asp-for="ProductId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i> Xoá
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Hủy
                </a>
            </div>
        </div>
    </div>
</div>
