@model DATN1API.Models.Product

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.css" rel="stylesheet">

<style>
    .content-header h1 { margin-bottom: 1rem; }
    .form-label .text-danger { font-weight: 700; }
    .is-invalid + .invalid-feedback { display:block; }
    .thumb-box {
        width: 140px; height: 140px; border: 1px solid #e9ecef; border-radius: .5rem;
        display:flex; align-items:center; justify-content:center; overflow:hidden; background:#fafafa;
    }
    .thumb-box img { width:100%; height:100%; object-fit:cover; }
</style>

<div class="content-header">
    <h1 class="mb-2">Chỉnh sửa sản phẩm</h1>
    <p class="text-muted">Cập nhật thông tin, giá, danh mục và trạng thái hiển thị.</p>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" enctype="multipart/form-data" method="post" id="productEditForm" novalidate>
            <input type="hidden" asp-for="ProductId" />

            <!-- Tên sản phẩm -->
            <div class="mb-3">
                <label for="ProductName" class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                <input asp-for="ProductName" class="form-control" placeholder="Nhập tên sản phẩm (≥ 10 ký tự)" />
                <div class="invalid-feedback">Vui lòng nhập tên sản phẩm (ít nhất 10 ký tự).</div>
            </div>

            <!-- Mô tả -->
            <div class="mb-3">
                <label for="Description" class="form-label fw-bold">Mô tả sản phẩm <span class="text-danger">*</span></label>
                <textarea asp-for="Description" id="Description" class="form-control"></textarea>
                <div class="invalid-feedback">Vui lòng nhập mô tả (ít nhất 10 ký tự).</div>
            </div>

            <!-- Giá bán & Giá gốc -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="SalePrice" class="form-label fw-bold">Giá bán <span class="text-danger">*</span></label>
                    <input asp-for="SalePrice" class="form-control" inputmode="decimal" placeholder="Nhập giá bán" />
                    <div class="invalid-feedback">Giá bán phải là số &gt; 0.</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="OriginalPrice" class="form-label fw-bold">Giá gốc <span class="text-danger">*</span></label>
                    <input asp-for="OriginalPrice" class="form-control" inputmode="decimal" placeholder="Nhập giá gốc (≥ Giá bán)" />
                    <div class="invalid-feedback">Giá gốc phải là số &gt; 0 và ≥ Giá bán.</div>
                </div>
            </div>

            <!-- Danh mục & Trạng thái -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="CategoryId" class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.CategoryId, (SelectList)ViewBag.Categories, "-- Chọn danh mục --",
                        new { @class = "form-select", @id = "CategoryId" })
                    <div class="invalid-feedback">Vui lòng chọn danh mục.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="Status" class="form-label fw-bold">Trạng thái <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.Status,
                             new List<SelectListItem> {
                    new SelectListItem { Value = "Active",   Text = "Đang bán"  },
                    new SelectListItem { Value = "Inactive", Text = "Ngừng bán" }
                    },
                             "-- Chọn trạng thái --",
                             new { @class = "form-select", id = "Status" }
                             )
                    <div class="invalid-feedback">Vui lòng chọn trạng thái.</div>
                </div>

            </div>

            <!-- Chất liệu -->
            <div class="mb-3">
                <label for="Material" class="form-label fw-bold">Chất liệu <span class="text-danger">*</span></label>
                <input asp-for="Material" class="form-control" placeholder="Nhập chất liệu (≥ 3 ký tự)" />
                <div class="invalid-feedback">Vui lòng nhập chất liệu (ít nhất 3 ký tự).</div>
            </div>

            <!-- Ảnh hiện tại & Ảnh mới -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Ảnh hiện tại</label>
                    <div class="thumb-box">
                        @if (!string.IsNullOrEmpty(Model?.ThumbnailImage))
                        {
                            <img src="~/hinh/@System.IO.Path.GetFileName(Model.ThumbnailImage)" alt="Thumbnail" />
                        }
                        else
                        {
                            <span class="text-muted">Chưa có ảnh</span>
                        }
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="ImageFile" class="form-label fw-bold">Chọn ảnh mới (không bắt buộc)</label>
                    <input type="file" name="ImageFile" id="ImageFile" class="form-control" accept="image/*" />
                    <div class="form-text">Hỗ trợ JPEG/PNG/WebP, tối đa 2MB.</div>
                    <div class="invalid-feedback">Ảnh không hợp lệ hoặc quá 2MB.</div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Lưu thay đổi
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Quay lại danh sách
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/localization/messages_vi.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(function () {
            // ===== SUMMERNOTE =====
            $('#Description').summernote({
                height: 200,
                callbacks: {
                    onChange: function (contents) {
                        // đồng bộ plain text vào textarea gốc để jQuery Validate đọc
                        $('#Description').val($('<div>').html(contents).text().trim()).trigger('keyup');
                    }
                },
                toolbar: [
                    ['style', ['bold', 'italic', 'underline', 'clear']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['insert', ['link']],
                    ['view', ['fullscreen', 'codeview']]
                ]
            });

            // ===== CUSTOM RULES =====
            $.validator.addMethod('onlyNumber', function (v) {
                return $.isNumeric(v) || v === '';
            }, 'Vui lòng nhập số (không nhập ký tự)');

            $.validator.addMethod('gt0', function (v) {
                return parseFloat(v) > 0;
            }, 'Vui lòng nhập số lớn hơn 0');

            $.validator.addMethod('geTo', function (v, el, sel) {
                const other = parseFloat($(sel).val());
                const cur = parseFloat(v);
                if (isNaN(other) || isNaN(cur)) return true;
                return cur >= other;
            }, 'Phải ≥ trường tham chiếu');

            $.validator.addMethod('fileSize', function (v, el, bytes) {
                if (!el.files || !el.files.length) return true; // ảnh không bắt buộc ở Edit
                return el.files[0].size <= bytes;
            }, 'Tệp quá lớn');

            $.validator.addMethod('imageType', function (v, el) {
                if (!el.files || !el.files.length) return true;
                return ['image/jpeg', 'image/png', 'image/webp'].includes(el.files[0].type);
            }, 'Định dạng ảnh không hợp lệ');

            const $form = $('#productEditForm');

            // ===== VALIDATE =====
            $form.validate({
                ignore: [], // rất quan trọng để validate cả textarea có summernote
                onkeyup: function (el) { $(el).valid(); },
                onfocusout: function (el) { $(el).valid(); },
                errorElement: 'div',
                errorClass: 'invalid-feedback',
                highlight: function (el) { $(el).addClass('is-invalid'); },
                unhighlight: function (el) { $(el).removeClass('is-invalid'); },
                errorPlacement: function (err, el) {
                    // nếu là input trong table -> hiện lỗi trong ô
                    if ($(el).closest('td').length) {
                        err.appendTo($(el).closest('td'));
                    } else if ($(el).hasClass('form-select')) {
                        // select bootstrap
                        err.insertAfter($(el));
                    } else if ($(el).attr('name') === 'Description') {
                        // summernote -> đặt sau editor
                        err.insertAfter($('#Description').next('.note-editor'));
                    } else {
                        err.insertAfter($(el));
                    }
                },
                rules: {
                    ProductName:   { required: true, minlength: 10 },
                    Description:   { required: true, minlength: 10 },
                    SalePrice:     { required: true, onlyNumber: true, gt0: true },
                    OriginalPrice: { required: true, onlyNumber: true, gt0: true, geTo: '#SalePrice' },
                    CategoryId:    { required: true },
                    Status:        { required: true }, // không cần minlength
                    Material:      { required: true, minlength: 3 },
                    ImageFile:     { imageType: true, fileSize: 2 * 1024 * 1024 } // KHÔNG required ở Edit
                },
                messages: {
                    ProductName:   { required: 'Vui lòng nhập tên sản phẩm', minlength: 'Ít nhất 10 ký tự' },
                    Description:   { required: 'Vui lòng nhập mô tả', minlength: 'Ít nhất 10 ký tự' },
                    SalePrice:     { required: 'Vui lòng nhập giá bán' },
                    OriginalPrice: { required: 'Vui lòng nhập giá gốc', geTo: 'Giá gốc phải ≥ Giá bán' },
                    CategoryId:    { required: 'Vui lòng chọn danh mục' },
                    Status:        { required: 'Vui lòng chọn trạng thái' },
                    Material:      { required: 'Vui lòng nhập chất liệu', minlength: 'Ít nhất 3 ký tự' },
                    ImageFile:     { imageType: 'Chỉ JPEG/PNG/WebP', fileSize: 'Tối đa 2MB' }
                }
            });

            // ===== CẢNH BÁO CHƯA THAY ĐỔI GÌ =====
            const syncDesc = () => {
                const contents = $('#Description').summernote('code');
                $('#Description').val($('<div>').html(contents).text().trim());
            };
            const snapshot = () => {
                syncDesc();
                return $form.serialize();
            };
            let initialSnapshot = snapshot();

            $form.on('submit', function (e) {
                syncDesc();

                if (!$form.valid()) return; // để validate xử lý

                const current = snapshot();
                if (current === initialSnapshot) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Bạn chưa thay đổi gì',
                        text: 'Vui lòng chỉnh sửa thông tin trước khi lưu.',
                        confirmButtonText: 'OK'
                    });
                }
            });
        });
    </script>
}
