@using DATN1API.Models
@{
    var title = ViewData["Title"] as string ?? "The Bag Studio";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link rel="icon" href="/img/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    @RenderSection("Styles", required: false)
    <style>
        .topbar-link {
            color: #6c757d;
            text-decoration: none;
            font-size: 13px
        }

            .topbar-link:hover {
                color: #ffc107
            }

        .brand-split span {
            font-weight: 700;
            display: inline-block;
            line-height: 1
        }

        .brand-left {
            background: #343a40;
            color: #ffc107
        }

        .brand-right {
            background: #ffc107;
            color: #1a1d29
        }

        .btn-square {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center
        }

        .back-to-top {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 999
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row" style="background:#f8f9fa; padding:5px 40px;">
            <div class="col-lg-6 d-none d-lg-block">
                <div class="d-inline-flex align-items-center h-100">
                    <a href="#" class="topbar-link me-3">Liên hệ</a>
                    <a href="#" class="topbar-link">Giúp đỡ</a>
                </div>
            </div>
            <div class="col-lg-6 d-flex justify-content-end align-items-center">
                <div class="dropdown me-2">
                    <button class="btn btn-sm dropdown-toggle border" type="button" data-toggle="dropdown" data-bs-toggle="dropdown">
                        @(User?.Identity?.IsAuthenticated == true ? (User.Identity!.Name ?? "Tài khoản") : "Tài khoản")
                    </button>
                    <div class="dropdown-menu dropdown-menu-right">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <a class="dropdown-item" href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                        }
                        else
                        {
                            <a class="dropdown-item" href="@Url.Action("Login", "Account")">Đăng nhập</a>
                            <a class="dropdown-item" href="@Url.Action("Register", "Account")">Đăng ký</a>
                        }
                    </div>
                </div>
                <div class="dropdown">
                    <button class="btn btn-sm dropdown-toggle border" type="button" data-toggle="dropdown" data-bs-toggle="dropdown">
                        Ngôn ngữ
                    </button>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a class="dropdown-item" href="#">Tiếng Việt</a>
                        <a class="dropdown-item" href="#">Tiếng Anh</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid border-bottom">
            <div class="d-flex align-items-center justify-content-between px-4 py-3">
                <a href="@Url.Content("~/")" class="text-decoration-none d-flex align-items-center brand-split">
                    <span class="fw-bold fs-2 px-2 brand-left">THE BAG</span>
                    <span class="fw-bold fs-2 px-2 brand-right">STUDIO</span>
                </a>
                <div class="flex-grow-1 d-flex justify-content-center px-3">
                    <form method="get" asp-action="Index" style="width: 100%; max-width: 500px;">
                        <div class="input-group">
                            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm kiếm nhanh" />
                            <button class="btn border border-warning text-warning" type="submit">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </form>
                </div>
                <div class="text-end">
                    <small class="text-muted">Chăm sóc khách hàng</small>
                    <h5 class="fw-bold m-0">012 345 6789</h5>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid bg-dark mb-30">
        <div class="row px-xl-5 align-items-center" style="min-height: 55px;">
            <div class="col-lg-auto d-none d-lg-block">
                <div style="width: 220px;">
                    <a class="btn d-flex align-items-center justify-content-between w-100"
                       data-bs-toggle="collapse" href="#navbar-vertical"
                       style="height:100%; padding:0 10px 0 30px; background:#ffc107; border-radius:0; margin-left:-10px;">
                        <h6 class="m-0 text-dark d-flex align-items-center">
                            <i class="fa fa-bars mr-2"></i>Thể loại
                        </h6>
                        <i class="fa fa-angle-down text-dark"></i>
                    </a>
                    <nav class="collapse position-absolute bg-white border shadow-sm"
                         id="navbar-vertical" style="width:220px; z-index:999;">
                        <div class="navbar-nav w-100">
                            <div class="dropdown dropend">
                                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Sản phẩm</a>
                                <ul class="dropdown-menu rounded border-0 shadow">
                                    @if (ViewBag.Categories is List<DATN1API.Models.Category> categories && categories != null)
                                    {
                                        foreach (var cat in categories)
                                        {
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-controller="User"
                                                   asp-action="Index"
                                                   asp-route-categoryId="@cat.CategoryId"
                                                   asp-fragment="recentProducts">
                                                    @cat.CategoryName
                                                </a>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li><span class="dropdown-item disabled">Chưa có danh mục</span></li>
                                    }
                                </ul>
                            </div>
                            <a asp-controller="Products" asp-action="Index" class="nav-item nav-link">Balo</a>
                            <a asp-controller="Products" asp-action="Index" class="nav-item nav-link">Phụ kiện khác</a>
                        </div>
                    </nav>
                </div>
            </div>

            <div class="col-lg">
                <nav class="navbar navbar-expand-lg bg-dark navbar-dark py-0 px-0">
                    <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
                        <div class="navbar-nav mr-auto py-0">
                            <a href="@Url.Action("Index","User")" class="nav-item nav-link">Trang chủ</a>
                            <a href="@Url.Action("Shop","Products")" class="nav-item nav-link">Khuyến mãi</a>
                            <a href="@Url.Action("Collection","Products")" class="nav-item nav-link">Bộ sưu tập</a>
                            <div class="nav-item dropdown">
                                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Trang</a>
                                <div class="dropdown-menu bg-primary rounded-0 border-0 m-0">
                                    <a href="@Url.Action("Cart","Orders")" class="dropdown-item">Giỏ hàng</a>
                                    <a href="@Url.Action("Checkout","Orders")" class="dropdown-item">Thanh toán</a>
                                </div>
                            </div>
                            <a href="@Url.Action("Contact","Home")" class="nav-item nav-link">Tin tức</a>
                        </div>
                        <div class="navbar-nav ml-auto py-0 d-none d-lg-flex align-items-center">
                            <a href="@Url.Action("Wishlist","Account")" class="btn px-0">
                                <i class="fas fa-heart text-warning"></i>
                                <span class="badge text-secondary border border-secondary rounded-circle" style="padding-bottom:2px;">0</span>
                            </a>
                            <a href="@Url.Action("GioHang","User")" class="btn px-0 ms-3">
                                <i class="fas fa-shopping-cart text-warning"></i>
                                <span class="badge text-secondary border border-secondary rounded-circle" style="padding-bottom:2px;">0</span>
                            </a>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </div>

    @RenderBody()

    <div class="container-fluid bg-dark text-secondary mt-5 pt-5">
        <div class="row px-xl-5 pt-5">
            <div class="col-lg-4 col-md-12 mb-5 pr-3 pr-xl-5">
                <h5 class="text-secondary text-uppercase mb-4">Liên lạc</h5>
                <p class="mb-4">Hãy liên lạc với chúng tôi nếu bạn đang thắc mắc hoặc muốn chúng tôi tư vấn sản phẩm phù hợp với bạn.</p>
                <p class="mb-2"><i class="fa fa-map-marker-alt text-primary mr-3"></i>123 Ngô Quyền, P. Thường Thạnh, Q. Cái Răng, TP. Cần Thơ</p>
                <p class="mb-2"><i class="fa fa-envelope text-primary mr-3"></i> nhomhyvongdatn@gmail.com</p>
                <p class="mb-0"><i class="fa fa-phone-alt text-primary mr-3"></i>0395929015</p>
            </div>
            <div class="col-lg-8 col-md-12">
                <div class="row">
                    <div class="col-md-4 mb-5">
                        <h5 class="text-secondary text-uppercase mb-4">Cửa hàng nhanh</h5>
                        <div class="d-flex flex-column justify-content-start">
                            <a class="text-secondary mb-2" href="#"><i class="fa fa-angle-right mr-2"></i>Trang chủ</a>
                            <a class="text-secondary mb-2" href="#"><i class="fa fa-angle-right mr-2"></i>Cửa hàng chúng tôi</a>
                            <a class="text-secondary mb-2" href="#"><i class="fa fa-angle-right mr-2"></i>Chi tiết cửa hàng</a>
                            <a class="text-secondary mb-2" href="#"><i class="fa fa-angle-right mr-2"></i>Giỏ hàng</a>
                            <a class="text-secondary mb-2" href="#"><i class="fa fa-angle-right mr-2"></i>Thanh toán</a>
                        </div>
                    </div>
                    <div class="col-md-4 mb-5">
                        <h5 class="text-secondary text-uppercase mb-4">Tài khoản của tôi</h5>
                        <div class="d-flex flex-column justify-content-start">
                            <a class="text-secondary mb-2" href="#"><i class="fa fa-angle-right mr-2"></i>Trang chủ</a>
                            <a class="text-secondary mb-2" href="#"><i class="fa fa-angle-right mr-2"></i>Cửa hàng chúng tôi</a>
                            <a class="text-secondary mb-2" href="#"><i class="fa fa-angle-right mr-2"></i>Chi tiết cửa hàng</a>
                            <a class="text-secondary mb-2" href="#"><i class="fa fa-angle-right mr-2"></i>Giỏ hàng </a>
                            <a class="text-secondary mb-2" href="#"><i class="fa fa-angle-right mr-2"></i>Thanh toán</a>
                        </div>
                    </div>
                    <div class="col-md-4 mb-5">
                        <h5 class="text-secondary text-uppercase mb-4">Bản tin</h5>
                        <p>Hãy tìm hiểu về chúng tôi</p>
                        <form action="">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Địa chỉ email của bạn" />
                                <div class="input-group-append">
                                    <button class="btn btn-primary">Đăng ký</button>
                                </div>
                            </div>
                        </form>
                        <h6 class="text-secondary text-uppercase mt-4 mb-3">Theo dõi chúng tôi</h6>
                        <div class="d-flex">
                            <a class="btn btn-primary btn-square mr-2" href="#"><i class="fab fa-twitter"></i></a>
                            <a class="btn btn-primary btn-square mr-2" href="#"><i class="fab fa-facebook-f"></i></a>
                            <a class="btn btn-primary btn-square mr-2" href="#"><i class="fab fa-linkedin-in"></i></a>
                            <a class="btn btn-primary btn-square" href="#"><i class="fab fa-instagram"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a href="#" class="btn btn-primary back-to-top"><i class="fa fa-angle-double-up"></i></a>

    @RenderSection("Scripts", required: false)
</body>
</html>
