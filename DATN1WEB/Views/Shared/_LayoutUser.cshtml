            style="width:56px; height:56px; z-index:1080; transition:transform .15s ease;"
            data-bs-toggle="tooltip" data-bs-placement="left" title="Lên đầu trang"
            aria-label="Lên đầu trang"
            onmouseenter="this.style.transform='scale(1.06)'"
            onmouseleave="this.style.transform='scale(1)'">
