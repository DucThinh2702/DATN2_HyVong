<!-- Toast container (đặt trong <body>) -->
<div id="toastArea" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:20000"></div>

<script>
    // Hàm hiển thị toast Bootstrap 5
    window.showToast = function (message, type = 'info', delay = 3500) {
      const kinds = { success:'success', danger:'danger', warning:'warning', info:'info' };
      const cls = kinds[type] || 'info';

      const wrap = document.getElementById('toastArea');
      const el = document.createElement('div');
      el.className = 'toast align-items-center text-bg-' + cls + ' border-0';
      el.setAttribute('role', 'alert');
      el.setAttribute('aria-live', 'assertive');
      el.setAttribute('aria-atomic', 'true');
      el.innerHTML = `
        <div class="d-flex">
          <div class="toast-body">${message}</div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto"
                  data-bs-dismiss="toast" aria-label="Close"></button>
        </div>`;

      wrap.appendChild(el);
      new bootstrap.Toast(el, { delay }).show();
    };

    // Ghi đè alert mặc định của trình duyệt ⇒ dùng toast
    (function () {
      const nativeAlert = window.alert;
      window.alert = function (msg) {
        try { showToast(String(msg), 'info'); }
        catch { nativeAlert(msg); } // fallback nếu Bootstrap chưa sẵn sàng
      };
    })();
</script>
