<script>
    let selectedColor = null;
    let selectedSize = null;
    const variants = @Html.Raw(variantsJson);

    document.querySelectorAll('.btn-color').forEach(btn => {
        btn.onclick = () => {
            document.querySelectorAll('.btn-color').forEach(x => x.classList.remove('active'));
            btn.classList.add('active');
            selectedColor = btn.dataset.color;
            setVariant();
        };
    });

    document.querySelectorAll('.btn-size').forEach(btn => {
        btn.onclick = () => {
            document.querySelectorAll('.btn-size').forEach(x => x.classList.remove('active'));
            btn.classList.add('active');
            selectedSize = btn.dataset.size;
            setVariant();
        };
    });

    function setVariant() {
        if (selectedColor && selectedSize) {
            const variant = variants.find(v => v.ColorId == selectedColor && v.SizeId == selectedSize);
            if (variant) {
                document.getElementById('selectedVariant').value = variant.VariantId;
                if (variant.ThumbnailImage) {
                    document.getElementById('variantImage').src = variant.ThumbnailImage;
                }
                if (variant.SalePrice) {
                    document.getElementById('price').innerText =
                        parseInt(variant.SalePrice).toLocaleString('vi-VN') + ' VNĐ';
                }
            }
        }
    }

    document.querySelector('.btn-plus').onclick = () => {
        const input = document.getElementById('quantity');
        input.value = parseInt(input.value) + 1;
        document.getElementById('formQuantity').value = input.value;
    };
    document.querySelector('.btn-minus').onclick = () => {
        const input = document.getElementById('quantity');
        if (parseInt(input.value) > 1) {
            input.value = parseInt(input.value) - 1;
            document.getElementById('formQuantity').value = input.value;
        }
    };
</script>
