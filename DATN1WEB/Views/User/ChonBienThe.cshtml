<div class="container py-5">
    <div class="row align-items-start">
        <!-- Ảnh biến thể -->
        <div class="col-md-6 text-center mb-4 mb-md-0">
            <img id="variantImage" src="@Url.Content(Model.ThumbnailImage)"
                 class="img-fluid rounded shadow-sm border"
                 style="max-height:400px;" alt="@Model.ProductName" />
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="col-md-6">
            <h2 class="fw-bold mb-3">@Model.ProductName</h2>
            <p class="text-muted">@Html.Raw(Model.Description)</p>
            <h4 id="price" class="text-danger fw-bold mb-4">
                @String.Format("{0:N0}", Model.SalePrice ?? 0) VNĐ
            </h4>

            <!-- Màu sắc -->
            <div class="mb-3">
                <label class="fw-bold d-block mb-1">Màu sắc</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var color in colors)
                    {
                        <button type="button" class="btn btn-outline-dark btn-color" data-color="@color.ColorId">
                            @color.ColorName
                        </button>
                    }
                </div>
            </div>

            <!-- Size -->
            <div class="mb-3">
                <label class="fw-bold d-block mb-1">Size</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var size in sizes)
                    {
                        <button type="button" class="btn btn-outline-dark btn-size" data-size="@size.SizeId">
                            @size.SizeName
                        </button>
                    }
                </div>
            </div>

            <!-- Số lượng -->
            <div class="mb-3">
                <label class="fw-bold d-block mb-1">Số lượng</label>
                <div class="input-group" style="width: 140px;">
                    <button class="btn btn-outline-secondary btn-minus" type="button">-</button>
                    <input type="number" class="form-control text-center" value="1" min="1" id="quantity" />
                    <button class="btn btn-outline-secondary btn-plus" type="button">+</button>
                </div>
            </div>

            <!-- Nút -->
            <div class="d-flex gap-2 mt-4">
                <form asp-action="MuaNgay" method="post">
                    <input type="hidden" name="variantId" id="selectedVariant" />
                    <input type="hidden" name="quantity" id="formQuantity" value="1" />
                    <button type="submit" class="btn btn-dark px-4">Mua ngay</button>
                </form>

                <form asp-action="ThemVaoGio" method="post">
                    <input type="hidden" name="variantId" id="selectedVariant" />
                    <input type="hidden" name="quantity" value="1" id="formQuantity" />
                    <button type="submit" class="btn btn-outline-dark px-4">Thêm vào giỏ hàng</button>
                </form>
            </div>
        </div>
    </div>
</div>



