@{
    ViewData["Title"] = "Giỏ hàng";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}
@model DATN1API.Models.Cart

<div class="container-fluid">
    <div class="row px-xl-5">
        <!-- Danh sách sản phẩm trong giỏ -->
        <div class="col-lg-8 table-responsive mb-5">
            <table class="table table-light table-borderless table-hover text-center mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th>Chọn</th>
                        <th>Tên sản phẩm</th>
                        <th>Màu sắc</th>
                        <th>Size</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Tổng cộng</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody class="align-middle" id="cartTable">
                    @foreach (var item in Model.CartDetails)
                    {
                        <tr data-id="@item.CartDetailId"
                            data-variant="@item.ProductVariantId"
                            data-name="@item.ProductVariant?.Product?.ProductName"
                            data-color="@item.ProductVariant?.Color?.ColorName"
                            data-size="@item.ProductVariant?.Size?.SizeName"
                            data-price="@item.ProductVariant?.SalePrice ?? 0"
                            data-quantity="@item.Quantity ?? 0">

                            <td><input type="checkbox" class="selectItem"></td>
                            <td>@item.ProductVariant?.Product?.ProductName</td>
                            <td>@item.ProductVariant?.Color?.ColorName</td>
                            <td>@item.ProductVariant?.Size?.SizeName</td>
                            <td>@string.Format("{0:N0} VNĐ", item.ProductVariant?.SalePrice)</td>
                            <td>@item.Quantity</td>
                            <td>@string.Format("{0:N0} VNĐ", (item.Quantity ?? 0) * (item.ProductVariant?.SalePrice ?? 0))</td>
                            <td>
                                <form asp-action="XoaKhoiGio" asp-controller="User" method="post" style="display:inline;">
                                    <input type="hidden" name="cartDetailId" value="@item.CartDetailId" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fa fa-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Chi tiết các sản phẩm đã chọn -->
        <div class="col-lg-4">
            <h5 class="section-title position-relative text-uppercase mb-3">
                <span class="bg-secondary pr-3">Chi tiết giỏ hàng</span>
            </h5>
            <div class="bg-light p-30 mb-5" id="cartDetailPanel">

                <!-- Combobox chọn sản phẩm -->
                <div class="mb-3">
                    <label class="small text-muted mb-1">Sản phẩm đã chọn</label>
                    <select id="selectedItemsSelect" class="form-control" disabled></select>
                </div>

                <!-- Hiển thị chi tiết sản phẩm được chọn -->
                <div id="selectedItemDetail" class="border rounded p-2 bg-white small">
                    <em>Chưa chọn sản phẩm nào</em>
                </div>

                <div class="border-bottom pb-2 mt-3">
                    <div class="d-flex justify-content-between mb-3">
                        <h6>Tổng cộng</h6>
                        <h6 id="tongCong">0 VNĐ</h6>
                    </div>
                </div>
                <div class="pt-2">
                    <div class="d-flex justify-content-between mt-2">
                        <h5>Tổng tiền</h5>
                        <h5 id="tongTien">0 VNĐ</h5>
                    </div>
                    <button id="btnCheckout"
                            class="btn btn-block btn-primary font-weight-bold my-3 py-3">
                        Tiếp theo
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedItemsData = [];

        document.addEventListener("DOMContentLoaded", function () {
            const selectEl = document.getElementById("selectedItemsSelect");
            const detailEl = document.getElementById("selectedItemDetail");
            const tongCong = document.getElementById("tongCong");
            const tongTien = document.getElementById("tongTien");

            function renderSelectedItemDetail(index) {
                if (index == null || selectedItemsData.length === 0) {
                    detailEl.innerHTML = '<em>Chưa chọn sản phẩm nào</em>';
                    return;
                }
                const it = selectedItemsData[index];
                detailEl.innerHTML = `
                    <div class="border-bottom mb-2 pb-2">
                        <h6 class="mb-1">${it.name}</h6>
                        <div>Màu sắc: <strong>${it.color}</strong></div>
                        <div>Size: <strong>${it.size}</strong></div>
                        <div>Số lượng: <strong>${it.quantity}</strong></div>
                        <div>Giá: ${it.price.toLocaleString("vi-VN")} VNĐ</div>
                        <div>Tổng: <strong>${it.total.toLocaleString("vi-VN")} VNĐ</strong></div>
                    </div>`;
            }

            function updateSelectedItems() {
                const rows = document.querySelectorAll("#cartTable tr");
                selectedItemsData = [];
                selectEl.innerHTML = "";
                let total = 0;

                rows.forEach(row => {
                    const checkbox = row.querySelector(".selectItem");
                    if (checkbox && checkbox.checked) {
                        const name = row.dataset.name;
                        const color = row.dataset.color;
                        const size = row.dataset.size;
                        const price = parseInt(row.dataset.price);
                        const quantity = parseInt(row.dataset.quantity);
                        const itemTotal = price * quantity;
                        const ProductVariantId = parseInt(row.dataset.variant);

                        total += itemTotal;

                        selectedItemsData.push({ name, color, size, price, quantity, total: itemTotal, ProductVariantId });

                        const text = `${name} (${quantity} x ${price.toLocaleString("vi-VN")} VNĐ)`;
                        const opt = new Option(text, selectedItemsData.length - 1);
                        selectEl.add(opt);
                    }
                });

                tongCong.textContent = total.toLocaleString("vi-VN") + " VNĐ";
                tongTien.textContent = total.toLocaleString("vi-VN") + " VNĐ";

                if (selectedItemsData.length > 0) {
                    selectEl.disabled = false;
                    selectEl.selectedIndex = 0;
                    renderSelectedItemDetail(0);
                } else {
                    selectEl.disabled = true;
                    detailEl.innerHTML = '<em>Chưa chọn sản phẩm nào</em>';
                }
            }

            selectEl.addEventListener("change", function () {
                const idx = parseInt(this.value);
                renderSelectedItemDetail(idx);
            });

            document.querySelectorAll(".selectItem").forEach(checkbox => {
                checkbox.addEventListener("change", updateSelectedItems);
            });

            document.getElementById("btnCheckout").addEventListener("click", function () {
                if (selectedItemsData.length === 0) {
                    alert("Vui lòng chọn ít nhất 1 sản phẩm để tiếp tục.");
                    return;
                }
                localStorage.setItem("selectedCartItems", JSON.stringify(selectedItemsData));
                window.location.href = "@Url.Action("ThanhToan", "User")";
            });
        });
    </script>
}
