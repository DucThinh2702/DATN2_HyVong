<script>
    document.addEventListener("DOMContentLoaded", function () {
        const selectedItemsContainer = document.getElementById("selectedItems");
        const tongCong = document.getElementById("tongCong");
        const tongTien = document.getElementById("tongTien");

        function updateSelectedItems() {
            const rows = document.querySelectorAll("#cartTable tr");
            selectedItemsContainer.innerHTML = "";
            let total = 0;

            rows.forEach(row => {
                const checkbox = row.querySelector(".selectItem");
                if (checkbox.checked) {
                    const name = row.dataset.name;
                    const color = row.dataset.color;
                    const size = row.dataset.size;
                    const price = parseInt(row.dataset.price);
                    const quantity = parseInt(row.dataset.quantity);
                    const itemTotal = price * quantity;

                    total += itemTotal;

                    const itemHTML = `
                        <div class="border-bottom mb-2 pb-2">
                            <h6>${name}</h6>
                            <p>Màu sắc: ${color}</p>
                            <p>Size: ${size}</p>
                            <p>Số lượng: ${quantity}</p>
                            <p>Giá: ${price.toLocaleString("vi-VN")} VNĐ</p>
                            <p>Tổng: ${itemTotal.toLocaleString("vi-VN")} VNĐ</p>
                        </div>`;
                    selectedItemsContainer.insertAdjacentHTML("beforeend", itemHTML);
                }
            });

            tongCong.textContent = total.toLocaleString("vi-VN") + " VNĐ";
            tongTien.textContent = total.toLocaleString("vi-VN") + " VNĐ";
        }

        document.querySelectorAll(".selectItem").forEach(checkbox => {
            checkbox.addEventListener("change", updateSelectedItems);
        });
    });

    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("btnCheckout").addEventListener("click", function () {
            const selectedItems = [];

            document.querySelectorAll("#cartTable tr").forEach(row => {
                const checkbox = row.querySelector(".selectItem");
                if (checkbox && checkbox.checked) {
                    const name = row.dataset.name;
                    const color = row.dataset.color;
                    const size = row.dataset.size;
                    const price = parseInt(row.dataset.price);
                    const quantity = parseInt(row.dataset.quantity);
                    const total = price * quantity;
                    const ProductVariantId = parseInt(row.dataset.variant); // ✅ Sửa đúng key

                    selectedItems.push({ name, color, size, price, quantity, total, ProductVariantId });
                }
            });

            if (selectedItems.length === 0) {
                alert("Vui lòng chọn ít nhất 1 sản phẩm để tiếp tục.");
                return;
            }

            // ✅ Lưu với key chính xác
            localStorage.setItem("selectedCartItems", JSON.stringify(selectedItems));

            // ✅ Chuyển sang trang thanh toán
            window.location.href = "@Url.Action("ThanhToan", "User")";
        });
    });
</script>






    </html>