    <!-- Script: hover mượt + add-to-cart -->
    <script>
        // Hover card: phóng ảnh + hiện overlay + bounce nhẹ cho buttons
        document.querySelectorAll('.product-card').forEach(function (card) {
          const img = card.querySelector('.p-img');
          const overlay = card.querySelector('.p-overlay');

          card.addEventListener('mouseenter', function () {
            if (img) { img.style.transform = 'scale(1.05)'; img.style.filter = 'brightness(0.95)'; }
            if (overlay) overlay.style.opacity = '1';

            overlay?.querySelectorAll('.btn').forEach((b, i) => {
              b.style.transform = 'scale(0.9)';
              setTimeout(() => b.style.transform = 'scale(1)', 40 * i);
            });
          });

          card.addEventListener('mouseleave', function () {
            if (img) { img.style.transform = 'none'; img.style.filter = 'none'; }
            if (overlay) overlay.style.opacity = '0';
          });
        });

        // Thêm vào giỏ (LocalStorage) — giữ nguyên cách bạn dùng data-*
        document.querySelectorAll('.add-to-cart').forEach(btn => {
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            const id = this.dataset.id;
            const name = this.dataset.name;
            const price = parseInt(this.dataset.price || '0', 10);
            const img = this.dataset.img;

            let cart = JSON.parse(localStorage.getItem('cartItems') || '[]');
            const found = cart.find(p => p.id == id);
            if (found) {
              found.quantity += 1;
              found.total = found.quantity * found.price;
            } else {
              cart.push({ id, name, price, img, quantity: 1, total: price });
            }
            localStorage.setItem('cartItems', JSON.stringify(cart));
            localStorage.setItem('cartTotal', cart.reduce((acc, p) => acc + p.total, 0));
            alert('Đã thêm sản phẩm vào giỏ!');
          });
        });
    </script>


