@{
    ViewData["Title"] = "Trang chủ";
    Layout = null;
}
@model IEnumerable<DATN1API.Models.Product>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>The Bag Studio</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link href="~/img/favicon.ico" rel="icon" />

    <!-- Google Fonts (tuỳ chọn) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 + Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

</head>
<body style="font-family: 'Poppins', sans-serif;">
    @{
        var success = TempData.Peek("SuccessMessage") as string;
        var error = TempData.Peek("ErrorMessage") as string;
    }
    @if (!string.IsNullOrEmpty(success))
    {
        <div class="alert alert-success alert-dismissible fade show m-0" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger alert-dismissible fade show m-0" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!--menu -->
    <div class="bg-body-tertiary border-0">
        <div class="container-fluid">
            <div class="row align-items-center py-1 px-4 g-0">

                <!-- Links trái -->
                <div class="col-lg-6 d-none d-lg-block">
                    <div class="d-flex">
                        <a href="#" class="small text-secondary text-decoration-none me-3">Liên hệ</a>
                        <a href="#" class="small text-secondary text-decoration-none">Giúp đỡ</a>
                    </div>
                </div>

                <!-- Bên phải -->
                <div class="col-lg-6 d-flex justify-content-end align-items-center">

                    <!-- Account Dropdown -->
                    <div class="dropdown me-2">
                        <button class="btn btn-sm btn-light border dropdown-toggle"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <text>Xin chào, @User.Identity.Name</text>
                            }
                            else
                            {
                                <text>Tài khoản</text>
                            }
                        </button>

                        <!-- Bootstrap 5: dùng <ul><li> và dropdown-menu-end để canh phải -->
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("ProfileUser", "User")">
                                        <i class="fa fa-user me-2"></i>Thông tin cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form action="@Url.Action("LogoutUser", "Account")" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item">Đăng xuất</button>
                                    </form>


                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item" href="/Account/Login"> 
                                        <i class="fa fa-sign-in-alt me-2"></i>Đăng nhập
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Account/Register">
                                        <i class="fa fa-user-plus me-2"></i>Đăng ký
                                    </a>
                                </li>
                            }
                        </ul>

                    </div>

                    <!-- Language -->
                    @* <div class="dropdown"> *@
                    @*     <button class="btn btn-sm btn-light border dropdown-toggle" *@
                    @*             type="button" data-bs-toggle="dropdown" aria-expanded="false"> *@
                    @*         Ngôn ngữ *@
                    @*     </button> *@
                    @*     <ul class="dropdown-menu dropdown-menu-end"> *@
                    @*         <li><a class="dropdown-item" href="#">Tiếng Việt</a></li> *@
                    @*         <li><a class="dropdown-item" href="#">Tiếng Anh</a></li> *@
                    @*     </ul> *@
                    @* </div> *@

                </div>
            </div>
        </div>
    </div>

    


    <!-- Logo + Search + Hotline (lùi vào giống ảnh 2) -->
    <div class="bg-white shadow-sm">
        <div class="container-fluid">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3
            ps-4 pe-3 pe-lg-5 py-3">

                <!-- Logo -->
                <a href="#" class="text-decoration-none d-inline-flex align-items-center">
                    <span class="bg-dark text-warning fw-bold fs-3 px-3 py-2">THE BAG</span>
                    <span class="bg-warning text-dark fw-bold fs-3 px-3 py-2">STUDIO</span>
                </a>

                <!-- Search -->
                <form method="get" asp-action="Index" class="flex-grow-1 d-flex justify-content-center">
                    <div class="input-group" style="max-width:500px;">
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm kiếm sản phẩm...">
                        @if (ViewBag.SelectedCategoryId != null)
                        {
                            <input type="hidden" name="categoryId" value="@ViewBag.SelectedCategoryId" />
                        }
                        <button class="btn btn-warning" type="submit"><i class="bi bi-search"></i></button>
                    </div>
                </form>


                <!-- Hotline -->
                <div class="text-end">
                    <div class="small text-secondary">Chăm sóc khách hàng</div>
                    <div class="fw-semibold">0836 641 809</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation + Categories -->
    <div class="bg-dark">
        <!-- Lùi nội dung vào thêm 1 nấc trên màn lớn + tăng chiều cao thanh menu -->
        <div class="container-fluid px-3 px-lg-5">
            <div class="d-flex align-items-stretch" style="min-height:58px;">

                <!-- Category Button (lùi vào và cao bằng thanh menu) -->
                <div class="position-relative d-flex align-items-stretch me-2 ps-0">
                    <button type="button"
                            class="btn btn-warning fw-semibold d-flex align-items-center justify-content-between px-4
                 border-0 rounded-0 h-100
                 ms-n2 ms-lg-n3"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbar-vertical">
                        <span class="d-flex align-items-center">
                            <i class="bi bi-list me-2"></i> Thể loại
                        </span>
                        <i class="bi bi-chevron-down ms-2"></i>
                    </button>

                    <!-- Category Dropdown (đặt ngay dưới nút, cách xuống 1 chút) -->
                    <nav id="navbar-vertical"
                         class="collapse position-absolute top-100 start-0 bg-white border rounded shadow mt-2"
                         style="width:260px; z-index:1050;">
                        <div class="list-group list-group-flush">
                            <div class="dropend">
                                <a class="list-group-item list-group-item-action dropdown-toggle text-dark hover-gold"
                                   data-bs-toggle="dropdown" data-bs-offset="0,8" href="#">
                                    Sản phẩm
                                </a>
                                <ul class="dropdown-menu">
                                    @if (ViewBag.Categories is List<DATN1API.Models.Category> categories && categories != null)
                                    {
                                        @foreach (var cat in categories)
                                        {
                                            <li>
                                                <a class="dropdown-item text-dark hover-gold"
                                                   asp-controller="User" asp-action="Index"
                                                   asp-route-categoryId="@cat.CategoryId" asp-fragment="recentProducts">
                                                    @cat.CategoryName
                                                </a>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>

                            <a asp-controller="Products" asp-action="Index"
                               class="list-group-item list-group-item-action text-dark hover-gold">Balo</a>
                            <a asp-controller="Products" asp-action="Index"
                               class="list-group-item list-group-item-action text-dark hover-gold">Phụ kiện khác</a>
                        </div>
                    </nav>
                </div>

                <!-- Main Menu -->
                <nav class="navbar navbar-expand-lg navbar-dark flex-grow-1 p-0">
                    <button class="navbar-toggler my-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div id="navbarCollapse" class="collapse navbar-collapse">
                        <!-- links trái (tăng cỡ chữ chút bằng fs-6) -->
                        <div class="navbar-nav align-items-center fs-6">
                            <a href="@Url.Action("Index", "User")" class="nav-link px-3 fw-semibold text-warning">Trang chủ</a>

                            <a href="@Url.Action("KhuyenMai","User")"
                               class="nav-link px-3 text-white-50 nav-hover-gold">Khuyến mãi</a>

                            <a href="@Url.Action("Orders")"
                               class="nav-link px-3 text-white-50 nav-hover-gold">Đơn hàng</a>

                            <div class="nav-item dropdown">
                                <a href="#" class="nav-link dropdown-toggle px-3 text-white-50 nav-hover-gold" data-bs-toggle="dropdown">
                                    Trang
                                </a>
                                <div class="dropdown-menu">
                                    <a href="@Url.Action( "GioHang")" class="dropdown-item">Giỏ hàng</a>
                                    <a href="@Url.Action("ThanhToan")" class="dropdown-item">Thanh toán</a>
                                </div>
                            </div>

                            <a href="@Url.Action("News")"
                               class="nav-link px-3 text-white-50 nav-hover-gold">Tin tức</a>
                        </div>

                        <!-- Icons phải -->
                        <div class="ms-auto d-none d-lg-flex align-items-center gap-3">
                          
                            <a href="@Url.Action("GioHang   ")" class="position-relative text-decoration-none">
                                <i class="bi bi-cart3 text-warning fs-5"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger cart-badge">0</span>
                            </a>
                        </div>
                    </div>
                </nav>

            </div>
        </div>
    </div>
 

    <!-- Hover chữ vàng (giữ nguyên) -->
    <script>
        (function () {
          document.querySelectorAll('.nav-hover-gold').forEach(function(el){
            el.addEventListener('mouseenter', function(){ el.classList.remove('text-white-50'); el.classList.add('text-warning'); });
            el.addEventListener('mouseleave', function(){ el.classList.remove('text-warning'); el.classList.add('text-white-50'); });
          });
          document.querySelectorAll('#navbar-vertical .hover-gold').forEach(function(el){
            el.addEventListener('mouseenter', function(){ el.classList.remove('text-dark'); el.classList.add('text-warning'); });
            el.addEventListener('mouseleave', function(){ el.classList.remove('text-warning'); el.classList.add('text-dark'); });
          });
        })();
    </script>



