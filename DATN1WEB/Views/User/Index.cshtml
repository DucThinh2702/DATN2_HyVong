                        <a class="btn btn-outline-warning border-2"
                           onmouseenter="this.classList.replace('btn-outline-warning','btn-warning'); this.classList.add('text-dark');"
                           onmouseleave="this.classList.replace('btn-warning','btn-outline-warning'); this.classList.remove('text-dark');"
                           href="#"><i class="bi bi-linkedin"></i></a>

                        <a class="btn btn-outline-warning border-2"
