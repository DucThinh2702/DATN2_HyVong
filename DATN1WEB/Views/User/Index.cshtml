    <!-- Hover vàng + chuyển động nhẹ CÔNG CỤ -->
    <script>
        document.querySelectorAll('.feature-hover').forEach(function(card){
          const icon = card.querySelector('i');
          const text = card.querySelector('h6');
          card.style.transition = 'transform .25s ease, box-shadow .25s ease, background-color .25s ease';

          card.addEventListener('mouseenter', function(){
            card.classList.add('bg-warning','shadow');
            card.style.transform = 'translateY(-3px)';
            icon.classList.replace('text-warning','text-dark');
            text.classList.add('text-dark');
          });

          card.addEventListener('mouseleave', function(){
            card.classList.remove('bg-warning','shadow');
            card.style.transform = 'translateY(0)';
            icon.classList.replace('text-dark','text-warning');
            text.classList.remove('text-dark');
          });
        });
    </script>


    @{
        var catList = ViewBag.Categories as List<DATN1API.Models.Category> ?? new();
        var counts = ViewBag.CategoryCounts as Dictionary<int, int> ?? new();
        int perSlide = 4; // số item mỗi slide
        int totalSlides = catList.Any() ? (int)Math.Ceiling((double)catList.Count / perSlide) : 1;
    }

    <div id="catCarousel"
         class="container-fluid px-3 px-md-4 mt-4 mt-lg-5 pt-1"
         data-bs-ride="false"
         data-bs-wrap="false"
         data-bs-touch="true"
         data-bs-interval="false">

        <div class="mb-3 d-flex align-items-center">
            <h2 class="fw-bold me-3 mb-0">THỂ LOẠI</h2>
            <div class="flex-grow-1 border-bottom"></div>
        </div>

        <!-- Indicators -->
        <div class="d-flex justify-content-center mb-3">
            <div class="carousel-indicators position-static gap-2 m-0">
                @for (int s = 0; s < totalSlides; s++)
                {
                    <button type="button"
                            data-bs-target="#catCarouselInner"
                            data-bs-slide-to="@s"
                            class="@(s == 0 ? "active" : "")"
                            aria-label="Slide @(s + 1)">
                    </button>
                }
            </div>
        </div>

        <div id="catCarouselInner" class="carousel slide" data-bs-interval="false" data-bs-wrap="false" data-bs-touch="true">
            <div class="carousel-inner">
                @if (catList.Any())
                {
                    for (int i = 0; i < catList.Count; i += perSlide)
                    {
                        var slice = catList.Skip(i).Take(perSlide).ToList();
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="row gx-3 ps-1 ps-md-2 ps-lg-3">
                                @foreach (var cat in slice)
                                {
                                    var raw = (cat.CategoryImage ?? "").Replace("\\", "/").Trim();
                                    string imgUrl;
                                    if (!string.IsNullOrWhiteSpace(raw) && Uri.IsWellFormedUriString(raw, UriKind.Absolute))
                                        imgUrl = raw;
                                    else
                                    {
                                        var fileName = System.IO.Path.GetFileName(raw.TrimStart('/'));
                                        imgUrl = !string.IsNullOrEmpty(fileName)
                                        ? Url.Content($"~/hinh/{fileName}")
                                        : Url.Content("~/images/placeholder-category.png");
                                    }
                                    var productCount = counts.TryGetValue(cat.CategoryId, out var c) ? c : 0;

                                    <div class="col-12 col-md-6 col-lg-3">
                                        <a asp-controller="User"
                                           asp-action="Index"
                                           asp-route-categoryId="@cat.CategoryId"
                                           asp-fragment="recentProducts"
                                           class="text-decoration-none">
                                            <div class="card h-100 border rounded-3 shadow-sm category-card">
                                                <div class="card-body d-flex align-items-center gap-3">
                                                    <div class="ratio ratio-4x3" style="max-width:120px;">
                                                        <img src="@imgUrl" alt="@cat.CategoryName"
                                                             class="img-fluid rounded-3 border"
                                                             style="object-fit:cover;" />
                                                    </div>
                                                    <div class="min-w-0">
                                                        <h6 class="mb-1 fw-semibold text-truncate title-text">@cat.CategoryName</h6>
                                                        <div class="small text-muted">@productCount sản phẩm</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>

                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="carousel-item active">
                        <div class="alert alert-light mb-0">Không có thể loại nào được tìm thấy.</div>
                    </div>
                }
            </div>

            <!-- Nút điều hướng -->
            <button class="carousel-control-prev" type="button"
                    data-bs-target="#catCarouselInner" data-bs-slide="prev" aria-label="Trước">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Trước</span>
            </button>
            <button class="carousel-control-next" type="button"
                    data-bs-target="#catCarouselInner" data-bs-slide="next" aria-label="Sau">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Sau</span>
            </button>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const wrapper = document.getElementById('catCarouselInner');
            if (!wrapper) return;

            const prevBtn = wrapper.querySelector('.carousel-control-prev');
            const nextBtn = wrapper.querySelector('.carousel-control-next');
            const items = wrapper.querySelectorAll('.carousel-item');
            const indicators = document.querySelectorAll('.carousel-indicators [data-bs-target="#catCarouselInner"]');
            const total = items.length;

            const carousel = bootstrap.Carousel.getInstance(wrapper) || new bootstrap.Carousel(wrapper, {
                interval: false, ride: false, wrap: false, touch: true, pause: false, keyboard: true
            });

            const getActiveIndex = () => Array.from(items).findIndex(i => i.classList.contains('active'));
            function setBtnState(idx) {
                const atStart = idx === 0, atEnd = idx === total - 1;
                prevBtn.classList.toggle('disabled', atStart);
                prevBtn.setAttribute('aria-disabled', atStart ? 'true' : 'false');
                nextBtn.classList.toggle('disabled', atEnd);
                nextBtn.setAttribute('aria-disabled', atEnd ? 'true' : 'false');
            }

            wrapper.addEventListener('slid.bs.carousel', () => {
                const idx = getActiveIndex();
                setBtnState(idx);
                indicators.forEach((ind, i) => {
                    ind.classList.toggle('active', i === idx);
                    ind.setAttribute('aria-current', i === idx ? 'true' : 'false');
                });
            });
            setBtnState(getActiveIndex());

            indicators.forEach((ind, i) => ind.addEventListener('click', (e) => {
                e.preventDefault();
                if (i !== getActiveIndex()) carousel.to(i);
            }));

            // Hover vàng
            document.querySelectorAll('.category-card').forEach(card => {
                const title = card.querySelector('.title-text');
                card.addEventListener('mouseenter', () => {
                    card.classList.add('border-warning','bg-warning-subtle','shadow');
                    if (title) title.classList.add('text-warning');
                });
                card.addEventListener('mouseleave', () => {
                    card.classList.remove('border-warning','bg-warning-subtle','shadow');
                    if (title) title.classList.remove('text-warning');
                });
            });
        });
              <script>
        // Pagination AJAX
        document.addEventListener("click", async (e) => {
          const a = e.target.closest(".page-ajax");
          if (!a) return;
          e.preventDefault();

          const page = a.dataset.page;
          if (!page) return;

          const url = new URL("@Url.Action("Index", "User")", window.location.origin);
          url.searchParams.set("page", page);

          // giữ categoryId hiện tại
          const selectedCategoryId = "@(ViewBag.SelectedCategoryId ?? "")";
          if (selectedCategoryId) url.searchParams.set("categoryId", selectedCategoryId);

          // giữ search hiện tại
          const currentSearch = "@(ViewBag.Search ?? "")";
          if (currentSearch) url.searchParams.set("search", currentSearch);

          const html = await fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } }).then(r => r.text());
          const dom = new DOMParser().parseFromString(html, "text/html");
          const newContent = dom.querySelector("#productContainer");
          if (newContent) document.querySelector("#productContainer").innerHTML = newContent.innerHTML;

          const recent = document.querySelector("#recentProducts");
          if (recent) recent.scrollIntoView({ behavior: "smooth" });
        });

        // Auto scroll khi vào bằng #recentProducts
        if (window.location.hash === "#recentProducts") {
          const target = document.querySelector(window.location.hash);
          target?.scrollIntoView({ behavior: "smooth" });
        }
    </script>

    </script>





