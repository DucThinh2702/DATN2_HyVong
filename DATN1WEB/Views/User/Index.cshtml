    <!-- Back to top -->
    <button id="backToTop"
            type="button"
            class="btn btn-warning btn-lg rounded-circle position-fixed bottom-0 end-0 m-4 shadow-lg d-none
         d-flex align-items-center justify-content-center"
            style="width:56px; height:56px; z-index:1080; transition:transform .15s ease;"
            data-bs-toggle="tooltip" data-bs-placement="left" title="Lên đầu trang"
            aria-label="Lên đầu trang"
            onmouseenter="this.style.transform='scale(1.06)'"
            onmouseleave="this.style.transform='scale(1)'">
        <i class="bi bi-chevron-double-up fs-4"></i>
    </button>

    <script>
        // Hiện/ẩn nút khi cuộn
        (function () {
          const btn = document.getElementById('backToTop');

          const toggleBtn = () => {
            if (window.scrollY > 300) btn.classList.remove('d-none');
            else btn.classList.add('d-none');
          };
          window.addEventListener('scroll', toggleBtn);
          toggleBtn();

          // Cuộn mượt lên đầu
          btn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });

          // Kích hoạt tooltip Bootstrap (nếu đã include JS của Bootstrap)
          if (window.bootstrap) {
            const tt = new bootstrap.Tooltip(btn);
          }
        })();
    </script>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scripts (vanilla, không jQuery) -->
    <script>
        // Add to cart (localStorage)
        function updateCartBadge() {
            const cart = JSON.parse(localStorage.getItem("cartItems") || "[]");
            const count = cart.reduce((sum, item) => sum + (item.quantity || 0), 0);
            document.querySelectorAll(".cart-badge").forEach(badge => {
                badge.textContent = count;
            });
        }

        document.addEventListener("click", function (e) {
            const btn = e.target.closest(".add-to-cart");
            if (!btn) return;

            e.preventDefault();
            const id = btn.dataset.id;
            const name = btn.dataset.name;
            const price = parseInt(btn.dataset.price || "0", 10);
            const img = btn.dataset.img;

            let cart = JSON.parse(localStorage.getItem("cartItems") || "[]");
            const found = cart.find(p => p.id === id);
            if (found) {
                found.quantity += 1;
                found.total = found.quantity * found.price;
            } else {
                cart.push({ id, name, price, img, quantity: 1, total: price });
            }

            localStorage.setItem("cartItems", JSON.stringify(cart));
            localStorage.setItem("cartTotal", cart.reduce((acc, p) => acc + (p.total || 0), 0));
            updateCartBadge();
            alert("Đã thêm sản phẩm vào giỏ hàng!");
        });

        // Pagination (AJAX bằng fetch)
        document.addEventListener("click", async (e) => {
            const a = e.target.closest(".page-ajax");
            if (!a) return;
            e.preventDefault();
            const page = a.dataset.page;
            if (!page) return;

            const url = new URL("@Url.Action("Index", "User")", window.location.origin);
            url.searchParams.set("page", page);

            const html = await fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } }).then(r => r.text());
            const dom = new DOMParser().parseFromString(html, "text/html");
            const newContent = dom.querySelector("#productContainer");
            if (newContent) document.querySelector("#productContainer").innerHTML = newContent.innerHTML;

            const recent = document.querySelector("#recentProducts");
            if (recent) recent.scrollIntoView({ behavior: "smooth" });
            updateCartBadge();
        });

        // Back to top smooth
        document.querySelector(".btn.rounded-circle.position-fixed.bottom-0.end-0")?.addEventListener("click", function (e) {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: "smooth" });
        });

        // Initialize badge on load
        updateCartBadge();

        // Smooth scroll if has #recentProducts
        if (window.location.hash === "#recentProducts") {
            const target = document.querySelector(window.location.hash);
            if (target) target.scrollIntoView({ behavior: "smooth" });
        }

        //icon hiện giỏ hàng
        document.addEventListener("DOMContentLoaded", async () => {
          try {
            const res = await fetch("@Url.Action("CartCount", "User")");
            const data = await res.json();
            const badge = document.querySelector(".cart-badge");
            if (badge) {
              badge.textContent = data.count ?? 0;
              badge.classList.toggle("d-none", (data.count ?? 0) <= 0);
            }
          } catch { /* ignore */ }
        });

    </script>
    <div class="toast position-fixed bottom-0 end-0 m-3" id="logoutToast" role="alert" data-bs-delay="3000">
        <div class="toast-header">
            <strong class="me-auto">Thông báo</strong>
            <small>vừa xong</small>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @TempData["LogoutMessage"]
        </div>
    </div>

    @section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var hasMsg = '@TempData["LogoutMessage"]' !== '';
                if (hasMsg) {
                    var toastEl = document.getElementById('logoutToast');
                    if (toastEl) new bootstrap.Toast(toastEl).show();
                }
            });
        </script>
    }

</body>
</html>

