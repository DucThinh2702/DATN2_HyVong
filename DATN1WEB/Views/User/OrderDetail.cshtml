@model DATN1WEB.Models.ViewModels.MyOrderDetailVM
@{
    ViewData["Title"] = $"Đơn hàng #{Model.OrderId}";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";

    string MapOrderVi(string s)
    {
        var x = (s ?? "").Trim().ToLower();
        if (string.IsNullOrWhiteSpace(x)) return "Chờ xác nhận";
        return x switch
        {
            "pending" => "Chờ xác nhận",
            "processing" or "đang xử lý" or "chờ xử lý" or "đang chuẩn bị" => "Đang chuẩn bị",
            "shipping" or "đang giao" => "Đang giao",
            "delivered" or "completed" or "hoàn tất" => "Hoàn tất",
            "cancelled" or "đã huỷ" or "đã hủy" => "Đã huỷ",
            _ => "Chờ xác nhận"
        };
    }
    string MapPaymentVi(string s)
    {
        var x = (s ?? "").Trim().ToLower();
        return x switch
        {
            "paid" => "Đã thanh toán",
            "unpaid" or "" or "chưa thanh toán" => "Chưa thanh toán",
            "pending" => "Chờ thanh toán",
            "failed" => "Thanh toán thất bại",
            _ => "Chưa thanh toán"
        };
    }
    int StepIndex(string s) => (s?.Trim().ToLower()) switch
    {
        null or "" or "pending" or "chờ xác nhận" => 0,
        "processing" or "đang chuẩn bị" or "đang xử lý" or "chờ xử lý" => 1,
        "shipping" or "đang giao" => 2,
        "delivered" or "completed" or "hoàn tất" => 3,
        _ => 0
    };
    string StepClass(string key)
    {
        var cur = StepIndex(Model.OrderStatus);
        var idx = StepIndex(key);
        if (cur > idx) return "step done";
        if (cur == idx) return "step active";
        return "step";
    }
    var st = (Model.OrderStatus ?? "").Trim().ToLower();
    bool canEditOrCancel = st == "" || st == "pending" || st == "chờ xác nhận";
}

<style>
    .stepper {
        display: flex;
        gap: 12px;
        align-items: center
    }

    .step {
        display: flex;
        flex-direction: column;
        align-items: center
    }

        .step .dot {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #dee2e6
        }

        .step.active .dot {
            background: #0d6efd
        }

        .step.done .dot {
            background: #198754
        }

        .step .label {
            font-size: .85rem;
            margin-top: 4px;
            color: #6c757d
        }

        .step.active .label {
            color: #0d6efd
        }

        .step.done .label {
            color: #198754
        }

    .bar {
        width: 72px;
        height: 2px;
        background: #dee2e6
    }

    .step.active + .bar, .step.done + .bar {
        background: #198754
    }
</style>

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">Đơn hàng #@Model.OrderId</h4>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="@Url.Action("Orders","User")">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
            @if (canEditOrCancel)
            {
                <button id="btnEdit" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal">
                    <i class="bi bi-pencil-square"></i> Chỉnh sửa
                </button>
                <button class="btn btn-outline-danger"
                        data-bs-toggle="modal" data-bs-target="#cancelModal">
                    <i class="bi bi-x-circle"></i> Huỷ đơn
                </button>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                    <div><strong>Tổng tiền:</strong> @Model.TotalAmount.ToString("N0") VNĐ</div>
                    <div><strong>Số lượng:</strong> @Model.Quantity</div>
                </div>
                <div class="col-md-4">
                    <div><strong>Thanh toán:</strong> @MapPaymentVi(Model.PaymentStatus)</div>
                    <div><strong>Trạng thái:</strong> @MapOrderVi(Model.OrderStatus)</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <div><strong>Ghi chú:</strong> @Model.Note</div>
                    }
                </div>
                <div class="col-md-4">
                    <div><strong>Người nhận:</strong> @Model.RecipientName</div>
                    <div><strong>Điện thoại:</strong> @Model.RecipientPhone</div>
                    <div><strong>Địa chỉ:</strong> @Model.DeliveryAddress</div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light">
            <div class="stepper">
                <div class="@(StepClass("pending"))"><div class="dot"></div><div class="label">Chờ xác nhận</div></div><div class="bar"></div>
                <div class="@(StepClass("processing"))"><div class="dot"></div><div class="label">Đang chuẩn bị</div></div><div class="bar"></div>
                <div class="@(StepClass("shipping"))"><div class="dot"></div><div class="label">Đang giao</div></div><div class="bar"></div>
                <div class="@(StepClass("delivered"))"><div class="dot"></div><div class="label">Hoàn tất</div></div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Thuộc tính</th>
                        <th class="text-center">SL</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@i.ThumbnailImage" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:.5rem" />
                                    <div>@i.ProductName</div>
                                </div>
                            </td>
                            <td><small class="text-muted">Màu: @(i.ColorName ?? "-") &nbsp;·&nbsp; Size: @(i.SizeName ?? "-")</small></td>
                            <td class="text-center">@i.Quantity</td>
                            <td class="text-end">@i.UnitPrice.ToString("N0") VNĐ</td>
                            <td class="text-end">@i.TotalPrice.ToString("N0") VNĐ</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr><th colspan="4" class="text-end">Tổng cộng</th><th class="text-end">@Model.TotalAmount.ToString("N0") VNĐ</th></tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@if (canEditOrCancel)
{
    <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Chỉnh sửa thông tin giao hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <!-- FORM POST TỚI UpdateOrderInfo -->
                <form asp-controller="User" asp-action="UpdateOrderInfo" method="post" id="editForm">
                    @Html.AntiForgeryToken()

                    <div class="modal-body">
                        <!-- OrderId để bind vào DTO -->
                        <input type="hidden" name="OrderId" value="@Model.OrderId" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Tên người nhận</label>
                                <input name="RecipientName" id="editName" class="form-control" value="@Model.RecipientName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Số điện thoại</label>
                                <input name="RecipientPhone" id="editPhone" class="form-control" value="@Model.RecipientPhone" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Địa chỉ</label>
                                <input name="DeliveryAddress" id="editAddress" class="form-control" value="@Model.DeliveryAddress" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Ghi chú</label>
                                <textarea name="Note" id="editNote" class="form-control" rows="3">@Model.Note</textarea>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Đóng</button>
                        <button class="btn btn-primary" type="submit" id="btnSaveEdit">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}


@section Scripts {
    <script>
        // ===== Auto refresh trạng thái đơn mỗi 20s =====
        setInterval(async () => {
          try {
            const res = await fetch(`/User/MyOrderStatus?id=@Model.OrderId`);
            const data = await res.json();
            if (data?.success) {
              const current = "@Model.OrderStatus";
              if (data.orderStatus && data.orderStatus !== current) location.reload();
            }
          } catch { /* ignore */ }
        }, 20000);

        // Không dùng localStorage cho thông báo
        try { localStorage.removeItem("OrderMessage"); } catch {}

        // Lấy Anti-forgery token từ LayoutUser
        const AF_TOKEN = document.querySelector('meta[name="request-verification-token"]')?.content || '';

        function closeModal(id){
          const el = document.getElementById(id);
          if (!el) return;
          if (window.bootstrap){
            const inst = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);
            inst.hide();
          }else{
            el.classList.remove("show"); el.style.display="none";
            document.body.classList.remove("modal-open");
            document.querySelectorAll(".modal-backdrop").forEach(e=>e.remove());
          }
        }

        @if (canEditOrCancel)
        {
            <text>
              // ===== Huỷ đơn =====
              document.getElementById("btnCancel")?.addEventListener("click", async () => {
                if (!confirm("Bạn có chắc muốn huỷ đơn #@Model.OrderId ?")) return;

                let reason = prompt("Vui lòng nhập lý do huỷ (tối thiểu 5 ký tự):", "");
                if (reason === null) return;
                reason = (reason || "").trim();
                if (reason.length < 5) { showToast("Lý do huỷ tối thiểu 5 ký tự.", "warning"); return; }

                try{
                  const res = await fetch(`/User/CancelOrder`, {
                    method: "POST",
                    headers: {
                      "Content-Type": "application/json",
                      "RequestVerificationToken": AF_TOKEN
                    },
                    body: JSON.stringify({ id: @Model.OrderId, reason })
                  });
                  const data = await res.json();
                  if (data.success){
                    showToast(data.message || "Đã huỷ đơn.", "success");
                    setTimeout(()=>location.reload(), 1200);
                  }else{
                    showToast(data.message || "Không thể huỷ đơn lúc này.", "danger");
                  }
                }catch{
                  showToast("Không thể huỷ đơn lúc này.", "danger");
                }
              });

              // ===== Lưu chỉnh sửa thông tin giao hàng =====
              document.getElementById("btnSaveEdit")?.addEventListener("click", async () => {
                const payload = {
                  orderId: @Model.OrderId,
                  recipientName: document.getElementById("editName").value.trim(),
                  recipientPhone: document.getElementById("editPhone").value.trim(),
                  deliveryAddress: document.getElementById("editAddress").value.trim(),
                  note: document.getElementById("editNote").value
                };

                if (!payload.recipientName || !payload.recipientPhone || !payload.deliveryAddress) {
                  showToast("Vui lòng nhập đủ Tên, SĐT, Địa chỉ.", "warning");
                  return;
                }

                try{
                  const res = await fetch("/User/UpdateOrderInfo", {
                    method: "POST",
                    headers: {
                      "Content-Type": "application/json",
                      "RequestVerificationToken": AF_TOKEN
                    },
                    body: JSON.stringify(payload)
                  });
                  const data = await res.json();

                  if (data.success){
                    closeModal("editModal");
                    showToast(data.message || "Cập nhật thành công.", "success");
                    setTimeout(()=>location.reload(), 1200);
                  }else{
                    showToast(data.message || "Cập nhật thất bại.", "danger");
                  }
                }catch{
                  showToast("Không thể lưu thay đổi lúc này.", "danger");
                }
              });
            </text>
        }
    </script>
}
