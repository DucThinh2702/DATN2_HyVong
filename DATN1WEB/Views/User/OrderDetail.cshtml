@model DATN1WEB.Models.ViewModels.MyOrderDetailVM
@{
    ViewData["Title"] = $"Đơn hàng #{Model.OrderId}";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";

    // ===== Map trạng thái tiếng Việt (hiển thị phần thông tin) =====
    string MapOrderVi(string s)
    {
        var x = (s ?? "").Trim().ToLower();
        if (string.IsNullOrWhiteSpace(x)) return "Chờ xác nhận";
        return x switch
        {
            "pending" or "chờ xác nhận" => "Chờ xác nhận",
            "processing" or "đang xử lý" or "chờ xử lý" or "đang chuẩn bị" => "Đang chuẩn bị",
            "shipping" or "đang giao" => "Đang giao",
            "awaiting_receipt" or "chờ nhận hàng" => "Chờ nhận hàng",  // vẫn map để hiển thị chữ (nếu có)
            "delivered" or "completed" or "hoàn tất" => "Hoàn tất",
            "cancelled" or "đã huỷ" or "đã hủy" => "Đã huỷ",
            _ => "Chờ xác nhận"
        };
    }
    string MapPaymentVi(string s)
    {
        var x = (s ?? "").Trim().ToLower();
        return x switch
        {
            "paid" or "đã thanh toán" => "Đã thanh toán",
            "pending" or "chờ thanh toán" => "Chờ thanh toán",
            "failed" or "thất bại" => "Thanh toán thất bại",
            "unpaid" or "" or "chưa thanh toán" => "Chưa thanh toán",
            _ => "Chưa thanh toán"
        };
    }

    // Hiển thị chữ trạng thái & thanh toán
    var paymentVi = MapPaymentVi(Model.PaymentStatus);
    var orderVi = MapOrderVi(Model.OrderStatus);

    // ===== StepIndex cho STEPPER (chỉ 4 bước, KHÔNG có "Chờ nhận hàng") =====
    int StepIndexByKey(string key) => (key ?? "").Trim().ToLower() switch
    {
        "pending" => 0,
        "processing" => 1,
        "shipping" => 2,
        "delivered" => 3,
        _ => 0
    };

    // Quy về 1 trong 4 mốc step từ trạng thái hiện có
    int CurrentStepIndex()
    {
        var v = (orderVi ?? "").ToLower();
        return v switch
        {
            "chờ xác nhận" => 0,
            "đang chuẩn bị" => 1,
            "đang giao" => 2,
            // "chờ nhận hàng" không có step riêng -> gán vào step "đang giao" cho hợp lý
            "chờ nhận hàng" => 2,
            "hoàn tất" => 3,
            _ => 0
        };
    }

    string StepClass(string key)
    {
        var cur = CurrentStepIndex();
        var idx = StepIndexByKey(key);
        if (cur > idx) return "step done";
        if (cur == idx) return "step active";
        return "step";
    }

    var stRaw = (Model.OrderStatus ?? "").Trim().ToLower();
    bool canEditOrCancel = string.IsNullOrWhiteSpace(stRaw) || stRaw == "pending" || stRaw == "chờ xác nhận";
}

<style>
    .stepper {
        display: flex;
        gap: 12px;
        align-items: center
    }

    .step {
        display: flex;
        flex-direction: column;
        align-items: center
    }

        .step .dot {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #dee2e6
        }

        .step.active .dot {
            background: #0d6efd
        }

        .step.done .dot {
            background: #198754
        }

        .step .label {
            font-size: .85rem;
            margin-top: 4px;
            color: #6c757d
        }

        .step.active .label {
            color: #0d6efd
        }

        .step.done .label {
            color: #198754
        }

    .bar {
        width: 72px;
        height: 2px;
        background: #dee2e6
    }

    .step.active + .bar, .step.done + .bar {
        background: #198754
    }
</style>

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">Đơn hàng #@Model.OrderId</h4>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="@Url.Action("Orders","User")">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
            @if (canEditOrCancel)
            {
                <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                    <i class="bi bi-x-circle"></i> Huỷ đơn
                </button>
            }
        </div>
    </div>

    <!-- Thông tin đơn -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                    <div><strong>Tổng tiền:</strong> @Model.TotalAmount.ToString("N0") VNĐ</div>
                    <div><strong>Số lượng:</strong> @Model.Quantity</div>
                </div>
                <div class="col-md-4">
                    <div><strong>Thanh toán:</strong> @paymentVi</div>
                    <div><strong>Trạng thái:</strong> @orderVi</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <div><strong>Ghi chú:</strong> @Model.Note</div>
                    }
                </div>
                <div class="col-md-4">
                    <div><strong>Người nhận:</strong> @Model.RecipientName</div>
                    <div><strong>Điện thoại:</strong> @Model.RecipientPhone</div>
                    <div><strong>Địa chỉ:</strong> @Model.DeliveryAddress</div>
                </div>
            </div>
        </div>

        <!-- Stepper 4 bước -->
        <div class="card-footer bg-light">
            <div class="stepper">
                <div class="@(StepClass("pending"))"><div class="dot"></div><div class="label">Chờ xác nhận</div></div><div class="bar"></div>
                <div class="@(StepClass("processing"))"><div class="dot"></div><div class="label">Đang chuẩn bị</div></div><div class="bar"></div>
                <div class="@(StepClass("shipping"))"><div class="dot"></div><div class="label">Đang giao</div></div><div class="bar"></div>
                <div class="@(StepClass("delivered"))"><div class="dot"></div><div class="label">Hoàn tất</div></div>
            </div>
        </div>
    </div>

    <!-- Sản phẩm -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Thuộc tính</th>
                        <th class="text-center">SL</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@i.ThumbnailImage" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:.5rem" />
                                    <div>@i.ProductName</div>
                                </div>
                            </td>
                            <td><small class="text-muted">Màu: @(i.ColorName ?? "-") · Size: @(i.SizeName ?? "-")</small></td>
                            <td class="text-center">@i.Quantity</td>
                            <td class="text-end">@i.UnitPrice.ToString("N0") VNĐ</td>
                            <td class="text-end">@i.TotalPrice.ToString("N0") VNĐ</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr><th colspan="4" class="text-end">Tổng cộng</th><th class="text-end">@Model.TotalAmount.ToString("N0") VNĐ</th></tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Modal huỷ -->
@if (canEditOrCancel)
{
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Huỷ đơn hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p>Bạn có chắc muốn huỷ đơn hàng <strong>#@Model.OrderId</strong> không?</p>
                </div>
                <div class="modal-footer">
                    <form asp-controller="User" asp-action="CancelOrder" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.OrderId" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-danger">Xác nhận huỷ</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Tự làm mới trạng thái mỗi 20s
        setInterval(async () => {
          try {
            const res = await fetch(`/User/MyOrderStatus?id=@Model.OrderId`);
            const data = await res.json();
            if (data?.success) {
              const current = "@orderVi";
              if (data.orderStatus && data.orderStatus !== current) location.reload();
            }
          } catch {}
        }, 20000);
    </script>
}
