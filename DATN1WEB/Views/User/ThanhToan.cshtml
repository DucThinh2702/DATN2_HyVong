    <!-- Script gọi API địa chỉ mới (34 tỉnh thành) -->
    <script>
                document.addEventListener("DOMContentLoaded", () => {
            const btnOrder = document.getElementById("btn-order");
            const vnpayForm = document.getElementById("vnpayForm");

            // Lắng nghe sự kiện chọn phương thức thanh toán
            document.querySelectorAll('input[name="payment"]').forEach((paymentMethod) => {
                paymentMethod.addEventListener('change', (event) => {
                    if (event.target.id === "vnpay") {
                        // Hiển thị nút thanh toán với VnPay nếu chọn phương thức VnPay
                        vnpayForm.style.display = 'block';
                    } else {
                        vnpayForm.style.display = 'none';
                    }
                });
            });

            // Xử lý nút đặt hàng
            btnOrder.addEventListener("click", async () => {
                const items = JSON.parse(localStorage.getItem("selectedCartItems") || "[]");
                if (items.length === 0) {
                    alert("Giỏ hàng rỗng!");
                    return;
                }

                const name = document.getElementById("customer-name").value.trim();
                const phone = document.getElementById("customer-phone").value.trim();
                const address = document.getElementById("customer-address").value.trim();

                if (!name || !phone || !address) {
                    alert("Vui lòng nhập đầy đủ thông tin nhận hàng!");
                    return;
                }

                let paymentMethod = null;
                if (document.getElementById("cod").checked) paymentMethod = 1;
                if (document.getElementById("bank").checked) paymentMethod = 2;
                if (document.getElementById("vnpay").checked) paymentMethod = 3;  // Phương thức thanh toán VnPay

                if (!paymentMethod) {
                    alert("Vui lòng chọn phương thức thanh toán!");
                    return;
                }

                const userId = "@ViewBag.UserId";

                const order = {
                    userId: userId,
                    recipientName: name,
                    recipientPhone: phone,
                    deliveryAddress: address,
                    note: "",
                    promoCode: null,
                    shippingFee: 45000,
                    items: items.map(i => ({
                        productVariantId: parseInt(i.ProductVariantId), // ✅ SỬA: đúng key & ép kiểu
                        quantity: i.quantity,
                        unitPrice: i.price
                    }))
                };

                try {
                    const btnOrder = document.getElementById("btn-order");
                    btnOrder.disabled = true;
                    btnOrder.innerText = "Đang xử lý...";

                    const response = await fetch("/api/order", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(order)
                    });

                    const result = await response.json();
                    if (response.ok) {
                        alert("Đặt hàng thành công! Mã đơn: " + (result.orderId || "Không rõ"));

                        if (paymentMethod === 3) {
                            // Nếu chọn thanh toán qua VnPay, gửi yêu cầu tới VnPay
                            const form = document.getElementById("vnpayForm");
                            form.submit();
                        } else {
                            localStorage.removeItem("selectedCartItems");
                            window.location.href = "/"; // hoặc trang cảm ơn
                        }
                    } else {
                        alert("Đặt hàng thất bại: " + (result.message || "Lỗi không xác định"));
                    }
                } catch (err) {
                    console.error(err);
                    alert("Đã có lỗi khi gửi đơn hàng.");
                } finally {
                    const btnOrder = document.getElementById("btn-order");
                    btnOrder.disabled = false;
                    btnOrder.innerText = "Đặt hàng";
                }
            });
        });

        document.addEventListener("DOMContentLoaded", () => {
            const provinceSelect = document.getElementById("province");
            const wardSelect = document.getElementById("ward");

            // ===================== LOAD TỈNH/THÀNH =====================
            async function loadProvinces() {
                try {
                    const res = await fetch("https://34tinhthanh.com/api/provinces");
                    if (!res.ok) throw new Error("Không thể tải danh sách tỉnh/thành");
                    const data = await res.json();
                    data.forEach(p => {
                        provinceSelect.add(new Option(p.name, p.province_code));
                    });
                } catch (err) {
                    console.error("Lỗi khi tải tỉnh/thành:", err);
                    alert("Không thể tải tỉnh/thành. Kiểm tra kết nối.");
                }
            }

            async function loadWards(provinceCode) {
                try {
                    const res = await fetch(`https://34tinhthanh.com/api/wards?province_code=${provinceCode}`);
                    if (!res.ok) throw new Error("Không thể tải danh sách phường/xã");
                    const data = await res.json();

                    wardSelect.innerHTML = "<option value=''>Chọn phường/xã</option>";
                    data.forEach(w => {
                        let label = w.ward_name;
                        if (w.has_merger) {
                            label += ` (sáp nhập từ: ${w.old_units.join(", ")})`;
                        }
                        wardSelect.add(new Option(label, w.ward_code));
                    });
                } catch (err) {
                    console.error("Lỗi khi tải phường/xã:", err);
                    alert("Không thể tải phường/xã.");
                }
            }

            loadProvinces();
            provinceSelect.addEventListener("change", () => {
                const code = provinceSelect.value;
                if (!code) {
                    wardSelect.innerHTML = "<option value=''>Chọn phường/xã</option>";
                    return;
                }
                loadWards(code);
            });
        });

        // ===================== HIỂN THỊ GIỎ HÀNG =====================
        document.addEventListener("DOMContentLoaded", () => {
            const items = JSON.parse(localStorage.getItem("selectedCartItems") || "[]");
            const checkoutItems = document.getElementById("checkoutItems");
            const checkoutTotal = document.getElementById("checkoutTotal");
            let total = 0;

            if (items.length === 0) {
                checkoutItems.innerHTML = "<p>Không có sản phẩm được chọn.</p>";
            } else {
                items.forEach(item => {
                    total += item.total;
                    checkoutItems.innerHTML += `
                        <div class="border-bottom mb-2 pb-2">
                            <h6>${item.name}</h6>
                            <p>Màu sắc: ${item.color}</p>
                            <p>Size: ${item.size}</p>
                            <p>Số lượng: ${item.quantity}</p>
                            <p>Giá: ${item.price.toLocaleString("vi-VN")} VNĐ</p>
                            <p>Tổng: ${item.total.toLocaleString("vi-VN")} VNĐ</p>
                        </div>`;
                });
            }
            checkoutTotal.textContent = total.toLocaleString("vi-VN") + " VNĐ";
        });

        // ===================== GỬI ĐƠN HÀNG =====================
        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById("btn-order").addEventListener("click", async () => {
                const items = JSON.parse(localStorage.getItem("selectedCartItems") || "[]");
                if (items.length === 0) {
                    alert("Giỏ hàng rỗng!");
                    return;
                }

                const name = document.getElementById("customer-name").value.trim();
                const phone = document.getElementById("customer-phone").value.trim();
                const address = document.getElementById("customer-address").value.trim();

                if (!name || !phone || !address) {
                    alert("Vui lòng nhập đầy đủ thông tin nhận hàng!");
                    return;
                }

                let paymentMethod = null;
                if (document.getElementById("cod").checked) paymentMethod = 1;
                if (document.getElementById("bank").checked) paymentMethod = 2;

                if (!paymentMethod) {
                    alert("Vui lòng chọn phương thức thanh toán!");
                    return;
                }

                const userId = "bcd4cce4-5ad1-467d-8999-18a267a1633c"; // ⚠️ Sửa lại theo user thật

                const order = {
                    userId: userId,
                    recipientName: name,
                    recipientPhone: phone,
                    deliveryAddress: address,
                    note: "",
                    promoCode: null,
                    shippingFee: 45000,
                    items: items.map(i => ({
                        productVariantId: parseInt(i.ProductVariantId), // ✅ SỬA: đúng key & ép kiểu
                        quantity: i.quantity,
                        unitPrice: i.price
                    }))
                };

                try {
                    const btnOrder = document.getElementById("btn-order");
                    btnOrder.disabled = true;
                    btnOrder.innerText = "Đang xử lý...";

                    const response = await fetch("/api/order", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(order)
                    });

                    const result = await response.json();
                    if (response.ok) {
                        alert("Đặt hàng thành công! Mã đơn: " + (result.orderId || "Không rõ"));
                        localStorage.removeItem("selectedCartItems");
                        window.location.href = "/"; // hoặc trang cảm ơn
                    } else {
                        alert("Đặt hàng thất bại: " + (result.message || "Lỗi không xác định"));
                    }
                } catch (err) {
                    console.error(err);
                    alert("Đã có lỗi khi gửi đơn hàng.");
                } finally {
                    const btnOrder = document.getElementById("btn-order");
                    btnOrder.disabled = false;
                    btnOrder.innerText = "Đặt hàng";
                }
            });
        });
    </script>


