@*           // ====== Helpers ====== *@
@*           const CACHE_PREFIX = "tbs_checkout_"; *@
@*           const now = () => Date.now(); *@

@*           function setCache(key, value, ttlMs) { *@
@*             try { localStorage.setItem(CACHE_PREFIX + key, JSON.stringify({ value, exp: now() + ttlMs })); } catch {} *@
@*           } *@
@*           function getCache(key) { *@
@*             try { *@
@*               const raw = localStorage.getItem(CACHE_PREFIX + key); *@
@*               if (!raw) return null; *@
@*               const { value, exp } = JSON.parse(raw); *@
@*               if (!exp || exp < now()) { localStorage.removeItem(CACHE_PREFIX + key); return null; } *@
@*               return value; *@
@*             } catch { return null; } *@
@*           } *@

@*           // fetchJSON with timeout, retry, and external AbortController support *@
@*           async function fetchJSON(url, options = {}, timeoutMs = 12000, retries = 0) { *@
@*             let lastErr; *@
@*             for (let attempt = 0; attempt <= retries; attempt++) { *@
@*               const inner = new AbortController(); *@
@*               const outerSignal = options.signal; *@
@*               if (outerSignal && typeof outerSignal.addEventListener === "function") { *@
@*                 if (outerSignal.aborted) inner.abort(); *@
@*                 outerSignal.addEventListener("abort", () => inner.abort(), { once: true }); *@
@*               } *@
@*               const timer = setTimeout(() => inner.abort(), timeoutMs); *@
@*               try { *@
@*                 const res = await fetch(url, { ...options, signal: inner.signal }); *@
@*                 if (!res.ok) { *@
@*                   const msg = await res.text().catch(() => ""); *@
@*                   throw new Error(`HTTP ${res.status} ${res.statusText} - ${msg}`); *@
@*                 } *@
@*                 return await res.json(); *@
@*               } catch (e) { *@
@*                 lastErr = e; *@
@*                 if (attempt < retries) continue; *@
@*                 throw e; *@
@*               } finally { clearTimeout(timer); } *@
@*             } *@
@*             throw lastErr; *@
@*           } *@

@*           // Parse JSON an toàn: nếu server không trả JSON thì đọc text và ném lỗi rõ ràng *@
@*           async function safeParseJson(response) { *@
@*             const ct = response.headers.get("content-type") || ""; *@
@*             if (ct.includes("application/json")) { *@
@*               return await response.json(); *@
@*             } *@
@*             const text = await response.text(); *@
@*             throw new Error(text ? `Phản hồi không phải JSON: ${text.substring(0, 200)}...` : "Phản hồi rỗng từ server"); *@
@*           } *@

@*           // ====== Provinces (primary + fallback) ====== *@
@*           async function loadProvinces() { *@
@*             provinceSel.disabled = true; *@
@*             wardSel.disabled = true; *@
@*             provinceSel.innerHTML = "<option value=''>Đang tải tỉnh/thành...</option>"; *@
@*             wardSel.innerHTML = "<option value=''>Chọn phường/xã</option>"; *@
@*             try { *@
@*               const data = await fetchJSON("https://34tinhthanh.com/api/provinces", {}, 9000, 1); *@
@*               provinceSel.innerHTML = "<option value=''>Chọn tỉnh/thành</option>"; *@
@*               data.forEach(p => provinceSel.add(new Option(p.name, p.province_code))); *@
@*               provinceSel.dataset.source = "primary"; *@
@*             } catch (err) { *@
@*               console.warn("PRIMARY provinces lỗi, dùng fallback:", err); *@
@*               try { *@
@*                 const list = await fetchJSON("https://provinces.open-api.vn/api/?depth=1", {}, 9000, 1); *@
@*                 provinceSel.innerHTML = "<option value=''>Chọn tỉnh/thành</option>"; *@
@*                 list.forEach(p => provinceSel.add(new Option(p.name, p.code))); *@
@*                 provinceSel.dataset.source = "fallback"; *@
@*               } catch (err2) { *@
@*                 console.error("Fallback provinces cũng lỗi:", err2); *@
@*                 provinceSel.innerHTML = "<option value=''>Không tải được tỉnh/thành</option>"; *@
@*                 alert("Không thể tải danh sách tỉnh/thành. Vui lòng kiểm tra kết nối mạng."); *@
@*               } *@
@*             } finally { *@
@*               provinceSel.disabled = false; *@
@*               wardSel.disabled = false; *@
@*             } *@
@*           } *@

@*           // ====== Wards fast loader (race + abort + cache) ====== *@
@*           let wardReqSeq = 0; *@
@*           let wardAborters = []; *@
@*           function abortWardRequests() { *@
@*             wardAborters.forEach(a => { try { a.abort(); } catch {} }); *@
@*             wardAborters = []; *@
@*           } *@

@*           const SRC = { *@
@*             wards_primary: (provinceCode, { signal } = {}) => *@
@*               fetchJSON(`https://34tinhthanh.com/api/wards?province_code=${encodeURIComponent(provinceCode)}`, *@
@*                 { signal }, 8000, 1 *@
@*               ).then(list => list.map(w => ({ *@
@*                 code: String(w.ward_code), *@
@*                 name: w.has_merger *@
@*                   ? `${w.ward_name}${Array.isArray(w.old_units) && w.old_units.length ? ` (sáp nhập từ: ${w.old_units.join(", ")})` : " (đã sáp nhập)"}` *@
@*                   : w.ward_name *@
@*               }))), *@

@*             wards_fallback: (provinceCode, { signal } = {}) => *@
@*               fetchJSON(`https://provinces.open-api.vn/api/p/${encodeURIComponent(provinceCode)}?depth=2`, *@
@*                 { signal }, 7000, 1 *@
@*               ).then(p => { *@
@*                 const wards = []; *@
@*                 (p?.districts || []).forEach(d => (d?.wards || []).forEach(w => wards.push({ code: String(w.code), name: w.name }))); *@
@*                 wards.sort((a, b) => a.name.localeCompare(b.name, "vi")); *@
@*                 return wards; *@
@*               }) *@
@*           }; *@

@*           function renderWards(list) { *@
@*             wardSel.innerHTML = "<option value=''>Chọn phường/xã</option>"; *@
@*             for (const w of list) wardSel.add(new Option(w.name, w.code)); *@
@*           } *@
@*           const hasMergedLabels = (list) => list.some(w => typeof w.name === "string" && w.name.includes("sáp nhập")); *@

@*           async function refreshWardsUpgrade(provinceCode, cacheKey, mySeq) { *@
@*             const priCtrl = new AbortController(); *@
@*             wardAborters.push(priCtrl); *@
@*             try { *@
@*               const better = await SRC.wards_primary(provinceCode, { signal: priCtrl.signal }); *@
@*               if (mySeq !== wardReqSeq) return; *@
@*               if (better?.length) { *@
@*                 const currentVal = wardSel.value; *@
@*                 renderWards(better); *@
@*                 if (currentVal) wardSel.value = currentVal; *@
@*                 setCache(cacheKey, better, 30 * 24 * 60 * 60 * 1000); *@
@*               } *@
@*             } catch {} *@
@*           } *@

@*           async function loadWardsFast(provinceCode) { *@
@*             if (!provinceCode) { *@
@*               wardSel.innerHTML = "<option value=''>Chọn phường/xã</option>"; *@
@*               return; *@
@*             } *@

@*             abortWardRequests(); *@
@*             const mySeq = ++wardReqSeq; *@

@*             wardSel.disabled = true; *@
@*             wardSel.innerHTML = "<option value=''>Đang tải phường/xã...</option>"; *@

@*             const cacheKey = `wards_v1_${provinceCode}`; *@
@*             const cached = getCache(cacheKey); *@
@*             if (cached?.length) { *@
@*               renderWards(cached); *@
@*               wardSel.disabled = false; *@
@*               refreshWardsUpgrade(provinceCode, cacheKey, mySeq); *@
@*               return; *@
@*             } *@

@*             const priCtrl = new AbortController(); *@
@*             const fbCtrl  = new AbortController(); *@
@*             wardAborters.push(priCtrl, fbCtrl); *@

@*             const pri = SRC.wards_primary(provinceCode, { signal: priCtrl.signal }); *@
@*             const fb  = SRC.wards_fallback(provinceCode, { signal: fbCtrl.signal }); *@

@*             try { *@
@*               const first = await Promise.race([pri, fb]); *@
@*               if (mySeq !== wardReqSeq) return; *@
@*               renderWards(first); *@
@*               wardSel.disabled = false; *@
@*               setCache(cacheKey, first, 30 * 24 * 60 * 60 * 1000); *@
@*             } catch (e) {} *@

@*             try { *@
@*               const better = await pri; *@
@*               if (mySeq !== wardReqSeq) return; *@
@*               const currentVal = wardSel.value; *@
@*               const prevCount = wardSel.options.length - 1; *@
@*               if (better?.length && (better.length !== prevCount || hasMergedLabels(better))) { *@
@*                 renderWards(better); *@
@*                 if (currentVal) wardSel.value = currentVal; *@
@*                 setCache(cacheKey, better, 30 * 24 * 60 * 60 * 1000); *@
@*               } *@
@*             } catch {} *@
@*           } *@

@*           // ====== Bindings ====== *@
@*           loadProvinces(); *@

@*           let debTimer = null; *@
@*           provinceSel.addEventListener("change", () => { *@
@*             const code = provinceSel.value; *@
@*             clearTimeout(debTimer); *@
@*             debTimer = setTimeout(() => { *@
@*               if (!code) { wardSel.innerHTML = "<option value=''>Chọn phường/xã</option>"; return; } *@
@*               loadWardsFast(code); *@
@*             }, 150); *@
@*           }); *@

@*           if (provinceSel.value) loadWardsFast(provinceSel.value); *@

@*           function getShippingFee(provinceCode, provinceName) { *@
@*             if (!provinceCode && !provinceName) return 30000; // Default 30k *@

@*             // Get province name for calculation *@
@*             const name = provinceName || (provinceSel.options[provinceSel.selectedIndex]?.text || ""); *@

@*             // Distance-based shipping from Can Tho (30k-100k VND) *@
@*             const shippingRates = { *@
@*               // Can Tho and nearby provinces (30k) *@
@*               "Cần Thơ": 30000, *@
@*               "An Giang": 35000, *@
@*               "Kiên Giang": 40000, *@
@*               "Hậu Giang": 35000, *@
@*               "Sóc Trăng": 40000, *@
@*               "Bạc Liêu": 45000, *@
@*               "Cà Mau": 50000, *@
@*               "Đồng Tháp": 40000, *@
@*               "Long An": 45000, *@
@*               "Tiền Giang": 45000, *@
@*               "Bến Tre": 45000, *@
@*               "Trà Vinh": 45000, *@
@*               "Vĩnh Long": 40000, *@

@*               // Ho Chi Minh City and nearby (50k) *@
@*               "Hồ Chí Minh": 50000, *@
