@{
    ViewData["Title"] = "Thanh toán - The Bag Studio";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}
@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <link href="css/style.css" rel="stylesheet" />
}
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="@Url.Action("Index","User")">Trang chủ</a>
                <a class="breadcrumb-item text-dark" href="#">Trang</a>
                <span class="breadcrumb-item active">Thanh toán</span>
            </nav>
        </div>
    </div>
</div>
<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0 text-uppercase">Địa chỉ nhận hàng</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="customer-name" class="form-label">Tên người nhận</label>
                            <input id="customer-name" class="form-control" type="text"
                                   placeholder="Tên người nhận" value="@ViewBag.UserFullName" />
                        </div>
                        <div class="col-md-6">
                            <label for="customer-email" class="form-label">E-mail</label>
                            <input id="customer-email" class="form-control" type="email"
                                   placeholder="email@gmail.com" value="@ViewBag.UserEmail" />

                        </div>
                        <div class="col-md-6">
                            <label for="customer-phone" class="form-label">Số điện thoại</label>
                            <input id="customer-phone" class="form-control" type="text"
                                   placeholder="0123 456 789" value="@ViewBag.UserPhone" />
                        </div>
                        <div class="col-md-6">
                            <label for="province" class="form-label">Tỉnh/Thành phố</label>
                            <select id="province" class="form-select">
                                <option value="">Chọn tỉnh/thành</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="ward" class="form-label">Phường/Xã (bao gồm thông tin sáp nhập)</label>
                            <select id="ward" class="form-select">
                                <option value="">Chọn phường/xã</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="customer-address" class="form-label">Địa chỉ cụ thể</label>
                            <input id="customer-address" class="form-control" type="text" placeholder="Số nhà, tên đường" />
                        </div>
                        <div class="col-12">
                            <label for="order-note" class="form-label">Ghi chú đơn hàng</label>
                            <textarea id="order-note" class="form-control" rows="3" placeholder="Ghi chú cho đơn hàng (tùy chọn)"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0 text-uppercase">Tổng đơn hàng</h5>
                </div>
                <div class="card-body" id="checkoutCart">
                    <h6 class="mb-3 fw-bold">Sản phẩm đã chọn</h6>

                    <!-- COMBOBOX + KHUNG CHI TIẾT -->
                    <div class="mb-3">
                        <label class="small text-muted mb-1">Chọn sản phẩm</label>
                        <select id="checkoutItemsSelect" class="form-select" disabled></select>
                    </div>
                    <div id="checkoutItemDetail" class="border rounded p-2 bg-light small">
                        <em>Chưa có sản phẩm nào được chọn</em>
                    </div>

                    <!-- Khuyến mại -->
                    <div class="border-top pt-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Mã khuyến mại</span>
                            <button type="button" class="btn btn-link p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#promotionModal">
                                <i class="bi bi-percent me-1"></i>Chọn hoặc nhập mã
                            </button>
                        </div>
                        <div id="selectedPromotion" class="d-none">
                            <div class="bg-light p-2 rounded">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-success fw-bold" id="promotionCode"></small>
                                        <div class="small text-muted" id="promotionDescription"></div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removePromotion()">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tính tiền -->
                    <div class="border-top pt-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính</span>
                            <span id="checkoutSubtotal">0 VNĐ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-success d-none" id="discountRow">
                            <span>Giảm giá</span>
                            <span id="discountAmount">-0 VNĐ</span>
                        </div>
                        <!-- Phí ship sẽ được thêm động bằng JS (shippingRow) -->
                        <div class="d-flex justify-content-between">
                            <h5 class="fw-bold">Tổng cộng</h5>
                            <h5 id="checkoutTotal" class="text-danger fw-bold">0 VNĐ</h5>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0 text-uppercase">Phương thức thanh toán</h5>
                </div>
                <div class="card-body">
                    <div class="form-check mb-2">
                        <input type="radio" class="form-check-input" name="payment" id="cod" />
                        <label class="form-check-label" for="cod">Thanh toán khi nhận hàng</label>
                    </div>
                    <div class="form-check mb-3">
                        <input type="radio" class="form-check-input" name="payment" id="vnpay" />
                        <label class="form-check-label" for="vnpay">Thanh toán qua VNPay</label>
                    </div>
                    @* <div class="form-check mb-3"> *@
                    @*     <input type="radio" class="form-check-input" name="payment" id="bank" /> *@
                    @*     <label class="form-check-label" for="bank">Chuyển khoản ngân hàng</label> *@
                    @* </div> *@

                    <button id="btn-order" class="btn btn-danger w-100 fw-bold py-2">Đặt hàng</button>
                    <button id="vnpay-payment-btn" class="btn btn-primary w-100 fw-bold py-2 mt-2" style="display:none;">Thanh toán VNPay</button>

                    @if (TempData["PayOSError"] != null)
                    {
                        <div class="alert alert-danger mt-3">@TempData["PayOSError"]</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal khuyến mại -->
<div class="modal fade" id="promotionModal" tabindex="-1" aria-labelledby="promotionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="promotionModalLabel">Khuyến mại</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <div class="input-group">
                        <input type="text" class="form-control" id="promotionCodeInput" placeholder="Bạn có mã khuyến mại khác?">
                        <button class="btn btn-primary" type="button" onclick="applyPromotionCode()">Áp dụng</button>
                    </div>
                </div>

                <div id="promotionError" class="alert alert-danger d-none"></div>

                <div id="availablePromotions">
                    <h6 class="mb-3">Mã khuyến mại có sẵn</h6>
                    <div id="promotionsList" class="d-flex flex-column gap-2">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Đang tải...</span>
                            </div>
                            <div class="mt-2">Đang tải danh sách khuyến mại...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @if (ViewBag.BuyNowJson != null)
    {
        <script>
            (function () {
                try {
                    var it = @Html.Raw(ViewBag.BuyNowJson);
                    if (it) {
                        var selected = [{
                            variantId: it.VariantId,
                            ProductVariantId: it.VariantId,
                            name: it.Name,
                            color: it.Color,
                            size: it.Size,
                            price: Number(it.Price),
                            quantity: Number(it.Quantity),
                            total: Number(it.Price) * Number(it.Quantity),
                            categoryId: it.CategoryId,
                            thumbnail: it.Thumbnail
                        }];
                        localStorage.setItem("selectedCartItems", JSON.stringify(selected));
                    }
                } catch (e) { console.warn("BUY NOW parse error", e); }
            })();
        </script>
    }
    <script>
        // Helper toàn cục để đọc CSRF từ <meta>
        window.getCsrfToken = function () {
          const m = document.querySelector('meta[name="request-verification-token"]');
          return m ? (m.getAttribute('content') || '') : '';
        };
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
          // ====== Elements ======
          const btnOrder = document.getElementById("btn-order");
          const vnpayBtn = document.getElementById("vnpay-payment-btn");
          const provinceSel = document.getElementById("province");
          const wardSel = document.getElementById("ward");

          // COMBOBOX + DETAIL
          const itemsSelect = document.getElementById("checkoutItemsSelect");
          const itemDetail = document.getElementById("checkoutItemDetail");

          const checkoutTotal = document.getElementById("checkoutTotal");
          const checkoutSubtotal = document.getElementById("checkoutSubtotal");
          const discountRow = document.getElementById("discountRow");
          const discountAmount = document.getElementById("discountAmount");

          let selectedPromotion = null;
          let availablePromotions = [];
          let cartItems = [];

          provinceSel.dataset.source = "primary";

          // ====== Default: COD selected ======
          document.getElementById("cod").checked = true;
          btnOrder.style.display = "block";
          vnpayBtn.style.display = "none";

          // ====== Toggle payment buttons ======
          document.querySelectorAll('input[name="payment"]').forEach((r) => {
            r.addEventListener("change", (e) => {
              const id = e.target.id;
              if (id === "vnpay") {
                btnOrder.style.display = "none";
                vnpayBtn.style.display = "block";
              } else {
                btnOrder.style.display = "block";
                vnpayBtn.style.display = "none";
              }
            });
          });

          // ====== Helpers ======
          const CACHE_PREFIX = "tbs_checkout_";
          const now = () => Date.now();

          function setCache(key, value, ttlMs) {
            try { localStorage.setItem(CACHE_PREFIX + key, JSON.stringify({ value, exp: now() + ttlMs })); } catch {}
          }
          function getCache(key) {
            try {
              const raw = localStorage.getItem(CACHE_PREFIX + key);
              if (!raw) return null;
              const { value, exp } = JSON.parse(raw);
              if (!exp || exp < now()) { localStorage.removeItem(CACHE_PREFIX + key); return null; }
              return value;
            } catch { return null; }
          }

          async function fetchJSON(url, options = {}, timeoutMs = 12000, retries = 0) {
            let lastErr;
            for (let attempt = 0; attempt <= retries; attempt++) {
              const inner = new AbortController();
              const outerSignal = options.signal;
              if (outerSignal && typeof outerSignal.addEventListener === "function") {
                if (outerSignal.aborted) inner.abort();
                outerSignal.addEventListener("abort", () => inner.abort(), { once: true });
              }
              const timer = setTimeout(() => inner.abort(), timeoutMs);
              try {
                const res = await fetch(url, { ...options, signal: inner.signal });
                if (!res.ok) {
                  const msg = await res.text().catch(() => "");
                  throw new Error(`HTTP ${res.status} ${res.statusText} - ${msg}`);
                }
                return await res.json();
              } catch (e) {
                lastErr = e;
                if (attempt < retries) continue;
                throw e;
              } finally { clearTimeout(timer); }
            }
            throw lastErr;
          }

          async function safeParseJson(response) {
            const ct = response.headers.get("content-type") || "";
            if (ct.includes("application/json")) {
              return await response.json();
            }
            const text = await response.text();
            throw new Error(text ? `Phản hồi không phải JSON: ${text.substring(0, 200)}...` : "Phản hồi rỗng từ server");
          }

          // ====== Provinces (primary + fallback) ======
          async function loadProvinces() {
            provinceSel.disabled = true;
            wardSel.disabled = true;
            provinceSel.innerHTML = "<option value=''>Đang tải tỉnh/thành...</option>";
            wardSel.innerHTML = "<option value=''>Chọn phường/xã</option>";
            try {
              const data = await fetchJSON("https://34tinhthanh.com/api/provinces", {}, 9000, 1);
              provinceSel.innerHTML = "<option value=''>Chọn tỉnh/thành</option>";
              data.forEach(p => provinceSel.add(new Option(p.name, p.province_code)));
              provinceSel.dataset.source = "primary";
            } catch (err) {
              try {
                const list = await fetchJSON("https://provinces.open-api.vn/api/?depth=1", {}, 9000, 1);
                provinceSel.innerHTML = "<option value=''>Chọn tỉnh/thành</option>";
                list.forEach(p => provinceSel.add(new Option(p.name, p.code)));
                provinceSel.dataset.source = "fallback";
              } catch (err2) {
                provinceSel.innerHTML = "<option value=''>Không tải được tỉnh/thành</option>";
                alert("Không thể tải danh sách tỉnh/thành. Vui lòng kiểm tra kết nối mạng.");
              }
            } finally {
              provinceSel.disabled = false;
              wardSel.disabled = false;
            }
          }

          // ====== Wards (race + cache) ======
          let wardReqSeq = 0;
          let wardAborters = [];
          function abortWardRequests() { wardAborters.forEach(a => { try { a.abort(); } catch {} }); wardAborters = []; }

          const SRC = {
            wards_primary: (provinceCode, { signal } = {}) =>
              fetchJSON(`https://34tinhthanh.com/api/wards?province_code=${encodeURIComponent(provinceCode)}`,
                { signal }, 8000, 1
              ).then(list => list.map(w => ({
                code: String(w.ward_code),
                name: w.has_merger
                  ? `${w.ward_name}${Array.isArray(w.old_units) && w.old_units.length ? ` (sáp nhập từ: ${w.old_units.join(", ")})` : " (đã sáp nhập)"}`
                  : w.ward_name
              })) ),
            wards_fallback: (provinceCode, { signal } = {}) =>
              fetchJSON(`https://provinces.open-api.vn/api/p/${encodeURIComponent(provinceCode)}?depth=2`,
                { signal }, 7000, 1
              ).then(p => {
                const wards = [];
                (p?.districts || []).forEach(d => (d?.wards || []).forEach(w => wards.push({ code: String(w.code), name: w.name })));
                wards.sort((a, b) => a.name.localeCompare(a.name, "vi"));
                return wards;
              })
          };

          function renderWards(list) {
            wardSel.innerHTML = "<option value=''>Chọn phường/xã</option>";
            for (const w of list) wardSel.add(new Option(w.name, w.code));
          }
          async function refreshWardsUpgrade(provinceCode, cacheKey, mySeq) {
            const priCtrl = new AbortController(); wardAborters.push(priCtrl);
            try {
              const better = await SRC.wards_primary(provinceCode, { signal: priCtrl.signal });
              if (mySeq !== wardReqSeq) return;
              if (better?.length) {
                const currentVal = wardSel.value;
                renderWards(better);
                if (currentVal) wardSel.value = currentVal;
                setCache(cacheKey, better, 30 * 24 * 60 * 60 * 1000);
              }
            } catch {}
          }
          async function loadWardsFast(provinceCode) {
            if (!provinceCode) { wardSel.innerHTML = "<option value=''>Chọn phường/xã</option>"; return; }
            abortWardRequests();
            const mySeq = ++wardReqSeq;
            wardSel.disabled = true;
            wardSel.innerHTML = "<option value=''>Đang tải phường/xã...</option>";
            const cacheKey = `wards_v1_${provinceCode}`;
            const cached = getCache(cacheKey);
            if (cached?.length) {
              renderWards(cached);
              wardSel.disabled = false;
              refreshWardsUpgrade(provinceCode, cacheKey, mySeq);
              return;
            }
            const priCtrl = new AbortController(), fbCtrl = new AbortController();
            wardAborters.push(priCtrl, fbCtrl);
            const pri = SRC.wards_primary(provinceCode, { signal: priCtrl.signal });
            const fb  = SRC.wards_fallback(provinceCode, { signal: fbCtrl.signal });
            try {
              const first = await Promise.race([pri, fb]);
              if (mySeq !== wardReqSeq) return;
              renderWards(first);
              wardSel.disabled = false;
              setCache(cacheKey, first, 30 * 24 * 60 * 60 * 1000);
            } catch (e) {}
            try {
              const better = await pri;
              if (mySeq !== wardReqSeq) return;
              const currentVal = wardSel.value;
              if (better?.length) {
                renderWards(better);
                if (currentVal) wardSel.value = currentVal;
                setCache(cacheKey, better, 30 * 24 * 60 * 60 * 1000);
              }
            } catch {}
          }

          // ====== Bindings ======
          loadProvinces();
          let debTimer = null;
          provinceSel.addEventListener("change", () => {
            const code = provinceSel.value;
            clearTimeout(debTimer);
            debTimer = setTimeout(() => { if (!code) { wardSel.innerHTML = "<option value=''>Chọn phường/xã</option>"; return; } loadWardsFast(code); }, 150);
            setTimeout(renderCheckout, 200);
          });
          if (provinceSel.value) loadWardsFast(provinceSel.value);

          // ====== Ship fee ======
          function getShippingFee(provinceCode, provinceName) {
            if (!provinceCode && !provinceName) return 30000;
            const name = provinceName || (provinceSel.options[provinceSel.selectedIndex]?.text || "");
            const shippingRates = {
              "Cần Thơ": 30000, "An Giang": 35000, "Kiên Giang": 40000, "Hậu Giang": 35000,
              "Sóc Trăng": 40000, "Bạc Liêu": 45000, "Cà Mau": 50000, "Đồng Tháp": 40000,
              "Long An": 45000, "Tiền Giang": 45000, "Bến Tre": 45000, "Trà Vinh": 45000, "Vĩnh Long": 40000,
              "Hồ Chí Minh": 50000, "Tây Ninh": 55000, "Bình Dương": 50000, "Đồng Nai": 55000, "Bà Rịa - Vũng Tàu": 60000, "Bình Phước": 60000,
              "Lâm Đồng": 65000, "Đắk Lắk": 70000, "Đắk Nông": 70000, "Gia Lai": 75000, "Kon Tum": 80000, "Khánh Hòa": 70000,
              "Ninh Thuận": 70000, "Bình Thuận": 65000, "Phú Yên": 75000, "Bình Định": 75000, "Quảng Ngãi": 80000,
              "Quảng Nam": 80000, "Đà Nẵng": 75000, "Thừa Thiên Huế": 80000, "Quảng Trị": 85000, "Quảng Bình": 85000,
              "Hà Tĩnh": 90000, "Nghệ An": 90000, "Thanh Hóa": 90000,
              "Ninh Bình": 85000, "Nam Định": 90000, "Thái Bình": 90000, "Hưng Yên": 85000, "Hà Nam": 85000,
              "Hà Nội": 90000, "Vĩnh Phúc": 85000, "Bắc Ninh": 85000, "Hải Dương": 90000, "Hải Phòng": 90000,
              "Quảng Ninh": 95000, "Bắc Giang": 90000, "Lạng Sơn": 100000, "Cao Bằng": 100000, "Hà Giang": 100000,
              "Tuyên Quang": 95000, "Thái Nguyên": 90000, "Phú Thọ": 90000, "Yên Bái": 95000,
              "Lào Cai": 100000, "Điện Biên": 100000, "Lai Châu": 100000, "Sơn La": 95000, "Hòa Bình": 90000
            };
            for (const [province, fee] of Object.entries(shippingRates)) {
              if (name.includes(province)) return fee;
            }
            return 60000;
          }

          // ====== COMBOBOX detail render ======
          function renderItemDetail(index) {
            if (index == null || !cartItems.length) {
              itemDetail.innerHTML = "<em>Chưa có sản phẩm nào được chọn</em>";
              return;
            }
            const it = cartItems[index];
            const total = (it.total || (it.price * it.quantity)) || 0;
            itemDetail.innerHTML = `
              <div class="border-bottom mb-2 pb-2">
                <h6 class="mb-1">${it.name}</h6>
                <div class="small text-muted">Màu: ${it.color ?? ""} &middot; Size: ${it.size ?? ""}</div>
                <div class="small">SL: <strong>${it.quantity}</strong></div>
                <div class="small">Giá: ${Number(it.price).toLocaleString("vi-VN")} VNĐ</div>
                <div class="small fw-semibold">Tổng: ${Number(total).toLocaleString("vi-VN")} VNĐ</div>
              </div>`;
          }

          // ====== Tổng kết + combobox ======
          function ensureShipRow() {
            let shipRowEl = document.getElementById('shippingRow');
            if (shipRowEl) return shipRowEl;
            const wrap = document.querySelector('#checkoutCart .border-top.pt-3');
            shipRowEl = document.createElement('div');
            shipRowEl.className = 'd-flex justify-content-between mb-2';
            shipRowEl.id = 'shippingRow';
            shipRowEl.innerHTML = `<span>Phí vận chuyển</span><span id="shippingFee">0 VNĐ</span>`;
            const totalH5 = document.querySelector('#checkoutTotal')?.parentElement;
            if (totalH5 && totalH5.parentElement === wrap) wrap.insertBefore(shipRowEl, totalH5); else wrap.appendChild(shipRowEl);
            return shipRowEl;
          }

          function calculateDiscount(promotion, subtotal) {
            if (!promotion || subtotal < promotion.minOrderValue) return 0;
            if (promotion.discountType === 'percentage') {
              const discount = (subtotal * promotion.discountValue) / 100;
              return Math.min(discount, promotion.maxDiscountAmount || discount);
            }
            return Math.min(promotion.discountValue, subtotal);
          }

          function getCartCategories() {
            const categories = new Set();
            cartItems.forEach(item => { if (item.categoryId) categories.add(item.categoryId); });
            return Array.from(categories);
          }
          function canUsePromotion(promotion) {
            const now = new Date();
            const startDate = new Date(promotion.startDate);
            const endDate = new Date(promotion.endDate);
            if (now < startDate || now > endDate) return false;
            if (promotion.usageLimit && promotion.usedCount >= promotion.usageLimit) return false;
            if (promotion.status === 0) return true;
            const cartCategories = getCartCategories();
            return cartCategories.includes(promotion.status);
          }

          // ====== Render checkout (with combobox) ======
          function renderCheckout() {
            cartItems = JSON.parse(localStorage.getItem("selectedCartItems") || "[]");

            // Build combobox
            itemsSelect.innerHTML = "";
            let subtotal = 0;

            if (cartItems.length === 0) {
              itemsSelect.disabled = true;
              itemDetail.innerHTML = "<em>Không có sản phẩm được chọn.</em>";
            } else {
              cartItems.forEach((it, idx) => {
                const total = (it.total || (it.price * it.quantity)) || 0;
                subtotal += total;
                const text = `${it.name} (${it.quantity} x ${Number(it.price).toLocaleString("vi-VN")} VNĐ)`;
                itemsSelect.add(new Option(text, idx));
              });
              itemsSelect.disabled = false;
              itemsSelect.selectedIndex = 0;
              renderItemDetail(0);
            }

            checkoutSubtotal.textContent = Number(subtotal).toLocaleString("vi-VN") + " VNĐ";

            const provinceName = provinceSel.options[provinceSel.selectedIndex]?.text || "";
            let shippingFee = getShippingFee(provinceSel.value, provinceName);
            let discount = 0, shippingDiscount = 0;

            if (selectedPromotion) {
              if (selectedPromotion.discountType === 'free_shipping') {
                shippingDiscount = shippingFee; shippingFee = 0;
              } else {
                discount = calculateDiscount(selectedPromotion, subtotal);
              }
              discountAmount.textContent = "-" + Number(discount + shippingDiscount).toLocaleString("vi-VN") + " VNĐ";
              discountRow.classList.remove("d-none");
            } else {
              discountRow.classList.add("d-none");
            }

            ensureShipRow();
            const shippingFeeEl = document.getElementById('shippingFee');
            if (shippingFeeEl) shippingFeeEl.textContent = Number(shippingFee).toLocaleString('vi-VN') + ' VNĐ';

            const finalTotal = subtotal + shippingFee - discount;
            checkoutTotal.textContent = Number(finalTotal).toLocaleString("vi-VN") + " VNĐ";

            // Save totals for server
            const totals = { subtotal, shippingFee: shippingFee + shippingDiscount, discount: discount + shippingDiscount, finalTotal };
            localStorage.setItem('tbs_checkout_totals', JSON.stringify(totals));
          }

          // Combobox change -> đổi khung chi tiết
          itemsSelect.addEventListener("change", function () {
            const idx = parseInt(this.value);
            renderItemDetail(idx);
          });

          // ====== Khuyến mại ======
          async function loadPromotions() {
            try {
              const response = await fetch('/api/promotions/active', { method: 'GET', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
              if (!response.ok) throw new Error(`HTTP ${response.status}: ${response.statusText}`);
              const result = await response.json();
              if (result.success) { availablePromotions = result.data || []; renderPromotionsList(); }
              else throw new Error(result.message || 'Không thể tải danh sách khuyến mại');
            } catch (error) {
              document.getElementById('promotionsList').innerHTML = `
                <div class="text-center py-4 text-danger">
                  <i class="bi bi-exclamation-triangle fs-1"></i>
                  <div class="mt-2">Lỗi tải khuyến mại: ${error.message}</div>
                  <button class="btn btn-sm btn-outline-primary mt-2" onclick="loadPromotions()">Thử lại</button>
                </div>`;
            }
          }
          function getCategoryName(categoryId) {
            const names = { 5: 'Phụ kiện', 8: 'Túi du lịch', 1002: 'Túi xách công sở', 1003: 'Túi xách thời trang' };
            return names[categoryId] || 'Danh mục khác';
          }
          function renderPromotionsList() {
            const container = document.getElementById('promotionsList');
            if (availablePromotions.length === 0) {
              container.innerHTML = `<div class="text-center py-4 text-muted"><i class="bi bi-percent fs-1"></i><div class="mt-2">Hiện không có chương trình khuyến mại nào</div></div>`;
              return;
            }
            container.innerHTML = '';
            availablePromotions.forEach(promotion => {
              const canUse = canUsePromotion(promotion);
              const isSelected = selectedPromotion && selectedPromotion.promotionId === promotion.promotionId;
              const card = document.createElement('div');
              card.className = `card ${canUse ? 'border-primary' : 'border-secondary'} ${!canUse ? 'opacity-50' : ''} ${isSelected ? 'bg-primary bg-opacity-10' : ''}`;
              card.style.cursor = canUse ? 'pointer' : 'not-allowed';
              const discountText = promotion.discountType === 'percentage'
                ? `Giảm ${promotion.discountValue}%${promotion.maxDiscountAmount ? ` (tối đa ${Number(promotion.maxDiscountAmount).toLocaleString('vi-VN')} VNĐ)` : ''}`
                : promotion.discountType === 'free_shipping' ? 'Miễn phí vận chuyển'
                : `Giảm ${Number(promotion.discountValue).toLocaleString('vi-VN')} VNĐ`;
              const categoryText = promotion.status === 0 ? 'Tất cả sản phẩm' : getCategoryName(promotion.status);
              card.innerHTML = `
                <div class="card-body p-3">
                  <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                      <h6 class="card-title mb-1 ${canUse ? 'text-primary' : 'text-muted'}">${promotion.promotionCode}</h6>
                      <p class="card-text small mb-1">${promotion.description || discountText}</p>
                      <div class="small text-muted">
                        <div>Áp dụng: ${categoryText}</div>
                        <div>Đơn tối thiểu: ${Number(promotion.minOrderValue || 0).toLocaleString('vi-VN')} VNĐ</div>
                        <div>HSD: ${new Date(promotion.endDate).toLocaleDateString('vi-VN')}</div>
                      </div>
                    </div>
                    <div class="text-end">
                      ${isSelected ? '<i class="bi bi-check-circle-fill text-success fs-5"></i>' : ''}
                      ${!canUse ? '<i class="bi bi-lock-fill text-muted"></i>' : ''}
                    </div>
                  </div>
                </div>`;
              if (canUse) card.addEventListener('click', () => selectPromotion(promotion));
              container.appendChild(card);
            });
          }
          function selectPromotion(promotion) {
            selectedPromotion = promotion;
            document.getElementById('promotionCode').textContent = promotion.promotionCode;
            document.getElementById('promotionDescription').textContent =
              promotion.description ||
              (promotion.discountType === 'percentage'
                ? `Giảm ${promotion.discountValue}%`
                : promotion.discountType === 'free_shipping'
                  ? 'Miễn phí vận chuyển'
                  : `Giảm ${Number(promotion.discountValue).toLocaleString('vi-VN')} VNĐ`);
            document.getElementById('selectedPromotion').classList.remove('d-none');
            renderCheckout();
            renderPromotionsList();
            const modal = bootstrap.Modal.getInstance(document.getElementById('promotionModal'));
            modal.hide();
          }
          window.removePromotion = function() { selectedPromotion = null; document.getElementById('selectedPromotion').classList.add('d-none'); renderCheckout(); renderPromotionsList(); }
          window.applyPromotionCode = async function() {
            const code = document.getElementById('promotionCodeInput').value.trim();
            const errorDiv = document.getElementById('promotionError');
            if (!code) { showPromotionError('Vui lòng nhập mã khuyến mại'); return; }
            try {
              const response = await fetch(`/api/promotions/validate/${encodeURIComponent(code)}`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cartItems: cartItems.map(i => ({ categoryId: i.categoryId, quantity: i.quantity, price: i.price })) })
              });
              const result = await response.json();
              if (result.success && result.data) {
                selectPromotion(result.data);
                document.getElementById('promotionCodeInput').value = '';
                errorDiv.classList.add('d-none');
              } else {
                showPromotionError(result.message || 'Mã khuyến mại không hợp lệ hoặc không áp dụng được cho đơn hàng này');
              }
            } catch (error) {
              showPromotionError('Có lỗi xảy ra khi kiểm tra mã khuyến mại');
            }
          }
          function showPromotionError(message) {
            const errorDiv = document.getElementById('promotionError');
            errorDiv.textContent = message;
            errorDiv.classList.remove('d-none');
          }
          document.getElementById('promotionModal').addEventListener('show.bs.modal', function() {
            if (availablePromotions.length === 0) loadPromotions();
          });

          // Khởi tạo
          renderCheckout();

          // ===================== VALIDATION (thuần JS) =====================
          // Bảo đảm invalid-feedback hiển thị
          const style = document.createElement('style');
          style.textContent = `.invalid-feedback{display:block}`;
          document.head.appendChild(style);

          const vFields = {
            name:    document.getElementById("customer-name"),
            email:   document.getElementById("customer-email"),
            phone:   document.getElementById("customer-phone"),
            address: document.getElementById("customer-address"),
            province:document.getElementById("province"),
            ward:    document.getElementById("ward")
          };
          function ensureErrorBox(el){
            if (!el) return null;
            const next = el.nextElementSibling;
            if (next && next.classList && next.classList.contains('invalid-feedback')) return next;
            const div = document.createElement('div');
            div.className = 'invalid-feedback';
            el.insertAdjacentElement('afterend', div);
            return div;
          }
          function setError(el, msg){
            const box = ensureErrorBox(el);
            if (!el) return false;
            if (msg){
              el.classList.add('is-invalid');
              if (box) box.textContent = msg;
              return false;
            } else {
              el.classList.remove('is-invalid');
              if (box) box.textContent = '';
              return true;
            }
          }
          const VN_PHONE = /^(?:\+84|0)(?:3|5|7|8|9)\d{8}$/;
          const EMAIL_RX = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;

          function validateName(){
            const v = (vFields.name.value || '').trim();
            return setError(vFields.name, v.length >= 2 ? '' : 'Vui lòng nhập tên hợp lệ');
          }
          function validateEmail(){
            const v = (vFields.email.value || '').trim();
            if (!v) return setError(vFields.email, 'Vui lòng nhập email');
            return setError(vFields.email, EMAIL_RX.test(v) ? '' : 'Email không hợp lệ');
          }
          function validatePhone(){
            const raw = (vFields.phone.value || '').replace(/[^\d+]/g,'').trim();
            return setError(vFields.phone, VN_PHONE.test(raw) ? '' : 'Số điện thoại VN không hợp lệ');
          }
          function validateProvince(){
            const ok = !!vFields.province.value;
            return setError(vFields.province, ok ? '' : 'Vui lòng chọn Tỉnh/Thành phố');
          }
          function validateWard(){
            const ok = !!vFields.ward.value;
            return setError(vFields.ward, ok ? '' : 'Vui lòng chọn Phường/Xã');
          }
          function validateAddress(){
            const v = (vFields.address.value || '').trim();
            return setError(vFields.address, v.length >= 5 ? '' : 'Vui lòng nhập địa chỉ chi tiết (≥ 5 ký tự)');
          }
          function scrollToFirstError(){
            const firstInvalid = document.querySelector('.is-invalid');
            if (firstInvalid){
              firstInvalid.scrollIntoView({ behavior:'smooth', block:'center' });
              firstInvalid.focus({ preventScroll:true });
            }
          }
          function validateCheckout(){
            const results = [
              validateName(),
              validateEmail(),
              validatePhone(),
              validateProvince(),
              validateWard(),
              validateAddress()
            ];
            const ok = results.every(Boolean);
            if (!ok) scrollToFirstError();
            return ok;
          }
          // Live validation
          ['input','blur','change'].forEach(evt=>{
            vFields.name.addEventListener(evt, validateName);
            vFields.email.addEventListener(evt, validateEmail);
            vFields.phone.addEventListener(evt, validatePhone);
            vFields.address.addEventListener(evt, validateAddress);
          });
          vFields.province.addEventListener('change', () => { validateProvince(); validateWard(); });
          vFields.ward.addEventListener('change', validateWard);
          vFields.phone.addEventListener('blur', () => {
            vFields.phone.value = (vFields.phone.value || '').replace(/[^\d+]/g,'');
          });

          // ===================== VNPay =====================
          vnpayBtn.addEventListener("click", async (e) => {
            e.preventDefault();
            if (!validateCheckout()) return;

            const selectedItems = JSON.parse(localStorage.getItem("selectedCartItems") || "[]");
            if (selectedItems.length === 0) {
              alert("Không có sản phẩm được chọn!");
              return;
            }
            const customerName = document.getElementById("customer-name").value.trim();
            const customerPhone = document.getElementById("customer-phone").value.trim();
            const customerAddress = document.getElementById("customer-address").value.trim();
            const orderNote = document.getElementById("order-note").value || "";

            const provinceName = provinceSel.options[provinceSel.selectedIndex]?.text || "";
            const wardName = wardSel.options[wardSel.selectedIndex]?.text || "";
            const fullAddress = `${customerAddress}, ${wardName}, ${provinceName}`;
            const totals = JSON.parse(localStorage.getItem('tbs_checkout_totals') || '{}');
            const paymentData = {
              customerName, customerPhone, fullAddress, orderNote,
              items: selectedItems.map(i => ({ variantId: i.variantId || i.ProductVariantId, quantity: i.quantity, price: i.price })),
              PromoCode: selectedPromotion?.promotionId ?? null,
              promotionType: selectedPromotion?.discountType || null,
              discountAmount: totals.discount || 0,
              shippingFee: totals.shippingFee || 0
            };
            try {
              vnpayBtn.disabled = true; vnpayBtn.innerText = "Đang xử lý...";
              const response = await fetch("/VNPay/CreatePaymentFromCheckout", {
                method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(paymentData)
              });
              const result = await safeParseJson(response);
              if (result.success && result.paymentUrl) window.location.href = result.paymentUrl;
              else alert(result.message || "Có lỗi xảy ra khi tạo thanh toán!");
            } catch (error) {
              alert(error.message || "Có lỗi xảy ra khi kết nối server!");
            } finally { vnpayBtn.disabled = false; vnpayBtn.innerText = "Thanh toán VNPay"; }
          });

               // ===================== Tạo đơn COD =====================
        btnOrder.addEventListener("click", async () => {
          const items = JSON.parse(localStorage.getItem("selectedCartItems") || "[]");
          if (items.length === 0) { alert("Giỏ hàng rỗng!"); return; }
          if (!validateCheckout()) return;

          let paymentMethod = null;
          if (document.getElementById("cod").checked)  paymentMethod = 1;
          if (document.getElementById("bank")?.checked) paymentMethod = 2;
          if (!paymentMethod) { alert("Vui lòng chọn phương thức thanh toán!"); return; }

          const name    = document.getElementById("customer-name").value.trim();
          const phone   = document.getElementById("customer-phone").value.trim();
          const address = document.getElementById("customer-address").value.trim();
          const orderNote = document.getElementById("order-note").value || "";

          const provinceName = provinceSel.options[provinceSel.selectedIndex]?.text || "";
          const wardName = wardSel.options[wardSel.selectedIndex]?.text || "";
          const fullAddress = `${address}, ${wardName}, ${provinceName}`;

          const totals = JSON.parse(localStorage.getItem('tbs_checkout_totals') || '{}');
          const payload = {
            CustomerName: name, CustomerPhone: phone, FullAddress: fullAddress, OrderNote: orderNote, PaymentMethod: paymentMethod,
            Items: items.map(it => ({ VariantId: it.variantId || it.ProductVariantId, Quantity: it.quantity, Price: it.price })),
            PromoCode: selectedPromotion?.promotionId ?? null,
            PromotionType: selectedPromotion?.discountType || null,
            DiscountAmount: totals.discount || 0,
            ShippingFee: totals.shippingFee || 0
          };

          try {
            btnOrder.disabled = true;
            btnOrder.innerText = paymentMethod === 1 ? "Đang tạo đơn COD..." : "Đang tạo đơn (Chuyển khoản)...";

            const res = await fetch("/User/CreateCashOrder", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": getCsrfToken()   // <<< THÊM TOKEN
              },
              body: JSON.stringify(payload)
            });

            const result = await safeParseJson(res);
            if (!res.ok || !result?.success) throw new Error(result?.message || "Tạo đơn hàng thất bại");

            localStorage.removeItem("selectedCartItems");
            localStorage.removeItem("tbs_checkout_totals");

            if (result.redirectUrl) window.location.href = result.redirectUrl;
            else if (result.orderId) window.location.href = `/User/OrderDetail/${encodeURIComponent(result.orderId)}`;
                  showOrderSuccessForm(result.message || "Đặt hàng thành công!", "/User/Orders", 5); // tự chuyển sau 5s
          } catch (err) {
            alert(err.message || "Có lỗi xảy ra khi tạo đơn hàng!");
          } finally {
            btnOrder.disabled = false; btnOrder.innerText = "Đặt hàng";
          }
          });
        });


        // Hiện form thành công; nếu autoRedirectSec > 0 sẽ tự chuyển trang sau X giây
        function showOrderSuccessForm(message, redirectUrl = "/User/Orders", autoRedirectSec = 0) {
          document.getElementById("orderSuccessMsg").textContent =
            message || "Đặt hàng thành công! Đơn hàng sẽ được giao trong thời gian sớm nhất.";

          const goBtn = document.getElementById("orderSuccessGoBtn");
          const cdLbl = document.getElementById("orderSuccessCountdown");
          goBtn.href = redirectUrl;

          const modal = new bootstrap.Modal(document.getElementById("orderSuccessModal"), {
            backdrop: "static", keyboard: false
          });
          modal.show();

          // Tuỳ chọn: đếm ngược & tự redirect
          let timerId = null;
          if (autoRedirectSec > 0) {
            let remain = autoRedirectSec;
            cdLbl.classList.remove("d-none");
            cdLbl.textContent = `Sẽ chuyển đến trang đơn hàng sau ${remain}s...`;
            timerId = setInterval(() => {
              remain--;
              cdLbl.textContent = `Sẽ chuyển đến trang đơn hàng sau ${remain}s...`;
              if (remain <= 0) {
                clearInterval(timerId);
                window.location.href = redirectUrl;
              }
            }, 1000);
            // nếu người dùng đóng modal thì hủy đếm ngược
            document.getElementById("orderSuccessModal")
              .addEventListener("hidden.bs.modal", () => timerId && clearInterval(timerId), { once: true });
          } else {
            cdLbl.classList.add("d-none");
          }
        }

    </script>
}

<!-- Modal thông báo đặt hàng -->
<div class="modal fade" id="orderSuccessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Đặt hàng thành công</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p id="orderSuccessMsg">Đơn hàng sẽ được giao trong thời gian sớm nhất.</p>
                <small class="text-muted d-none" id="orderSuccessCountdown"></small>
            </div>
            <div class="modal-footer">
                <a id="orderSuccessGoBtn" href="/User/Orders" class="btn btn-success">Xem đơn hàng</a>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Ở lại trang</button>
            </div>
        </div>
    </div>
</div>
