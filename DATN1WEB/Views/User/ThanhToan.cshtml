@{
    ViewData["Title"] = "Thanh toán - The Bag Studio";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}
@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <link href="css/style.css" rel="stylesheet" />
}
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="@Url.Action("Index","User")">Trang chủ</a>
                <a class="breadcrumb-item text-dark" href="#">Trang</a>
                <span class="breadcrumb-item active">Thanh toán</span>
            </nav>
        </div>
    </div>
</div>
<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0 text-uppercase">Địa chỉ nhận hàng</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="customer-name" class="form-label">Tên người nhận</label>
                            <input id="customer-name" class="form-control" type="text" placeholder="Tên người nhận" />
                        </div>
                        <div class="col-md-6">
                            <label for="customer-email" class="form-label">E-mail</label>
                            <input id="customer-email" class="form-control" type="email" placeholder="email@gmail.com" />
                        </div>
                        <div class="col-md-6">
                            <label for="customer-phone" class="form-label">Số điện thoại</label>
                            <input id="customer-phone" class="form-control" type="text" placeholder="0123 456 789" />
                        </div>
                        <div class="col-md-6">
                            <label for="province" class="form-label">Tỉnh/Thành phố</label>
                            <select id="province" class="form-select">
                                <option value="">Chọn tỉnh/thành</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="ward" class="form-label">Phường/Xã (bao gồm thông tin sáp nhập)</label>
                            <select id="ward" class="form-select">
                                <option value="">Chọn phường/xã</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="customer-address" class="form-label">Địa chỉ cụ thể</label>
                            <input id="customer-address" class="form-control" type="text" placeholder="Số nhà, tên đường" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0 text-uppercase">Tổng đơn hàng</h5>
                </div>
                <div class="card-body" id="checkoutCart">
                    <h6 class="mb-3 fw-bold">Sản phẩm đã chọn</h6>
                    <div id="checkoutItems" class="mb-3"></div>
                    <div class="border-top pt-3">
                        <div class="d-flex justify-content-between">
                            <h5 class="fw-bold">Tổng cộng</h5>
                            <h5 id="checkoutTotal" class="text-danger fw-bold">0 VNĐ</h5>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0 text-uppercase">Phương thức thanh toán</h5>
                </div>
                <div class="card-body">
                    <div class="form-check mb-2">
                        <input type="radio" class="form-check-input" name="payment" id="cod" />
                        <label class="form-check-label" for="cod">Thanh toán khi nhận hàng</label>
                    </div>
                    <div class="form-check mb-3">
                        <input type="radio" class="form-check-input" name="payment" id="vnpay" />
                        <label class="form-check-label" for="vnpay">Thanh toán qua VnPay</label>
                    </div>
                    <div class="form-check mb-3">
                        <input type="radio" class="form-check-input" name="payment" id="bank" />
                        <label class="form-check-label" for="bank">Chuyển khoản ngân hàng</label>
                    </div>
                    <button id="btn-order" class="btn btn-danger w-100 fw-bold py-2">Đặt hàng</button>
                    <form asp-controller="User" asp-action="ThanhToanQuaPayOS" method="post">
                        <button type="submit" class="btn btn-success w-100 mt-3">Thanh toán với PayOS</button>
                    </form>
                    <form asp-controller="Payment" asp-action="CreatePaymentUrlVnpay" method="post" id="vnpayForm" style="display: none;">
                        <button type="submit" class="btn btn-primary w-100 mt-3" id="vnpayBtn">Thanh toán với VnPay</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
          // ====== Elements ======
          const btnOrder     = document.getElementById("btn-order");
          const vnpayForm    = document.getElementById("vnpayForm");
          const provinceSel  = document.getElementById("province");
          const wardSel      = document.getElementById("ward");
          const checkoutItems = document.getElementById("checkoutItems");
          const checkoutTotal = document.getElementById("checkoutTotal");

          // ====== Toggle VNPAY button ======
          document.querySelectorAll('input[name="payment"]').forEach((r) => {
            r.addEventListener("change", (e) => {
              vnpayForm.style.display = (e.target.id === "vnpay") ? "block" : "none";
            });
          });

          // ====== Load provinces / wards ======
          async function loadProvinces() {
            try {
              const res = await fetch("https://34tinhthanh.com/api/provinces");
              if (!res.ok) throw new Error("Không thể tải danh sách tỉnh/thành");
              const data = await res.json();
              data.forEach(p => provinceSel.add(new Option(p.name, p.province_code)));
            } catch (err) {
              console.error("Lỗi khi tải tỉnh/thành:", err);
              alert("Không thể tải tỉnh/thành. Kiểm tra kết nối.");
            }
          }

          async function loadWards(provinceCode) {
            try {
              const res = await fetch(`https://34tinhthanh.com/api/wards?province_code=${provinceCode}`);
              if (!res.ok) throw new Error("Không thể tải danh sách phường/xã");
              const data = await res.json();
              wardSel.innerHTML = "<option value=''>Chọn phường/xã</option>";
              data.forEach(w => {
                let label = w.ward_name;
                if (w.has_merger) label += ` (sáp nhập từ: ${w.old_units.join(", ")})`;
                wardSel.add(new Option(label, w.ward_code));
              });
            } catch (err) {
              console.error("Lỗi khi tải phường/xã:", err);
              alert("Không thể tải phường/xã.");
            }
          }

          loadProvinces();
          provinceSel.addEventListener("change", () => {
            const code = provinceSel.value;
            if (!code) { wardSel.innerHTML = "<option value=''>Chọn phường/xã</option>"; return; }
            loadWards(code);
          });

          // ====== Render checkout summary ======
          (function renderCheckout() {
            const items = JSON.parse(localStorage.getItem("selectedCartItems") || "[]");
            let total = 0;
            if (items.length === 0) {
              checkoutItems.innerHTML = "<p>Không có sản phẩm được chọn.</p>";
            } else {
              checkoutItems.innerHTML = "";
              items.forEach(item => {
                total += (item.total || (item.price * item.quantity));
                checkoutItems.innerHTML += `
                  <div class="border-bottom mb-2 pb-2">
                    <h6 class="mb-1">${item.name}</h6>
                    <div class="small text-muted">Màu: ${item.color} &middot; Size: ${item.size}</div>
                    <div class="small">SL: ${item.quantity}</div>
                    <div class="small">Giá: ${Number(item.price).toLocaleString("vi-VN")} VNĐ</div>
                    <div class="small fw-semibold">Tổng: ${Number(item.total || (item.price * item.quantity)).toLocaleString("vi-VN")} VNĐ</div>
                  </div>`;
              });
            }
            checkoutTotal.textContent = Number(total).toLocaleString("vi-VN") + " VNĐ";
          })();

          // ====== Place order ======
          btnOrder.addEventListener("click", async () => {
            const items = JSON.parse(localStorage.getItem("selectedCartItems") || "[]");
            if (items.length === 0) { alert("Giỏ hàng rỗng!"); return; }

            const name    = (document.getElementById("customer-name").value || "").trim();
            const phone   = (document.getElementById("customer-phone").value || "").trim();
            const address = (document.getElementById("customer-address").value || "").trim();

            const provinceCode = provinceSel.value;
            const wardCode     = wardSel.value;
            const provinceName = provinceSel.options[provinceSel.selectedIndex]?.text?.trim() || "";
            const wardName     = wardSel.options[wardSel.selectedIndex]?.text?.trim() || "";

            if (!name || !phone || !address || !provinceCode || !wardCode) {
              alert("Vui lòng nhập đủ Tên, SĐT, Địa chỉ, Tỉnh/Thành và Phường/Xã!");
              return;
            }

            // Ghép địa chỉ đầy đủ: "Số nhà, đường, Phường/Xã, Tỉnh/Thành"
            const fullAddress = [address, wardName, provinceName].filter(Boolean).join(", ");

            let paymentMethod = null;
            if (document.getElementById("cod").checked)   paymentMethod = 1; // COD
            if (document.getElementById("bank").checked)  paymentMethod = 2; // Bank
            if (document.getElementById("vnpay").checked) paymentMethod = 3; // VNPAY
            if (!paymentMethod) { alert("Vui lòng chọn phương thức thanh toán!"); return; }

            // TODO: thay bằng userId thật từ server nếu có
            const userId = "bcd4cce4-5ad1-467d-8999-18a267a1633c";

            const order = {
              userId,
              recipientName:  name,
              recipientPhone: phone,
              deliveryAddress: fullAddress,     // <--- lưu địa chỉ đầy đủ
              // gửi kèm meta nếu API có cột để lưu
              provinceCode, provinceName, wardCode, wardName,
              note: "",
              promoCode: null,
              shippingFee: 45000,
              items: items.map(i => ({
                productVariantId: parseInt(i.ProductVariantId),
                quantity: i.quantity,
                unitPrice: i.price
              }))
            };

            try {
              btnOrder.disabled = true;
              btnOrder.innerText = "Đang xử lý...";

              const response = await fetch("/api/order", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(order)
              });
              const result = await response.json();

              if (response.ok) {
                alert("Đặt hàng thành công! Mã đơn: " + (result.orderId || "Không rõ"));
                if (paymentMethod === 3) {
                  // VNPAY
                  vnpayForm.submit();
                } else {
                  localStorage.removeItem("selectedCartItems");
                  window.location.href = "/";
                }
              } else {
                alert("Đặt hàng thất bại: " + (result.message || "Lỗi không xác định"));
              }
            } catch (err) {
              console.error(err);
              alert("Đã có lỗi khi gửi đơn hàng.");
            } finally {
              btnOrder.disabled = false;
              btnOrder.innerText = "Đặt hàng";
            }
          });
        });
    </script>

}
