@model VNPayRequestModel
@{
    ViewBag.Title = "Thanh toán VNPay";
}

<h2>Thanh toán bằng VNPay</h2>

<form asp-action="CreatePayment" method="post">
    <div class="form-group">
        <label>Mã đơn hàng</label>
        <input name="OrderId" class="form-control" />
    </div>
    <div class="form-group">
        <label>Số tiền</label>
        <input name="Amount" type="number" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Thông tin đơn hàng</label>
        <input name="OrderInfo" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Thanh toán</button>
</form>
